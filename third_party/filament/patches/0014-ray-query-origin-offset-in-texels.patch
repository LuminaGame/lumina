From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Can Us <me@canus.dev>
Date: Sat, 10 Oct 2026 12:00:00 +0300
Subject: [PATCH] Offset ray query origins by a few texels, not by the near plane

The ray-traced sun shadow (0007), the ReSTIR visibility ray (0008) and the
specular hit distance ray (0012) moved their origin off the surface by
max(0.002, near * 0.5), and the sun shadow and hit distance rays grew it by
2 % per world unit of camera distance. Both terms assume a scene in metres.
In a centimetre level (near plane 10, camera 13 m = 1300 units away) the
shadow ray started 135 units toward the sun, past a 115 unit barrel: only
the far rim of its shadow survived, or nothing.

The offset is now a number of texels' world size at the pixel's distance
(perspective) or a constant texel size (orthographic), from the projection
and the target height: the same on screen whatever the scene's unit.
---
diff --git a/filament/src/PostProcessManager.cpp b/filament/src/PostProcessManager.cpp
index c3d3c4d2..9fffe5b4 100644
--- a/filament/src/PostProcessManager.cpp
+++ b/filament/src/PostProcessManager.cpp
@@ -232,6 +232,19 @@ static constexpr auto halton() {
 const PostProcessManager::JitterSequence<32>
         PostProcessManager::sHaltonSamples = { halton<32>() };
 
+// The offset that keeps a ray query's origin off the surface it starts on, in world units, as
+// (a, b) for an offset of a + b * distanceToCamera: `pixels` texels of a target `height` texels
+// tall. A perspective projection's texel grows with the distance (b), an orthographic one's is
+// constant (a). Measuring the offset in texels keeps it independent of the scene's unit: a
+// centimetre level and a metre level get the same offset on screen.
+static math::float2 rayOriginOffset(math::mat4f const& projection, float const height,
+        float const pixels) noexcept {
+    // projection[1][1] is 2n / (top - bottom) (perspective) or 2 / (top - bottom) (ortho)
+    float const texel = 2.0f / (std::abs(projection[1][1]) * std::max(1.0f, height));
+    bool const perspective = projection[2][3] != 0.0f;
+    return perspective ? math::float2{ 0.0f, texel * pixels } : math::float2{ texel * pixels, 0.0f };
+}
+
 PostProcessManager::PostProcessManager(FEngine& engine) noexcept
         : mEngine(engine),
           mWorkaroundSplitEasu(false),
@@ -298,8 +311,8 @@ FrameGraphId<FrameGraphTexture> PostProcessManager::rayTracedShadows(FrameGraph&
                 mi->setParameter("toLight", toLight);
                 mi->setParameter("cameraPosition", math::float3(
                         (trueWorldFromShaderWorld * math::double4(cameraInfo.getPosition(), 1.0)).xyz));
-                // a fraction of the depth range that keeps surfaces from shadowing themselves
-                mi->setParameter("bias", std::max(0.002f, cameraInfo.zn * 0.5f));
+                // a few texels toward the light keep surfaces from shadowing themselves
+                mi->setParameter("bias", rayOriginOffset(cameraInfo.projection, float(desc.height), 3.0f));
 
                 commitAndRenderFullScreenQuad(driver, out, mi);
                 unbindAllDescriptorSets(driver);
@@ -468,7 +481,7 @@ FrameGraphId<FrameGraphTexture> PostProcessManager::restir(FrameGraph& fg,
                 mi->setParameter("cameraPosition", cameraInfo.getPosition());
                 mi->setParameter("trueWorldOffset", trueWorldOffset);
                 mi->setParameter("visibilityRays", int32_t(options.visibilityRays ? 1 : 0));
-                mi->setParameter("bias", std::max(0.002f, cameraInfo.zn * 0.5f));
+                mi->setParameter("bias", rayOriginOffset(cameraInfo.projection, float(desc.height), 2.0f));
                 commitAndRenderFullScreenQuad(driver, out, mi);
                 unbindAllDescriptorSets(driver);
                 if (timeThisFrame) {
@@ -4508,7 +4521,7 @@ FrameGraphId<FrameGraphTexture> PostProcessManager::specularHitDistance(FrameGra
                         1.0f / float(desc.width), 1.0f / float(desc.height) });
                 mi->setParameter("cameraPosition", math::float3(
                         (trueWorldFromShaderWorld * math::double4(cameraInfo.getPosition(), 1.0)).xyz));
-                mi->setParameter("bias", std::max(0.002f, cameraInfo.zn * 0.5f));
+                mi->setParameter("bias", rayOriginOffset(cameraInfo.projection, float(desc.height), 2.0f));
                 commitAndRenderFullScreenQuad(driver, out, mi);
                 unbindAllDescriptorSets(driver);
             });
