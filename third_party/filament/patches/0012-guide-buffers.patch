+std::array<FrameGraphId<FrameGraphTexture>, 3> PostProcessManager::clearGuideBuffers(
+        FrameGraph& fg, uint32_t const width, uint32_t const height) noexcept {
+    struct GuideClearData {
+        FrameGraphId<FrameGraphTexture> guides[3];
+    };
+    auto const& pass = fg.addPass<GuideClearData>("Guide Buffers Clear",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.guides[0] = builder.createTexture("Guide Normal Roughness", {
+                        .width = width, .height = height, .format = TextureFormat::RGBA16F });
+                data.guides[1] = builder.createTexture("Guide Diffuse Albedo", {
+                        .width = width, .height = height, .format = TextureFormat::RGBA8 });
+                data.guides[2] = builder.createTexture("Guide Specular Albedo", {
+                        .width = width, .height = height, .format = TextureFormat::RGBA8 });
+                for (auto& guide: data.guides) {
+                    guide = builder.write(guide, FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                }
+                builder.declareRenderPass("Guide Buffers Clear Target", {
+                        .attachments = { .color = { data.guides[0], data.guides[1], data.guides[2] } },
+                        .clearColor = {},
+                        .clearFlags = TargetBufferFlags::COLOR0 | TargetBufferFlags::COLOR1 |
+                                TargetBufferFlags::COLOR2 });
+            },
+            [](FrameGraphResources const& resources, auto const&, DriverApi& driver) {
+                auto out = resources.getRenderPassInfo();
+                driver.beginRenderPass(out.target, out.params);
+                driver.endRenderPass();
+            });
+    return { pass->guides[0], pass->guides[1], pass->guides[2] };
+}
+
+FrameGraphId<FrameGraphTexture> PostProcessManager::specularHitDistance(FrameGraph& fg,
+        FrameGraphId<FrameGraphTexture> const depth, FrameGraphId<FrameGraphTexture> const normals,
+        CameraInfo const& cameraInfo) noexcept {
+    struct HitDistanceData {
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> normals;
+        FrameGraphId<FrameGraphTexture> distance;
+    };
+    auto const& pass = fg.addPass<HitDistanceData>("Specular Hit Distance",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                auto const& desc = fg.getDescriptor(normals);
+                data.depth = builder.sample(depth);
+                data.normals = builder.sample(normals);
+                data.distance = builder.createTexture("Guide Specular Hit Distance", {
+                        .width = desc.width, .height = desc.height,
+                        .format = TextureFormat::R16F });
+                data.distance = builder.declareRenderPass(data.distance);
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                mRayQueryDescriptorSet.bind(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& desc = resources.getDescriptor(data.distance);
+                auto const& out = resources.getRenderPassInfo();
+                auto const& material = getPostProcessMaterial("rtSpecularHitDistance");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("depth", resources.getTexture(data.depth), SamplerParams{});
+                mi->setParameter("normals", resources.getTexture(data.normals), SamplerParams{});
+                // the acceleration structures hold true world positions; the camera lives in
+                // the world shifted by cameraInfo.worldTransform (see rayTracedShadows)
+                math::mat4 const trueWorldFromShaderWorld = inverse(cameraInfo.worldTransform);
+                math::mat4 const worldFromClip = trueWorldFromShaderWorld *
+                        math::mat4(cameraInfo.model) * inverse(math::mat4(cameraInfo.projection));
+                mi->setParameter("worldFromClip", math::mat4f(worldFromClip));
+                mi->setParameter("resolution", math::float4{
+                        float(desc.width), float(desc.height),
+                        1.0f / float(desc.width), 1.0f / float(desc.height) });
+                mi->setParameter("cameraPosition", math::float3(
+                        (trueWorldFromShaderWorld * math::double4(cameraInfo.getPosition(), 1.0)).xyz));
+                mi->setParameter("bias", std::max(0.002f, cameraInfo.zn * 0.5f));
+                commitAndRenderFullScreenQuad(driver, out, mi);
+                unbindAllDescriptorSets(driver);
+            });
+    return pass->distance;
+}
+
+void PostProcessManager::exportGuideBuffer(FrameGraph& fg,
+        FrameGraphId<FrameGraphTexture> const guide, FTexture const* const texture) noexcept {
+    auto const& desc = fg.getDescriptor(guide);
+    if (texture->getWidth() != desc.width || texture->getHeight() != desc.height ||
+            texture->getFormat() != desc.format) {
+        return;
+    }
+    auto const exported = fg.import("Guide Buffer (export)", {
+            .width = desc.width, .height = desc.height, .format = desc.format },
+            FrameGraphTexture::Usage::BLIT_DST,
+            FrameGraphTexture{ .handle = texture->getHwHandle() });
+    struct ExportData {
+        FrameGraphId<FrameGraphTexture> source;
+        FrameGraphId<FrameGraphTexture> target;
+    };
+    fg.addPass<ExportData>("Guide Buffer Export",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.source = builder.read(guide, FrameGraphTexture::Usage::BLIT_SRC);
+                data.target = builder.write(exported, FrameGraphTexture::Usage::BLIT_DST);
+                builder.sideEffect();
+            },
+            [width = desc.width, height = desc.height](FrameGraphResources const& resources,
+                    auto const& data, DriverApi& driver) {
+                driver.blit(resources.getTexture(data.target), 0, 0, { 0, 0 },
+                        resources.getTexture(data.source), 0, 0, { 0, 0 }, { width, height });
+            });
+}
