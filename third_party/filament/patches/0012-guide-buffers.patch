+material {
+    name : rtSpecularHitDistance,
+    parameters : [
+        {
+            type : sampler2d,
+            name : depth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : normals,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : mat4,
+            name : worldFromClip,
+            precision: high
+        },
+        {
+            type : float4,
+            name : resolution,
+            precision: high
+        },
+        {
+            type : float3,
+            name : cameraPosition,
+            precision: high
+        },
+        {
+            type : float,
+            name : bias,
+            precision: high
+        }
+    ],
+    outputs : [
+        {
+            name : distance,
+            target : color,
+            type : float
+        }
+    ],
+    domain : postprocess,
+    rayQuery : true,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+    // The specular hit distance guide: one mirror-reflection ray per pixel from the surface
+    // the depth describes, around the normal the colour pass wrote, against the scene's
+    // acceleration structure. 0 where there is no surface (sky) or no normal, 65504 (the
+    // largest half float) when the ray leaves the scene.
+    void postProcess(inout PostProcessInputs postProcess) {
+        ivec2 icoord = ivec2(gl_FragCoord.xy);
+        highp float depth = texelFetch(materialParams_depth, icoord, 0).r;
+        highp vec3 normal = texelFetch(materialParams_normals, icoord, 0).xyz;
+        float distance = 0.0;
+        if (depth > 0.0 && dot(normal, normal) > 0.25) {
+            highp vec2 uv = (vec2(icoord) + 0.5) * materialParams.resolution.zw;
+            // window y grows downwards, NDC y upwards
+            highp vec4 clip = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
+            highp vec4 world = materialParams.worldFromClip * clip;
+            world.xyz /= world.w;
+            highp vec3 n = normalize(normal);
+            highp vec3 view = normalize(world.xyz - materialParams.cameraPosition);
+            highp vec3 direction = reflect(view, n);
+            highp float distanceToCamera = length(world.xyz - materialParams.cameraPosition);
+            highp float bias = materialParams.bias * (1.0 + distanceToCamera * 0.02);
+            highp vec3 origin = world.xyz + n * bias;
+            rayQueryEXT rq;
+            rayQueryInitializeEXT(rq, sceneTlas, gl_RayFlagsOpaqueEXT, 0xFFu,
+                    origin, 0.0, direction, 1.0e5);
+            while (rayQueryProceedEXT(rq)) {
+            }
+            if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
+                distance = min(rayQueryGetIntersectionTEXT(rq, true), 65504.0);
+            } else {
+                distance = 65504.0;
+            }
+        }
+        postProcess.distance = distance;
+    }
+}
