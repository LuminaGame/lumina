+// Guide buffers (GuideBufferOptions): when the view asks for them, the colour pass binds three
+// more colour attachments, written here from the evaluated material. Vulkan only, so the other
+// APIs keep their output count; a colour pass without the attachments discards the writes.
+#if defined(TARGET_VULKAN_ENVIRONMENT) && MATERIAL_FEATURE_LEVEL > 0 && !defined(HAS_CUSTOM_OUTPUT)
+#define FILAMENT_GUIDE_OUTPUTS
+layout(location = 1) out vec4 guideNormalRoughness;
+layout(location = 2) out vec4 guideDiffuseAlbedo;
+layout(location = 3) out vec4 guideSpecularAlbedo;
+
+void writeGuideBuffers(const MaterialInputs inputs) {
+#if defined(BLEND_MODE_OPAQUE) || defined(BLEND_MODE_MASKED)
+#if defined(SHADING_MODEL_UNLIT) || defined(VARIANT_HAS_SSR)
+    // unlit surfaces (the skybox) have no BRDF; the screen-space reflection pass has no guides
+    guideNormalRoughness = vec4(0.0);
+    guideDiffuseAlbedo = vec4(0.0);
+    guideSpecularAlbedo = vec4(0.0);
+#else
+    float perceptualRoughness;
+    vec3 diffuse;
+    vec3 f0;
+#if defined(SHADING_MODEL_SPECULAR_GLOSSINESS)
+    f0 = inputs.specularColor;
+    perceptualRoughness = computeRoughnessFromGlossiness(inputs.glossiness);
+    diffuse = inputs.baseColor.rgb * (1.0 - max3(f0));
+#elif defined(SHADING_MODEL_CLOTH)
+    perceptualRoughness = inputs.roughness;
+    diffuse = inputs.baseColor.rgb;
+    f0 = inputs.sheenColor;
+#else
+    perceptualRoughness = inputs.roughness;
+    diffuse = computeDiffuseColor(inputs.baseColor, inputs.metallic);
+    f0 = computeF0(inputs.baseColor, inputs.metallic, computeDielectricF0(inputs.reflectance));
+#endif
+    perceptualRoughness = saturate(perceptualRoughness);
+    vec3 dfg = prefilteredDFG(perceptualRoughness, shading_NoV);
+#if defined(SHADING_MODEL_CLOTH)
+    vec3 specular = f0 * dfg.z;
+#else
+    vec3 specular = mix(dfg.xxx, dfg.yyy, f0);
+#endif
+    guideNormalRoughness = vec4(shading_normal, perceptualRoughness);
+    guideDiffuseAlbedo = vec4(saturate(diffuse), 1.0);
+    guideSpecularAlbedo = vec4(saturate(specular), 1.0);
+#endif
+#elif defined(BLEND_MODE_MULTIPLY)
+    // multiplied into the attachment: one keeps the opaque surface's guides
+    guideNormalRoughness = vec4(1.0);
+    guideDiffuseAlbedo = vec4(1.0);
+    guideSpecularAlbedo = vec4(1.0);
+#else
+    // blended (premultiplied, additive, screen, fade): zero keeps the opaque surface's guides
+    guideNormalRoughness = vec4(0.0);
+    guideDiffuseAlbedo = vec4(0.0);
+    guideSpecularAlbedo = vec4(0.0);
+#endif
+}
