+/**
+ * The per-pixel guides a neural denoiser or upscaler needs on top of colour, depth and motion.
+ * @see GuideBufferOptions, View::setGuideBufferTexture, ExternalUpscaler::guideBuffers
+ */
+enum class GuideBuffer : uint8_t {
+    NORMAL_ROUGHNESS = 0,       //!< RGBA16F: world-space normal (xyz) + perceptual roughness (w)
+    DIFFUSE_ALBEDO = 1,         //!< RGBA8: baseColor * (1 - metallic), linear
+    SPECULAR_ALBEDO = 2,        //!< RGBA8: the split-sum specular albedo mix(dfg.x, dfg.y, F0), linear
+    SPECULAR_HIT_DISTANCE = 3,  //!< R16F: distance a mirror ray travels to its hit (world units)
+};
+
+/**
+ * Options for the guide buffers: extra colour-pass outputs written by the lit shaders from the
+ * evaluated material (normal + roughness, diffuse albedo, specular albedo), and the specular hit
+ * distance traced with ray queries. Vulkan only, single-sampled views only; materials compiled
+ * before the guides existed write none (the buffers stay cleared). Blended and unlit surfaces
+ * leave the opaque surface's guides in place (unlit ones write zero).
+ *
+ * @see View::setGuideBufferOptions
+ */
+struct GuideBufferOptions {
+    bool enabled = false;               //!< write the guide buffers in the colour pass
+    bool specularHitDistance = true;    //!< trace the specular hit distance (needs ray tracing)
+};
+
 } // namespace filament
 
