diff --git a/filament/src/materials/motionVectors/velocity.mat b/filament/src/materials/motionVectors/velocity.mat
new file mode 100644
index 00000000..073a3671
--- /dev/null
+++ b/filament/src/materials/motionVectors/velocity.mat
@@ -0,0 +1,82 @@
+material {
+    name : velocity,
+    parameters : [
+        {
+            type : sampler2d,
+            name : depth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : objectMotionVectors,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : mat4,
+            name : reprojection,
+            precision: high
+        },
+        {
+            type : float2,
+            name : objectMotionScale,
+            precision: high
+        },
+        {
+            type : bool,
+            name : cameraMotion
+        }
+    ],
+    variables : [
+        vertex
+    ],
+    depthWrite : false,
+    depthCulling : false,
+    domain: postprocess
+}
+
+vertex {
+    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
+        // the output covers the depth and object motion vectors buffers
+        postProcess.vertex.xy = uvToRenderTargetUV(postProcess.normalizedUV);
+    }
+}
+
+fragment {
+    void dummy(){}
+
+    // The full screen motion of every pixel since the previous render (camera and object), in
+    // texels of the depth buffer, x right and y up on all backends: the velocity buffer that
+    // upscalers and frame generators read. It's the motion of debugMotionVectors.mat, which
+    // reconstructs it from the depth buffer and the object motion vectors in the same way.
+    // A pixel without a valid previous position reports no motion.
+    void postProcess(inout PostProcessInputs postProcess) {
+        highp vec2 uv = variable_vertex.xy;
+        highp vec2 size = vec2(textureSize(materialParams_depth, 0));
+
+        // the object motion vectors can be a 1x1 zero texture: sample in normalized coordinates
+        highp vec2 v = textureLod(materialParams_objectMotionVectors, uv, 0.0).rg;
+        if (any(greaterThanEqual(abs(v), vec2(1.0)))) {
+            postProcess.color = vec4(0.0);
+            return;
+        }
+        v *= materialParams.objectMotionScale;
+
+        if (materialParams.cameraMotion) {
+            highp float depth = textureLod(materialParams_depth, uv, 0.0).r;
+            highp vec4 q = materialParams.reprojection * vec4(uvToRenderTargetUV(uv), depth, 1.0);
+            const highp float kMinW = 1.0e-6;
+            if (q.w <= kMinW) {
+                postProcess.color = vec4(0.0);
+                return;
+            }
+            highp vec2 uvPrev = uvToRenderTargetUV(q.xy * (0.5 / q.w) + 0.5) - v;
+            v = uv - uvPrev;
+        }
+
+        // render-target UV to y-up, in texels
+        highp vec2 m = (uvToRenderTargetUV(v) - uvToRenderTargetUV(vec2(0.0))) * size;
+        postProcess.color = vec4(m, 0.0, 0.0);
+    }
+}
