+FrameGraphId<FrameGraphTexture> PostProcessManager::velocity(FrameGraph& fg,
+        FrameGraphId<FrameGraphTexture> const depth,
+        FrameGraphId<FrameGraphTexture> const objectMotionVectors,
+        FrameHistory const& frameHistory, FTexture const* const exported) noexcept {
+    assert_invariant(depth && objectMotionVectors);
+
+    // Without a previous render there is no motion (objectMotionVectors is the zero texture).
+    bool const cameraMotion = frameHistory.getPrevious().motionVectors.valid;
+    mat4f reprojection;
+    float2 k;
+    motionVectorsReprojection(frameHistory, cameraMotion, reprojection, k);
+
+    FrameGraphTexture::Descriptor const depthDesc = fg.getDescriptor(depth);
+    FrameGraphId<FrameGraphTexture> output;
+    if (exported && exported->getWidth() == depthDesc.width &&
+            exported->getHeight() == depthDesc.height) {
+        output = fg.import("Velocity Buffer (export)", {
+                .width = depthDesc.width, .height = depthDesc.height,
+                .format = exported->getFormat() },
+                FrameGraphTexture::Usage::COLOR_ATTACHMENT | FrameGraphTexture::Usage::SAMPLEABLE,
+                FrameGraphTexture{ .handle = exported->getHwHandle() });
+    }
+
+    struct VelocityData {
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> objectMotionVectors;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+
+    auto const& velocityPass = fg.addPass<VelocityData>("Velocity",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.depth = builder.sample(depth);
+                data.objectMotionVectors = builder.sample(objectMotionVectors);
+                data.output = output ? output : builder.createTexture("Velocity Buffer", {
+                        .width = depthDesc.width, .height = depthDesc.height,
+                        .format = TextureFormat::RG16F });
+                data.output = builder.declareRenderPass(data.output);
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& material = getPostProcessMaterial("velocity");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("depth", resources.getTexture(data.depth),
+                        SamplerParams{});   // nearest
+                mi->setParameter("objectMotionVectors",
+                        resources.getTexture(data.objectMotionVectors),
+                        SamplerParams{});   // nearest
+                mi->setParameter("reprojection", reprojection);
+                mi->setParameter("objectMotionScale", k);
+                mi->setParameter("cameraMotion", cameraMotion);
+                commitAndRenderFullScreenQuad(driver, resources.getRenderPassInfo(), mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    if (output) {
+        // The export is read outside the FrameGraph: this keeps the pass (and the motion vectors
+        // pass it reads) from being culled, and its output from being discarded.
+        fg.present(velocityPass->output);
+    }
+    return velocityPass->output;
+}
+
 } // namespace filament
