+// The first bone update of a frame turns the palette the previous frame rendered with (the
+// CPU shadow) into the previous palette the motion vectors read; later updates in the same
+// frame only move the current one.
+void FRenderableManager::keepPreviousBones(Bones& bones) noexcept {
+    if (!bones.prevHandle || !bones.shadow || bones.prevFrame == mMotionFrame) {
+        return;
+    }
+    auto& driver = mEngine.getDriverApi();
+    auto* prev = driver.allocatePod<PerRenderableBoneUib::BoneData>(bones.count);
+    std::copy_n(bones.shadow, bones.count, prev);
+    driver.updateBufferObject(bones.prevHandle, {
+            prev, bones.count * sizeof(PerRenderableBoneUib::BoneData) }, 0);
+    bones.prevFrame = mMotionFrame;
+    bones.prevStale = true;
+}
+
