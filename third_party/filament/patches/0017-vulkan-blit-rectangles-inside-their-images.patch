@@ -50,6 +50,7 @@
 
 #include <algorithm>
 #include <chrono>
+#include <cmath>
 #include <mutex>
 #ifndef NDEBUG
 #include <set>  // For VulkanDriver::debugCommandBegin
@@ -2973,6 +2974,37 @@ void VulkanDriver::blitDEPRECATED(TargetBufferFlags buffers,
     VkExtent2D const srcExtent = srcTarget->getExtent();
     VkExtent2D const dstExtent = dstTarget->getExtent();
 
+    // A rectangle reaching past its image (a view's viewport larger than a window whose swap
+    // chain was just recreated smaller, the presents of frame generation during a resize) is
+    // an invalid blit that loses the device: both rectangles keep the part that lies inside
+    // both images, in the same proportion.
+    if (dstRect.left + dstRect.width > dstExtent.width ||
+            dstRect.bottom + dstRect.height > dstExtent.height ||
+            srcRect.left + srcRect.width > srcExtent.width ||
+            srcRect.bottom + srcRect.height > srcExtent.height) {
+        if (dstRect.width == 0 || dstRect.height == 0 || srcRect.width == 0 ||
+                srcRect.height == 0 || dstRect.left >= int32_t(dstExtent.width) ||
+                dstRect.bottom >= int32_t(dstExtent.height) ||
+                srcRect.left >= int32_t(srcExtent.width) ||
+                srcRect.bottom >= int32_t(srcExtent.height)) {
+            return;
+        }
+        double const sx = double(srcRect.width) / double(dstRect.width);
+        double const sy = double(srcRect.height) / double(dstRect.height);
+        // the destination width / height that keeps both rectangles inside their images
+        double w = std::min(double(dstRect.width), double(dstExtent.width - dstRect.left));
+        double h = std::min(double(dstRect.height), double(dstExtent.height - dstRect.bottom));
+        w = std::min(w, double(srcExtent.width - srcRect.left) / sx);
+        h = std::min(h, double(srcExtent.height - srcRect.bottom) / sy);
+        if (w < 1.0 || h < 1.0) {
+            return;
+        }
+        dstRect.width = uint32_t(w);
+        dstRect.height = uint32_t(h);
+        srcRect.width = std::min(uint32_t(std::lround(w * sx)), srcExtent.width - srcRect.left);
+        srcRect.height = std::min(uint32_t(std::lround(h * sy)), srcExtent.height - srcRect.bottom);
+    }
+
     auto const dstLeft   = int32_t(dstRect.left);
     auto const srcLeft   = int32_t(srcRect.left);
     auto const dstTop    = int32_t(dstExtent.height - (dstRect.bottom + dstRect.height));
