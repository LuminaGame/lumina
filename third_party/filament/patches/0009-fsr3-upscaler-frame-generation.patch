+        // same rounding as taa()
+        upscaleWidth  = uint32_t(float(renderWidth)  * taaOptions.upscaling);
+        upscaleHeight = uint32_t(float(renderHeight) * taaOptions.upscaling);
+    }
+    // the shading change and the farthest depth are computed at half resolution
+    uint32_t const halfWidth = std::max(1u, renderWidth / 2u);
+    uint32_t const halfHeight = std::max(1u, renderHeight / 2u);
+
+    float2 const renderSize{ float(renderWidth), float(renderHeight) };
+    float2 const upscaleSize{ float(upscaleWidth), float(upscaleHeight) };
+    float2 const halfSize{ float(halfWidth), float(halfHeight) };
+
+    // The history is only usable if all of it was produced at the current resolutions
+    auto const isHistoryValid = [](Fsr3History::Texture const& t, uint32_t w, uint32_t h) {
+        return t.texture.handle && t.desc.width == w && t.desc.height == h;
+    };
+    bool const hasHistory =
+            isHistoryValid(previous.color, upscaleWidth, upscaleHeight) &&
+            isHistoryValid(previous.luma, renderWidth, renderHeight) &&
+            isHistoryValid(previous.depth, renderWidth, renderHeight) &&
+            isHistoryValid(previous.accumulation, renderWidth, renderHeight) &&
+            isHistoryValid(previous.lumaHistory, renderWidth, renderHeight);
+
+    // Without history, the shaders never read the history textures, but they must be bound.
+    FrameGraphId<FrameGraphTexture> dummy;
+    if (!hasHistory) {
+        dummy = fg.import("FSR3 dummy history", { .width = 1, .height = 1 },
+                FrameGraphTexture::Usage::SAMPLEABLE, FrameGraphTexture{ getZeroTexture() });
+    }
+    auto const importHistory = [&](utils::StaticString const name,
+            Fsr3History::Texture const& t) {
+        return hasHistory ?
+                fg.import(name, t.desc, FrameGraphTexture::Usage::SAMPLEABLE, t.texture) : dummy;
+    };
+    auto const colorHistory = importHistory("FSR3 color history", previous.color);
+    auto const lumaHistory = importHistory("FSR3 luma history", previous.luma);
+    auto const depthHistory = importHistory("FSR3 depth history", previous.depth);
+    auto const accumulationHistory =
+            importHistory("FSR3 accumulation history", previous.accumulation);
+    auto const lumaHistoryHistory =
+            importHistory("FSR3 luma instability history", previous.lumaHistory);
+
+    // jitter, in pixels: the texel at pixel center c holds the scene at c - jitter
