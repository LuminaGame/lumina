+
+    /** temporal anti-aliasing and upscaling algorithm */
+    Algorithm algorithm = Algorithm::FILAMENT;
+
+    /**
+     * Frame generation: an interpolated frame is presented before each rendered frame, which
+     * doubles the presented frame rate at the cost of half a frame of latency. With vsync, the
+     * SwapChain paces the frames; without (SwapChain::CONFIG_DISABLE_VSYNC), the rendered frame
+     * is presented half a frame interval after the interpolated one. The View must be rendered
+     * into the SwapChain without guard band, and Views rendered after it (e.g. UI) are rendered
+     * again on the rendered frame. Requires the FSR3 algorithm. [BETA]
+     */
+    bool frameGeneration = false;
 };
 
