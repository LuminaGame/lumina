+
+fragment {
+
+#include "fsr3_common.fs"
+
+struct RectificationBox {
+    highp vec3 boxCenter;
+    highp vec3 boxVec;
+    highp vec3 aabbMin;
+    highp vec3 aabbMax;
+    highp float boxCenterWeight;
+};
+
+struct AccumulationPassCommonParams {
+    ivec2 pxHrPos;
+    highp vec2 hrUv;
+    highp vec2 lrUvJittered;
+    highp vec2 lrUvHwSampler;
+    highp vec2 motionVector;
+    highp vec2 reprojectedHrUv;
+    highp float velocity4K;
+    highp float disocclusion;
+    highp float reactiveMask;
+    highp float shadingChange;
+    highp float accumulation;
+    highp float lumaInstabilityFactor;
+    highp float farthestDepthInMeters;
+    bool isExistingSample;
+    bool isNewSample;
+};
+
+struct AccumulationPassData {
+    RectificationBox clippingBox;
+    highp vec3 upsampledColor;
+    highp float upsampledWeight;
+    highp vec3 historyColor;
+    highp float historyWeight;
+    highp float lock;
+    highp float lockContributionThisFrame;
+};
+
+void rectificationBoxAddSample(bool initialSample, inout RectificationBox box,
+        highp vec3 colorSample, highp float sampleWeight) {
+    highp vec3 weightedSample = colorSample * sampleWeight;
+    if (initialSample) {
+        box.aabbMin = colorSample;
+        box.aabbMax = colorSample;
+        box.boxCenter = weightedSample;
+        box.boxVec = colorSample * weightedSample;
+        box.boxCenterWeight = sampleWeight;
+    } else {
+        box.aabbMin = min(box.aabbMin, colorSample);
+        box.aabbMax = max(box.aabbMax, colorSample);
+        box.boxCenter += weightedSample;
+        box.boxVec += colorSample * weightedSample;
+        box.boxCenterWeight += sampleWeight;
+    }
+}
+
+void rectificationBoxComputeVarianceBoxData(inout RectificationBox box) {
+    box.boxCenterWeight = abs(box.boxCenterWeight) > FSR3_FP32_MIN ? box.boxCenterWeight : 1.0;
+    box.boxCenter /= box.boxCenterWeight;
+    box.boxVec /= box.boxCenterWeight;
+    box.boxVec = sqrt(abs(box.boxVec - box.boxCenter * box.boxCenter));
+}
+
+// ------------------------------------------------------------------------------------------------
+// History reprojection, lanczos (reference) 4x4 with deringing
+// ------------------------------------------------------------------------------------------------
+
+highp vec4 loadHistory(ivec2 pos, ivec2 size, ivec2 offset) {
+    // ClampCoord() of ffx_fsr3upscaler_sample.h, which excludes the outer texels
+    ivec2 p = clamp(pos + offset, ivec2(1), size - 2);
+    return texelFetch(materialParams_history, p, 0);
+}
+
+highp vec4 lanczos2(highp vec4 c0, highp vec4 c1, highp vec4 c2, highp vec4 c3, highp float t) {
+    highp float w0 = fsr3Lanczos2(-1.0 - t);
+    highp float w1 = fsr3Lanczos2(-0.0 - t);
+    highp float w2 = fsr3Lanczos2(+1.0 - t);
+    highp float w3 = fsr3Lanczos2(+2.0 - t);
+    return (w0 * c0 + w1 * c1 + w2 * c2 + w3 * c3) / (w0 + w1 + w2 + w3);
+}
+
+highp vec4 historySample(highp vec2 uv, ivec2 size) {
+    highp vec2 pxSample = uv * vec2(size) - 0.5;
+    highp vec2 pxFrac = fract(pxSample);
+    pxSample = clamp(pxSample, vec2(0.0), vec2(size - 1));
+    ivec2 p = ivec2(floor(pxSample));
+
+    highp vec4 rows[4];
+    highp vec4 c11, c21, c12, c22;
+    for (int y = 0; y < 4; y++) {
+        highp vec4 c0 = loadHistory(p, size, ivec2(-1, y - 1));
+        highp vec4 c1 = loadHistory(p, size, ivec2( 0, y - 1));
+        highp vec4 c2 = loadHistory(p, size, ivec2( 1, y - 1));
+        highp vec4 c3 = loadHistory(p, size, ivec2( 2, y - 1));
+        rows[y] = lanczos2(c0, c1, c2, c3, pxFrac.x);
+        if (y == 1) { c11 = c1; c21 = c2; }
+        if (y == 2) { c12 = c1; c22 = c2; }
+    }
+    highp vec4 color = lanczos2(rows[0], rows[1], rows[2], rows[3], pxFrac.y);
+
+    // deringing
+    highp vec4 deringingMin = min(min(c11, c21), min(c12, c22));
+    highp vec4 deringingMax = max(max(c11, c21), max(c12, c22));
+    return clamp(color, deringingMin, deringingMax);
+}
+
+// ------------------------------------------------------------------------------------------------
+// New locks
+// ------------------------------------------------------------------------------------------------
+
+// Inverse of fsr3ComputeHrPosFromLrPos(): at most one render-resolution pixel maps to hrPos.
+highp float loadNewLocks(ivec2 hrPos) {
+    highp vec2 renderSize = materialParams.renderSize;
+    highp vec2 upscaleSize = materialParams.upscaleSize;
+    highp vec2 lo = vec2(hrPos) * renderSize / upscaleSize - 0.5 + materialParams.jitter;
+    ivec2 lrPos = ivec2(ceil(lo));
+    if (!fsr3IsOnScreen(lrPos, ivec2(renderSize))) {
+        return 0.0;
+    }
+    if (fsr3ComputeHrPosFromLrPos(lrPos, materialParams.jitter, renderSize, upscaleSize) != hrPos) {
+        return 0.0;
+    }
+    return texelFetch(materialParams_accumulationAndLocks, lrPos, 0).g;
+}
+
+// ------------------------------------------------------------------------------------------------
+// Accumulation
+// ------------------------------------------------------------------------------------------------
+
+void initPassData(ivec2 pxHrPos, out AccumulationPassCommonParams params,
+        out AccumulationPassData data) {
+    highp vec2 renderSize = materialParams.renderSize;
+
+    params.pxHrPos = pxHrPos;
+    params.hrUv = (vec2(pxHrPos) + 0.5) / materialParams.upscaleSize;
+    params.lrUvJittered = params.hrUv + materialParams.jitter / renderSize;
+    params.lrUvHwSampler = fsr3ClampUv(params.lrUvJittered, renderSize);
+
+    // low resolution motion vectors
+    params.motionVector = texelFetch(materialParams_dilatedMotionVectors,
+            ivec2(params.hrUv * renderSize), 0).rg;
+    params.velocity4K = fsr3Get4KVelocity(params.motionVector);
+
+    params.reprojectedHrUv = params.hrUv + params.motionVector;
+    params.isExistingSample = fsr3IsUvInside(params.reprojectedHrUv);
+
+    params.lumaInstabilityFactor = textureLod(materialParams_lumaInstability,
+            fsr3ClampUv(params.hrUv, renderSize), 0.0).r;
+
+    highp vec2 farthestDepthUv =
+            fsr3ClampUv(params.lrUvJittered, materialParams.farthestDepthMip1Size);
+    params.farthestDepthInMeters =
+            textureLod(materialParams_farthestDepthMip1, farthestDepthUv, 0.0).r;
+
+    params.isNewSample = !params.isExistingSample || !materialParams.hasHistory;
+
+    highp vec4 dilatedReactiveMasks =
+            textureLod(materialParams_reactiveMasks, params.lrUvHwSampler, 0.0);
+    params.reactiveMask = saturate(dilatedReactiveMasks[FSR3_REACTIVE]);
+    params.disocclusion = saturate(dilatedReactiveMasks[FSR3_DISOCCLUSION]);
+    params.shadingChange = saturate(dilatedReactiveMasks[FSR3_SHADING_CHANGE]);
+    params.accumulation = saturate(dilatedReactiveMasks[FSR3_ACCUMULATION]);
+    params.accumulation *= float(round(params.accumulation * 100.0) > 1.0);
+
+    data.clippingBox.boxCenter = vec3(0.0);
+    data.clippingBox.boxVec = vec3(0.0);
+    data.clippingBox.aabbMin = vec3(0.0);
+    data.clippingBox.aabbMax = vec3(0.0);
+    data.clippingBox.boxCenterWeight = 0.0;
+    data.upsampledColor = vec3(0.0);
+    data.historyColor = vec3(0.0);
+    data.historyWeight = 1.0;
+    data.upsampledWeight = 0.0;
+    data.lock = 0.0;
+    data.lockContributionThisFrame = 0.0;
+}
+
+void reprojectHistoryColor(AccumulationPassCommonParams params, inout AccumulationPassData data) {
+    highp vec4 reprojectedHistory =
+            historySample(params.reprojectedHrUv, ivec2(materialParams.upscaleSize));
+    data.historyColor = reprojectedHistory.rgb * materialParams.deltaPreExposure;
+    data.historyColor = fsr3RGBToYCoCg(data.historyColor);
+    data.lock = reprojectedHistory.w;
+}
+
+void updateLockStatus(AccumulationPassCommonParams params, inout AccumulationPassData data) {
+    data.lock *= float(!params.isNewSample);
+
+    highp float lifetimeDecreaseFactor = max(saturate(params.shadingChange),
+            max(params.reactiveMask, params.disocclusion));
+
+    data.lock = max(0.0, data.lock - lifetimeDecreaseFactor * FSR3_LOCK_MAX);
+
+    // compute this frame lock contribution
+    data.lockContributionThisFrame = saturate(
+            saturate(data.lock - FSR3_LOCK_THRESHOLD) * (FSR3_LOCK_MAX - FSR3_LOCK_THRESHOLD));
+
+    highp float newLockIntensity = loadNewLocks(params.pxHrPos) * (1.0 - params.reactiveMask);
+    data.lock = max(0.0, min(data.lock + newLockIntensity, FSR3_LOCK_MAX));
+
+    // preparing for next frame
+    highp float lifetimeDecrease =
+            (0.1 / materialParams.jitterSequenceLength) * (1.0 - lifetimeDecreaseFactor);
+    data.lock = max(0.0, data.lock - lifetimeDecrease);
+
+    // we expect similar motion for next frame, kill lock if that location is outside screen, avoid
+    // locks to be clamped to screen borders
+    highp vec2 estimatedUvNextFrame = params.hrUv - params.motionVector;
+    data.lock *= float(fsr3IsUvInside(estimatedUvNextFrame));
+}
+
+void computeBaseAccumulationWeight(AccumulationPassCommonParams params,
+        inout AccumulationPassData data) {
+    highp float baseAccumulation = params.accumulation;
+    baseAccumulation = min(baseAccumulation, mix(baseAccumulation, 0.15,
+            saturate(max(0.0, (params.velocity4K * materialParams.velocityFactor) / 0.5))));
+    data.historyWeight = baseAccumulation;
+}
+
+highp vec3 loadPreparedColor(ivec2 samplePos) {
+    highp vec3 rgb = max(vec3(0.0), texelFetch(materialParams_color, samplePos, 0).rgb);
+    return fsr3RGBToYCoCg(rgb);
+}
+
+void computeUpsampledColorAndWeight(AccumulationPassCommonParams params,
+        inout AccumulationPassData data) {
+    highp vec2 renderSize = materialParams.renderSize;
+    ivec2 iRenderSize = ivec2(renderSize);
+    highp vec2 downscaleFactor = renderSize / materialParams.upscaleSize;
+
+    // We compute a sliced lanczos filter with 2 lobes (other slices are accumulated temporally)
+    highp vec2 dstOutputPos = vec2(params.pxHrPos) + 0.5;
+    highp vec2 srcOutputPos = dstOutputPos * downscaleFactor;
+    ivec2 srcInputPos = ivec2(floor(srcOutputPos));
+    // this is the un-jittered position of the sample at offset 0,0
+    highp vec2 srcUnjitteredPos = (vec2(srcInputPos) + 0.5) - materialParams.jitter;
+    highp vec2 baseSampleOffset = srcUnjitteredPos - srcOutputPos;
+
+    ivec2 offsetTL;
+    offsetTL.x = (srcUnjitteredPos.x > srcOutputPos.x) ? -2 : -1;
+    offsetTL.y = (srcUnjitteredPos.y > srcOutputPos.y) ? -2 : -1;
+
+    // Flip row/column so that the first 3 rows/columns can always be used for the clip box
+    bool flipRow = srcUnjitteredPos.y > srcOutputPos.y;
+    bool flipCol = srcUnjitteredPos.x > srcOutputPos.x;
+    highp vec2 fOffsetTL = vec2(offsetTL);
+
+    bool isInitialSample = (params.accumulation == 0.0);
+
+    highp vec3 samples[9];
+    for (int row = 0; row < 3; row++) {
+        for (int col = 0; col < 3; col++) {
+            ivec2 sampleColRow = ivec2(flipCol ? (3 - col) : col, flipRow ? (3 - row) : row);
+            ivec2 srcSamplePos = srcInputPos + offsetTL + sampleColRow;
+            ivec2 sampleCoord = fsr3ClampLoad(srcSamplePos, ivec2(0), iRenderSize);
+            highp vec3 s = loadPreparedColor(sampleCoord);
+            if (isInitialSample) {
+                // YCoCg -> RGB -> Tonemap -> YCoCg (use RGB tonemapper to avoid color desaturation)
+                s = fsr3RGBToYCoCg(fsr3Tonemap(fsr3YCoCgToRGB(s)));
+            }
+            samples[row * 3 + col] = s;
+        }
+    }
+
+    // identify how much of each upsampled color to be used for this frame
+    highp float kernelBiasMax = min(1.99, 1.0 + (1.0 / downscaleFactor.x - 1.0));
+    highp float kernelBiasMin = max(1.0, (1.0 + kernelBiasMax) * 0.3);
+    highp float kernelBiasWeight = min(1.0 - params.disocclusion * 0.5,
+            min(1.0 - params.shadingChange, saturate(data.historyWeight * 5.0)));
+    highp float kernelBias = mix(kernelBiasMin, kernelBiasMax, kernelBiasWeight);
+
+    for (int row = 0; row < 3; row++) {
+        for (int col = 0; col < 3; col++) {
+            ivec2 sampleColRow = ivec2(flipCol ? (3 - col) : col, flipRow ? (3 - row) : row);
+            highp vec2 offset = fOffsetTL + vec2(sampleColRow);
+            highp vec2 srcSampleOffset = baseSampleOffset + offset;
+            ivec2 srcSamplePos = srcInputPos + offsetTL + sampleColRow;
+            highp float onScreenFactor = float(fsr3IsOnScreen(srcSamplePos, iRenderSize));
+            highp vec3 s = samples[row * 3 + col];
+
+            if (!isInitialSample) {
+                highp vec2 biased = srcSampleOffset * kernelBias;
+                highp float sampleWeight =
+                        onScreenFactor * fsr3Lanczos2ApproxSq(dot(biased, biased));
+                data.upsampledColor += s * sampleWeight;
+                data.upsampledWeight += sampleWeight;
+            }
+
+            // update rectification box
+            const highp float rectificationCurveBias = -2.3;
+            highp float srcSampleOffsetSq = dot(srcSampleOffset, srcSampleOffset);
+            highp float boxSampleWeight =
+                    exp(rectificationCurveBias * srcSampleOffsetSq) * onScreenFactor;
+            rectificationBoxAddSample(row == 0 && col == 0, data.clippingBox, s, boxSampleWeight);
+        }
+    }
+
+    rectificationBoxComputeVarianceBoxData(data.clippingBox);
+
+    data.upsampledWeight *= float(data.upsampledWeight > FSR3_EPSILON);
+
+    if (data.upsampledWeight > FSR3_EPSILON) {
+        // normalize for deringing (we need to compare colors)
+        data.upsampledColor = data.upsampledColor / data.upsampledWeight;
+        data.upsampledWeight *= FSR3_AVERAGE_LANCZOS_WEIGHT_PER_FRAME;
+        data.upsampledColor = clamp(data.upsampledColor,
+                data.clippingBox.aabbMin, data.clippingBox.aabbMax);
+    }
+
+    // initial samples using tonemapped upsampling
+    if (isInitialSample) {
+        data.upsampledColor = fsr3RGBToYCoCg(
+                fsr3InverseTonemap(fsr3YCoCgToRGB(data.clippingBox.boxCenter)));
+        data.upsampledWeight = 1.0;
+        data.historyWeight = 0.0;
+    }
+}
+
+void rectifyHistory(AccumulationPassCommonParams params, inout AccumulationPassData data) {
+    highp float velocity4kFactor = saturate(params.velocity4K / 20.0);
+    highp float distanceFactor = saturate(0.75 - params.farthestDepthInMeters / 20.0);
+    highp float accumulationFactor = 1.0 - params.accumulation;
+    highp float reactiveFactor = pow(params.reactiveMask, 1.0 / 2.0);
+    highp float shadingChangeFactor = params.shadingChange;
+    highp float boxScaleT = max(velocity4kFactor, max(distanceFactor,
+            max(accumulationFactor, max(reactiveFactor, shadingChangeFactor))));
+
+    highp float boxScale = mix(3.0, 1.0, boxScaleT);
+
+    highp vec3 scaledBoxVec = data.clippingBox.boxVec * vec3(1.7, 1.0, 1.0) * boxScale;
+    highp vec3 clampedScaledBoxVec = max(scaledBoxVec, vec3(1.193e-7));
+    highp vec3 transformedHistoryColor =
+            (data.historyColor - data.clippingBox.boxCenter) / clampedScaledBoxVec;
+
+    if (length(transformedHistoryColor) > 1.0) {
+        highp vec3 clampedHistoryColor = normalize(transformedHistoryColor);
+        highp vec3 finalClampedHistoryColor =
+                (clampedHistoryColor * scaledBoxVec) + data.clippingBox.boxCenter;
+
+        // scale history color using rectification info, also using accumulation mask to avoid
+        // potential invalid color protection
+        highp float historyContribution =
+                max(params.lumaInstabilityFactor, data.lockContributionThisFrame) *
+                params.accumulation * (1.0 - params.disocclusion);
+        data.historyColor = mix(finalClampedHistoryColor, data.historyColor,
+                saturate(historyContribution));
+    }
+}
+
+void accumulate(AccumulationPassCommonParams params, inout AccumulationPassData data) {
+    // avoid invalid values when accumulation and upsampled weight is 0
+    data.historyWeight *= float(data.historyWeight > FSR3_FP16_MIN);
+    data.historyWeight = max(FSR3_EPSILON, data.historyWeight + data.upsampledWeight);
+
+    // YCoCg -> RGB -> Tonemap -> YCoCg (use RGB tonemapper to avoid color desaturation)
+    data.upsampledColor = fsr3RGBToYCoCg(fsr3Tonemap(fsr3YCoCgToRGB(data.upsampledColor)));
+    data.historyColor = fsr3RGBToYCoCg(fsr3Tonemap(fsr3YCoCgToRGB(data.historyColor)));
+
+    highp float alpha = saturate(data.upsampledWeight / data.historyWeight);
+    data.historyColor = mix(data.historyColor, data.upsampledColor, alpha);
+    data.historyColor = fsr3YCoCgToRGB(data.historyColor);
+
+    data.historyColor = fsr3InverseTonemap(data.historyColor);
+}
+
+void postProcess(inout PostProcessInputs postProcess) {
+    ivec2 pxHrPos = ivec2(gl_FragCoord.xy);
+
+    AccumulationPassCommonParams params;
+    AccumulationPassData data;
+    initPassData(pxHrPos, params, data);
+
+    if (params.isExistingSample && !params.isNewSample) {
+        reprojectHistoryColor(params, data);
+    }
+
+    updateLockStatus(params, data);
+    computeBaseAccumulationWeight(params, data);
+    computeUpsampledColorAndWeight(params, data);
+    rectifyHistory(params, data);
+    accumulate(params, data);
+
+    highp vec3 historyColor = max(data.historyColor, vec3(0.0));
+
+    // alpha isn't upscaled, use the closest input sample
+    ivec2 lrPos = clamp(ivec2(floor(params.lrUvJittered * materialParams.renderSize)),
+            ivec2(0), ivec2(materialParams.renderSize) - 1);
+    highp float alpha = texelFetch(materialParams_color, lrPos, 0).a;
+
+    postProcess.history = vec4(historyColor, data.lock);
+    postProcess.color = vec4(historyColor, alpha);
+}
+
+}
