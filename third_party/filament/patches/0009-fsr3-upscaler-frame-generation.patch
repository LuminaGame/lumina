+
+    enum class Algorithm : uint8_t {
+        /** Filament's temporal anti-aliasing */
+        FILAMENT,
+        /**
+         * FidelityFX Super Resolution 3 temporal upscaler, as fragment passes. Uses the
+         * per-pixel motion vectors of the structure pass (motionVectors is implied). Only
+         * `upscaling`, `sharpness`, `lodBias` and `jitterPattern` apply. Requires feature
