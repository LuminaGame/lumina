+void FRenderer::paceRenderedFrame() noexcept {
+    auto const now = std::chrono::steady_clock::now();
+    if (mLastInterpolatedFramePresent.time_since_epoch().count()) {
+        double const interval =
+                std::chrono::duration<double>(now - mLastInterpolatedFramePresent).count();
+        // ignore long pauses (e.g. the first frame after frame generation is turned on)
+        if (interval < 0.25) {
+            mFrameGenerationInterval = mFrameGenerationInterval > 0.0 ?
+                    mFrameGenerationInterval * 0.9 + interval * 0.1 : interval;
+        }
+    }
+    mLastInterpolatedFramePresent = now;
+
+    if (mFrameGenerationInterval <= 0.0) {
+        return;
+    }
+
+    // Because the wait is part of the interval, the interval converges to twice the frame's
+    // work when the frame rate isn't limited otherwise.
+    auto const deadline = now + std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+            std::chrono::duration<double>(mFrameGenerationInterval * 0.5));
+    // sleep() is coarse on some platforms, so we sleep most of the wait and yield the rest
+    constexpr auto sleepMargin = std::chrono::milliseconds(2);
+    if (deadline - std::chrono::steady_clock::now() > sleepMargin) {
+        std::this_thread::sleep_until(deadline - sleepMargin);
+    }
+    while (std::chrono::steady_clock::now() < deadline) {
+        std::this_thread::yield();
     }
 }
 
