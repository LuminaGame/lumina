+            case JitterPattern::UNIFORM_HELIX_X4:   return 4.0f;
+            case JitterPattern::HALTON_23_X8:       return 8.0f;
+            case JitterPattern::HALTON_23_X16:      return 16.0f;
+            case JitterPattern::HALTON_23_X32:      return 32.0f;
