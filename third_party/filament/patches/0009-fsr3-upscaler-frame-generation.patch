+//------------------------------------------------------------------------------
+// FSR3 upscaler, common code
+//
+// Conventions (these differ from the FidelityFX SDK where noted):
+// - All passes are fragment shaders; a pass' pixel position is ivec2(gl_FragCoord.xy), which is
+//   also the texel coordinate in the render target on all backends.
+// - uvs are render-target uvs (i.e. y-down on Vulkan/Metal, see uvToRenderTargetUV()).
+// - Motion vectors are in uv units and point to last frame's position: uvPrev = uv + mv.
+// - The jitter is in pixels: the texel at pixel center c holds the scene at c - jitter.
+// - Depth is Filament's reversed-Z, i.e. FFX_FSR3UPSCALER_OPTION_INVERTED_DEPTH.
+// - Color is HDR and already pre-exposed, i.e. FFX_FSR3UPSCALER_OPTION_HDR_COLOR_INPUT with an
+//   exposure of 1.
+// - The render size never differs from the resource size and doesn't change while the history
+//   is valid, so PreviousFrameRenderSize() == MaxRenderSize() == RenderSize().
+//------------------------------------------------------------------------------
+
+#define FSR3_FP16_MIN           6.10e-05
+#define FSR3_FP16_MAX           65504.0
+#define FSR3_EPSILON            FSR3_FP16_MIN
+#define FSR3_TONEMAP_EPSILON    FSR3_FP16_MIN
+#define FSR3_FP32_MAX           3.402823466e+38
+#define FSR3_FP32_MIN           1.175494351e-38
+
+// Must match surface_depth_main.fs
+#define FSR3_VELOCITY_INVALID   32768.0
+
+#define FSR3_RECONSTRUCTED_DEPTH_BILINEAR_WEIGHT_THRESHOLD (FSR3_EPSILON * 10.0)
+
+#define FSR3_UPSAMPLE_LANCZOS_WEIGHT_SCALE      (1.0 / 16.0)
+#define FSR3_AVERAGE_LANCZOS_WEIGHT_PER_FRAME   (0.74 * FSR3_UPSAMPLE_LANCZOS_WEIGHT_SCALE)
+
+#define FSR3_SHADING_CHANGE_SET_SIZE    5
+#define FSR3_LOCK_THRESHOLD             1.0
+#define FSR3_LOCK_MAX                   2.0
+
+// channels of the dilated reactive masks
+#define FSR3_REACTIVE       0
+#define FSR3_DISOCCLUSION   1
+#define FSR3_SHADING_CHANGE 2
+#define FSR3_ACCUMULATION   3
+
+highp float fsr3ReconstructedDepthMvPxThreshold(highp float nearestDepthInMeters) {
+    return mix(0.25, 0.75, saturate(nearestDepthInMeters / 100.0));
+}
+
+highp float fsr3Get4KVelocity(highp vec2 motionVector) {
+    return length(motionVector * vec2(3840.0, 2160.0));
+}
+
+highp float fsr3MinDividedByMax(highp float v0, highp float v1, highp float onZeroReturnValue) {
+    highp float m = max(v0, v1);
+    return m != 0.0 ? min(v0, v1) / m : onZeroReturnValue;
+}
+
+highp float fsr3MinDividedByMax(highp float v0, highp float v1) {
+    return fsr3MinDividedByMax(v0, v1, 0.0);
+}
+
+highp vec3 fsr3YCoCgToRGB(highp vec3 c) {
+    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
+}
+
+highp vec3 fsr3RGBToYCoCg(highp vec3 c) {
+    return vec3(
+             0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
+             0.5  * c.r              - 0.5  * c.b,
+            -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
+}
+
+highp float fsr3RGBToLuma(highp vec3 linearRgb) {
+    return dot(linearRgb, vec3(0.2126, 0.7152, 0.0722));
+}
+
+highp vec3 fsr3Tonemap(highp vec3 rgb) {
+    return rgb / (max(max(0.0, rgb.r), max(rgb.g, rgb.b)) + 1.0);
+}
+
+highp vec3 fsr3InverseTonemap(highp vec3 rgb) {
+    return rgb / max(FSR3_TONEMAP_EPSILON, 1.0 - max(rgb.r, max(rgb.g, rgb.b)));
+}
+
+bool fsr3IsUvInside(highp vec2 uv) {
+    return all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)));
+}
+
+bool fsr3IsOnScreen(ivec2 pos, ivec2 size) {
+    return all(greaterThanEqual(pos, ivec2(0))) && all(lessThan(pos, size));
+}
+
+ivec2 fsr3ClampLoad(ivec2 pos, ivec2 offset, ivec2 size) {
+    return clamp(pos + offset, ivec2(0), size - 1);
+}
+
+// ClampUv() with the texture size equal to the resource size
+highp vec2 fsr3ClampUv(highp vec2 uv, highp vec2 size) {
+    return clamp(uv * size, vec2(0.5), size - 0.5) / size;
+}
+
+// Linear view-space distance from Filament's (reversed-Z) device depth. depthParams holds
+// {p[2].z, p[3].z, p[2].w, p[3].w} of the view-from-clip matrix, see linearizeDepth().
+highp float fsr3GetViewSpaceDepth(highp float depth, highp vec4 depthParams) {
+    const highp float preventDiv0 = 1.0 / 16777216.0;
+    highp float z = (depth * depthParams.x + depthParams.y) /
+            max(depth * depthParams.z + depthParams.w, preventDiv0);
+    return -z;
+}
+
+// Filament's world units are meters
+highp float fsr3GetViewSpaceDepthInMeters(highp float depth, highp vec4 depthParams) {
+    return fsr3GetViewSpaceDepth(depth, depthParams);
+}
+
+highp ivec2 fsr3ComputeHrPosFromLrPos(ivec2 lrPos, highp vec2 jitter,
+        highp vec2 renderSize, highp vec2 upscaleSize) {
+    highp vec2 srcJitteredPos = vec2(lrPos) + 0.5 - jitter;
+    highp vec2 lrPosInHr = (srcJitteredPos / renderSize) * upscaleSize;
+    return ivec2(floor(lrPosInHr));
+}
+
+struct Fsr3BilinearSamplingData {
+    ivec2 offsets[4];
+    highp float weights[4];
+    ivec2 basePos;
+};
+
+Fsr3BilinearSamplingData fsr3GetBilinearSamplingData(highp vec2 uv, highp vec2 size) {
+    Fsr3BilinearSamplingData data;
+    highp vec2 pxSample = (uv * size) - 0.5;
+    data.basePos = ivec2(floor(pxSample));
+    highp vec2 pxFrac = fract(pxSample);
+    data.offsets[0] = ivec2(0, 0);
+    data.offsets[1] = ivec2(1, 0);
+    data.offsets[2] = ivec2(0, 1);
+    data.offsets[3] = ivec2(1, 1);
+    data.weights[0] = (1.0 - pxFrac.x) * (1.0 - pxFrac.y);
+    data.weights[1] = (pxFrac.x) * (1.0 - pxFrac.y);
+    data.weights[2] = (1.0 - pxFrac.x) * (pxFrac.y);
+    data.weights[3] = (pxFrac.x) * (pxFrac.y);
+    return data;
+}
+
+highp float fsr3Lanczos2NoClamp(highp float x) {
+    // PI is defined by Filament's common_math.glsl
+    return abs(x) < FSR3_EPSILON ? 1.0 :
+            (sin(PI * x) / (PI * x)) * (sin(0.5 * PI * x) / (0.5 * PI * x));
+}
+
+highp float fsr3Lanczos2(highp float x) {
+    return fsr3Lanczos2NoClamp(min(abs(x), 2.0));
+}
+
+// FSR1 lanczos approximation. Input is x*x.
+highp float fsr3Lanczos2ApproxSq(highp float x2) {
+    x2 = min(x2, 4.0);
+    highp float a = (2.0 / 5.0) * x2 - 1.0;
+    highp float b = (1.0 / 4.0) * x2 - 1.0;
+    return ((25.0 / 16.0) * a * a - (25.0 / 16.0 - 1.0)) * (b * b);
+}
diff --git a/filament/src/materials/fsr3/fsr3_frame_interpolation.mat b/filament/src/materials/fsr3/fsr3_frame_interpolation.mat
new file mode 100644
index 00000000..afcc79e3
--- /dev/null
+++ b/filament/src/materials/fsr3/fsr3_frame_interpolation.mat
@@ -0,0 +1,214 @@
+// Frame generation: interpolates the frame half-way between the previous and the current final
+// frames, using the game motion vectors (i.e. no optical flow). See fsr3_common.fs for the
+// conventions.
+//
+// Motion vectors point from this frame to the previous one: uvPrev = uv + mv. A surface at uv in
+// the interpolated frame is at uv - mv/2 in this frame and at uv + mv/2 in the previous one. We
+// don't know the motion vector at the interpolated position, so we gather candidates around it
+// (moving objects can cover uv in the interpolated frame without covering it in either frame)
+// and check each candidate against both frames: following the candidate into a frame must find
+// the same motion there (for the previous frame, we assume a constant velocity). The nearest
+// surface found in either frame is the one visible in the interpolated frame; the other frame
+// is blended in only if the same surface is visible there too.
+//
+// Regions where both frames disagree too much use a single frame. Motion that isn't captured by
+// the motion vectors (shadows, reflections, skinning, morphing, transparent objects) will show
+// as ghosting.
+
+material {
+    name : fsr3_frame_interpolation,
+    parameters : [
+        {
+            type : sampler2d,
+            name : previous,
+            precision: high
+        },
+        {
+            type : sampler2d,
+            name : current,
+            precision: high
+        },
+        {
+            type : sampler2d,
+            name : dilatedMotionVectors,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : dilatedDepth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : reactiveMasks,
+            precision: high
+        },
+        {
+            type : sampler2d,
+            name : previousMotionVectors,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : previousDepth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : bool,
+            name : hasPreviousMotion
+        },
+        {
+            type : float2,
+            name : renderSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : outputSize,
+            precision: high
+        }
+    ],
+    outputs : [
+        {
+            name : color,
+            target : color,
+            type : float4
+        }
+    ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+
+#include "fsr3_common.fs"
+
+ivec2 renderPos(highp vec2 uv) {
+    return clamp(ivec2(uv * materialParams.renderSize),
+            ivec2(0), ivec2(materialParams.renderSize) - 1);
+}
+
+highp vec2 loadMotionVector(highp vec2 uv) {
+    return texelFetch(materialParams_dilatedMotionVectors, renderPos(uv), 0).rg;
+}
+
+highp float loadDepth(highp vec2 uv) {
+    return texelFetch(materialParams_dilatedDepth, renderPos(uv), 0).r;
+}
+
+highp vec2 loadPreviousMotionVector(highp vec2 uv) {
+    return texelFetch(materialParams_previousMotionVectors, renderPos(uv), 0).rg;
+}
+
+highp float loadPreviousDepth(highp vec2 uv) {
+    return texelFetch(materialParams_previousDepth, renderPos(uv), 0).r;
+}
+
+// Search pattern, in render pixels: two rings around the center
+#define CANDIDATE_COUNT 17
+const highp vec2 candidateOffsets[CANDIDATE_COUNT] = vec2[](
+        vec2(  0.0,   0.0),
+        vec2( -6.0,  -6.0), vec2(  0.0,  -6.0), vec2(  6.0,  -6.0), vec2( -6.0,   0.0),
+        vec2(  6.0,   0.0), vec2( -6.0,   6.0), vec2(  0.0,   6.0), vec2(  6.0,   6.0),
+        vec2(-18.0, -18.0), vec2(  0.0, -18.0), vec2( 18.0, -18.0), vec2(-18.0,   0.0),
+        vec2( 18.0,   0.0), vec2(-18.0,  18.0), vec2(  0.0,  18.0), vec2( 18.0,  18.0));
+
+highp float tolerance(highp vec2 mv, highp vec2 renderTexel) {
+    return 1.5 * max(renderTexel.x, renderTexel.y) + 0.15 * length(mv);
+}
+
+bool isConsistentWithCurrent(highp vec2 uv, highp vec2 mv, highp vec2 renderTexel) {
+    return length(loadMotionVector(uv - 0.5 * mv) - mv) <= tolerance(mv, renderTexel);
+}
+
+bool isConsistentWithPrevious(highp vec2 uv, highp vec2 mv, highp vec2 renderTexel) {
+    if (!materialParams.hasPreviousMotion) {
+        return true;
+    }
+    return length(loadPreviousMotionVector(uv + 0.5 * mv) - mv) <= tolerance(mv, renderTexel);
+}
+
+void postProcess(inout PostProcessInputs postProcess) {
+    highp vec2 uv = (gl_FragCoord.xy) / materialParams.outputSize;
+    highp vec2 renderTexel = 1.0 / materialParams.renderSize;
+
+    // nearest surface (reversed-Z: larger is nearer) consistent with each frame
+    bool foundCurrent = false;
+    bool foundPrevious = false;
+    highp vec2 mvCurrent = vec2(0.0);
+    highp vec2 mvPrevious = vec2(0.0);
+    highp float depthCurrent = -1.0;
+    highp float depthPrevious = -1.0;
+
+    for (int i = 0; i < CANDIDATE_COUNT; i++) {
+        highp vec2 candidate = loadMotionVector(uv + candidateOffsets[i] * renderTexel);
+        if (isConsistentWithCurrent(uv, candidate, renderTexel)) {
+            highp float depth = loadDepth(uv - 0.5 * candidate);
+            if (depth > depthCurrent) {
+                depthCurrent = depth;
+                mvCurrent = candidate;
+                foundCurrent = true;
+            }
+        }
+        if (materialParams.hasPreviousMotion &&
+                isConsistentWithPrevious(uv, candidate, renderTexel)) {
+            highp float depth = loadPreviousDepth(uv + 0.5 * candidate);
+            if (depth > depthPrevious) {
+                depthPrevious = depth;
+                mvPrevious = candidate;
+                foundPrevious = true;
+            }
+        }
+    }
+
+    // Which frame shows the surface visible at uv in the interpolated frame. Without the
+    // previous frame's motion, we trust this frame (and the disocclusion mask).
+    bool useCurrent;
+    highp vec2 mv;
+    if (foundCurrent && foundPrevious) {
+        useCurrent = depthCurrent >= depthPrevious;
+        mv = useCurrent ? mvCurrent : mvPrevious;
+    } else if (foundCurrent || foundPrevious) {
+        useCurrent = foundCurrent;
+        mv = foundCurrent ? mvCurrent : mvPrevious;
+    } else {
+        useCurrent = true;
+        mv = loadMotionVector(uv);
+    }
+
+    highp vec2 uvCurrent = uv - 0.5 * mv;
+    highp vec2 uvPrevious = uv + 0.5 * mv;
+    highp vec4 current = textureLod(materialParams_current,
+            fsr3ClampUv(uvCurrent, materialParams.outputSize), 0.0);
+    highp vec4 previous = textureLod(materialParams_previous,
+            fsr3ClampUv(uvPrevious, materialParams.outputSize), 0.0);
+
+    // the other frame is blended in only if the same surface is visible there too
+    highp float otherWeight;
+    if (useCurrent) {
+        bool visible = fsr3IsUvInside(uvPrevious) && isConsistentWithPrevious(uv, mv, renderTexel);
+        // surfaces disoccluded in this frame have no valid previous sample
+        highp float disocclusion = saturate(textureLod(materialParams_reactiveMasks,
+                fsr3ClampUv(uvCurrent, materialParams.renderSize), 0.0)[FSR3_DISOCCLUSION]);
+        otherWeight = visible ? 0.5 * (1.0 - disocclusion) : 0.0;
+    } else {
+        bool visible = fsr3IsUvInside(uvCurrent) && isConsistentWithCurrent(uv, mv, renderTexel);
+        otherWeight = visible ? 0.5 : 0.0;
+    }
+
+    // don't blend samples that disagree, it shows as double edges
+    highp float difference = length(current.rgb - previous.rgb) /
+            (max(fsr3RGBToLuma(current.rgb), fsr3RGBToLuma(previous.rgb)) + 0.05);
+    otherWeight *= 1.0 - saturate((difference - 0.05) * 8.0);
+
+    highp float previousWeight = useCurrent ? otherWeight : 1.0 - otherWeight;
+    highp vec4 color = mix(current, previous, previousWeight);
+    postProcess.color = vec4(color.rgb, current.a);
+}
+
+}
diff --git a/filament/src/materials/fsr3/fsr3_luma_diff.mat b/filament/src/materials/fsr3/fsr3_luma_diff.mat
new file mode 100644
index 00000000..190ad228
--- /dev/null
+++ b/filament/src/materials/fsr3/fsr3_luma_diff.mat
@@ -0,0 +1,159 @@
+// Derived from SpdLoadSourceImage() of ffx_fsr3upscaler_shading_change_pyramid.h (FidelityFX SDK
+// v1.1.4), see fsr3_common.fs for the license and conventions.
+//
+// Outputs the signed luma difference with last frame and its sign, the pyramid of this texture is
+// then built with fsr3_reduce.mat.
+
+material {
+    name : fsr3_luma_diff,
+    parameters : [
+        {
+            type : sampler2d,
+            name : currentLuma,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : previousLuma,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : dilatedMotionVectors,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : float2,
+            name : renderSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : jitter,
+            precision: high
+        },
+        {
+            type : float2,
+            name : previousJitter,
+            precision: high
+        },
+        {
+            type : float,
+            name : deltaPreExposure
+        },
+        {
+            type : bool,
+            name : hasHistory
+        }
+    ],
+    outputs : [
+        {
+            name : diff,
+            target : color,
+            type : float2
+        }
+    ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+
+#include "fsr3_common.fs"
+
+struct SampleSet {
+    highp float samples[FSR3_SHADING_CHANGE_SET_SIZE];
+};
+
+#define CompareSwap(i, j) { \
+    highp float tmp = min(set.samples[i], set.samples[j]); \
+    set.samples[j] = max(set.samples[i], set.samples[j]); \
+    set.samples[i] = tmp; \
+}
+
+void sortSet(inout SampleSet set) {
+    CompareSwap(0, 3);
+    CompareSwap(1, 4);
+    CompareSwap(0, 2);
+    CompareSwap(1, 3);
+    CompareSwap(0, 1);
+    CompareSwap(2, 4);
+    CompareSwap(1, 2);
+    CompareSwap(3, 4);
+    CompareSwap(2, 3);
+}
+
+const ivec2 sampleOffsets[5] = ivec2[](
+        ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
+
+highp float computeMinimumDifference(SampleSet set0, SampleSet set1) {
+    highp float minDiff = FSR3_FP16_MAX - 1.0;
+    int a = 0;
+    int b = 0;
+
+    sortSet(set0);
+    sortSet(set1);
+
+    highp float maxValue = min(set0.samples[FSR3_SHADING_CHANGE_SET_SIZE - 1],
+            set1.samples[FSR3_SHADING_CHANGE_SET_SIZE - 1]);
+
+    if (maxValue > FSR3_FP32_MIN) {
+        for (int i = 0; i < FSR3_SHADING_CHANGE_SET_SIZE && (minDiff < FSR3_FP16_MAX); i++) {
+            highp float diff = set0.samples[a] - set1.samples[b];
+            if (abs(diff) > FSR3_FP16_MIN) {
+                diff = sign(diff) * (1.0 - fsr3MinDividedByMax(set0.samples[a], set1.samples[b]));
+                minDiff = (abs(diff) < abs(minDiff)) ? diff : minDiff;
+                a += int(set0.samples[a] < set1.samples[b]);
+                // 'a' can reach the set size on the last iteration, which would read out of
+                // bounds (undefined in GLSL)
+                b += int(set0.samples[min(a, FSR3_SHADING_CHANGE_SET_SIZE - 1)] >= set1.samples[b]);
+            } else {
+                minDiff = FSR3_FP16_MAX;
+            }
+        }
+    }
+    return minDiff * float(minDiff < (FSR3_FP16_MAX - 1.0));
+}
+
+SampleSet getCurrentLumaBilinearSamples(highp vec2 uv, ivec2 renderSize) {
+    highp vec2 uvJittered = uv + materialParams.jitter / materialParams.renderSize;
+    ivec2 basePos = ivec2(floor(uvJittered * materialParams.renderSize));
+    SampleSet set;
+    for (int i = 0; i < FSR3_SHADING_CHANGE_SET_SIZE; i++) {
+        ivec2 samplePos = fsr3ClampLoad(basePos, sampleOffsets[i], renderSize);
+        set.samples[i] = max(texelFetch(materialParams_currentLuma, samplePos, 0).r, FSR3_EPSILON);
+    }
+    return set;
+}
+
+void postProcess(inout PostProcessInputs postProcess) {
+    ivec2 renderSize = ivec2(materialParams.renderSize);
+    ivec2 pxPos = ivec2(gl_FragCoord.xy);
+    highp vec2 uv = (vec2(pxPos) + 0.5) / materialParams.renderSize;
+    highp vec2 motionVector = texelFetch(materialParams_dilatedMotionVectors, pxPos, 0).rg;
+
+    highp float diff = 0.0;
+    if (materialParams.hasHistory) {
+        highp vec2 uvJittered = uv + materialParams.previousJitter / materialParams.renderSize;
+        highp vec2 reprojectedUv = uvJittered + motionVector;
+        if (fsr3IsUvInside(reprojectedUv)) {
+            SampleSet current = getCurrentLumaBilinearSamples(uv, renderSize);
+            SampleSet previous;
+            ivec2 basePos = ivec2(floor(reprojectedUv * materialParams.renderSize));
+            for (int i = 0; i < FSR3_SHADING_CHANGE_SET_SIZE; i++) {
+                ivec2 samplePos = fsr3ClampLoad(basePos, sampleOffsets[i], renderSize);
+                previous.samples[i] = max(texelFetch(materialParams_previousLuma, samplePos, 0).r *
+                        materialParams.deltaPreExposure, FSR3_EPSILON);
+            }
+            diff = computeMinimumDifference(current, previous);
+        }
+    }
+
+    postProcess.diff = vec2(diff, diff != 0.0 ? sign(diff) : 0.0);
+}
+
+}
diff --git a/filament/src/materials/fsr3/fsr3_luma_instability.mat b/filament/src/materials/fsr3/fsr3_luma_instability.mat
new file mode 100644
index 00000000..d10d3774
--- /dev/null
+++ b/filament/src/materials/fsr3/fsr3_luma_instability.mat
@@ -0,0 +1,144 @@
+// Derived from ffx_fsr3upscaler_luma_instability.h (FidelityFX SDK v1.1.4), see fsr3_common.fs for
+// the license and conventions.
+
+material {
+    name : fsr3_luma_instability,
+    parameters : [
+        {
+            type : sampler2d,
+            name : dilatedMotionVectors,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : reactiveMasks,
+            precision: high
+        },
+        {
+            type : sampler2d,
+            name : currentLuma,
+            precision: high
+        },
+        {
+            type : sampler2d,
+            name : lumaHistory,
+            precision: high
+        },
+        {
+            type : float2,
+            name : renderSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : jitter,
+            precision: high
+        },
+        {
+            type : float2,
+            name : previousJitter,
+            precision: high
+        },
+        {
+            type : float,
+            name : deltaPreExposure
+        }
+    ],
+    outputs : [
+        {
+            name : newLumaHistory,
+            target : color,
+            type : float4
+        },
+        {
+            name : lumaInstability,
+            target : color,
+            type : float
+        }
+    ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+
+#include "fsr3_common.fs"
+
+#define N_MINUS_1 0
+#define N_MINUS_2 1
+#define N_MINUS_3 2
+#define N_MINUS_4 3
+
+highp float computeLumaInstabilityFactor(inout highp vec4 lumaHistory,
+        highp float currentFrameLuma) {
+    highp float lumaInstability = 0.0;
+    highp float diffs0 = currentFrameLuma - lumaHistory[N_MINUS_1];
+    highp float similarity0 = fsr3MinDividedByMax(currentFrameLuma, lumaHistory[N_MINUS_1], 1.0);
+
+    highp float maxSimilarity = similarity0;
+    if (similarity0 < 1.0) {
+        for (int i = N_MINUS_2; i <= N_MINUS_4; i++) {
+            highp float diffs1 = currentFrameLuma - lumaHistory[i];
+            highp float similarity1 = fsr3MinDividedByMax(currentFrameLuma, lumaHistory[i]);
+            if (sign(diffs0) == sign(diffs1)) {
+                maxSimilarity = max(maxSimilarity, similarity1);
+            }
+        }
+        lumaInstability = float(maxSimilarity > similarity0);
+    }
+
+    // shift history
+    lumaHistory[N_MINUS_4] = lumaHistory[N_MINUS_3];
+    lumaHistory[N_MINUS_3] = lumaHistory[N_MINUS_2];
+    lumaHistory[N_MINUS_2] = lumaHistory[N_MINUS_1];
+    lumaHistory[N_MINUS_1] = currentFrameLuma;
+
+    return lumaInstability * float(lumaHistory[N_MINUS_4] != 0.0);
+}
+
+void postProcess(inout PostProcessInputs postProcess) {
+    ivec2 pxPos = ivec2(gl_FragCoord.xy);
+    highp vec2 renderSize = materialParams.renderSize;
+
+    highp float lumaInstabilityFactor = 0.0;
+    highp vec4 lumaHistory = vec4(0.0);
+
+    highp vec2 dilatedMotionVector = texelFetch(materialParams_dilatedMotionVectors, pxPos, 0).rg;
+    highp vec2 uv = (vec2(pxPos) + 0.5) / renderSize;
+    highp vec2 uvCurrFrameJittered = uv + materialParams.jitter / renderSize;
+    highp vec2 uvPrevFrameJittered = uv + materialParams.previousJitter / renderSize;
+    highp vec2 reprojectedUv = uvPrevFrameJittered + dilatedMotionVector;
+
+    if (fsr3IsUvInside(reprojectedUv)) {
+        highp vec2 uvReactiveHw = fsr3ClampUv(uvCurrFrameJittered, renderSize);
+        highp vec4 dilatedReactiveMasks =
+                textureLod(materialParams_reactiveMasks, uvReactiveHw, 0.0);
+        highp float reactiveMask = saturate(dilatedReactiveMasks[FSR3_REACTIVE]);
+        highp float disocclusion = saturate(dilatedReactiveMasks[FSR3_DISOCCLUSION]);
+        highp float shadingChange = saturate(dilatedReactiveMasks[FSR3_SHADING_CHANGE]);
+        highp float accumulation = saturate(dilatedReactiveMasks[FSR3_ACCUMULATION]);
+
+        // accumulation is 0 when there is no history
+        if (accumulation > 0.9) {
+            highp float currentFrameLuma =
+                    textureLod(materialParams_currentLuma, uvReactiveHw, 0.0).r;
+            highp vec2 reprojectedUvHw = fsr3ClampUv(reprojectedUv, renderSize);
+            lumaHistory = textureLod(materialParams_lumaHistory, reprojectedUvHw, 0.0) *
+                    materialParams.deltaPreExposure;
+
+            lumaInstabilityFactor = computeLumaInstabilityFactor(lumaHistory, currentFrameLuma);
+
+            highp float velocityWeight =
+                    1.0 - saturate(fsr3Get4KVelocity(dilatedMotionVector) / 20.0);
+            lumaInstabilityFactor *= velocityWeight * (1.0 - disocclusion) *
+                    (1.0 - reactiveMask) * (1.0 - shadingChange);
+        }
+    }
+
+    postProcess.newLumaHistory = lumaHistory;
+    postProcess.lumaInstability = lumaInstabilityFactor;
+}
+
+}
diff --git a/filament/src/materials/fsr3/fsr3_prepare_inputs.mat b/filament/src/materials/fsr3/fsr3_prepare_inputs.mat
new file mode 100644
index 00000000..520f43d9
--- /dev/null
+++ b/filament/src/materials/fsr3/fsr3_prepare_inputs.mat
@@ -0,0 +1,150 @@
+// Derived from ffx_fsr3upscaler_prepare_inputs.h (FidelityFX SDK v1.1.4), see fsr3_common.fs
+// for the license and conventions.
+//
+// Differences with the original:
+// - The reconstructed previous depth isn't generated here (it needs scattered atomic writes), the
+//   disocclusion is instead computed from last frame's dilated depth, see
+//   fsr3_prepare_reactivity.mat.
+// - Pixels not covered by the velocity pass get a motion vector reprojected from the depth
+//   buffer, which only accounts for the camera motion.
+
+material {
+    name : fsr3_prepare_inputs,
+    parameters : [
+        {
+            type : sampler2d,
+            name : color,
+            precision: high
+        },
+        {
+            type : sampler2d,
+            name : depth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : velocity,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : mat4,
+            name : reprojection,
+            precision: high
+        },
+        {
+            type : float4,
+            name : depthParams,
+            precision: high
+        },
+        {
+            type : float2,
+            name : renderSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : jitter,
+            precision: high
+        }
+    ],
+    outputs : [
+        {
+            name : dilatedMotionVector,
+            target : color,
+            type : float2
+        },
+        {
+            name : dilatedDepth,
+            target : color,
+            type : float
+        },
+        {
+            name : luma,
+            target : color,
+            type : float
+        },
+        {
+            name : farthestDepth,
+            target : color,
+            type : float
+        }
+    ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+
+#include "fsr3_common.fs"
+
+highp float loadInputDepth(ivec2 pos) {
+    ivec2 renderSize = ivec2(materialParams.renderSize);
+    return texelFetch(materialParams_depth, fsr3ClampLoad(pos, ivec2(0), renderSize), 0).r;
+}
+
+highp vec2 loadInputMotionVector(ivec2 pos, highp float depth) {
+    if (depth > 0.0) {
+        // Covered by the structure pass: its velocity buffer holds the screen motion since the
+        // previous frame in texels (x right, y up); FSR3 wants render-target uvs pointing to
+        // last frame's position.
+        highp vec2 velocity = texelFetch(materialParams_velocity, pos, 0).rg;
+        highp vec2 uv = (vec2(pos) + 0.5) / materialParams.renderSize;
+        highp vec2 prevUv = uv - velocity / materialParams.renderSize;
+        return uvToRenderTargetUV(prevUv) - uvToRenderTargetUV(uv);
+    }
+    // Nothing was drawn here (the sky): reproject the (un-jittered) pixel center using the
+    // depth buffer and the camera transforms.
+    highp vec2 uv = (vec2(pos) + 0.5 - materialParams.jitter) / materialParams.renderSize;
+    highp vec2 ndc = uvToRenderTargetUV(uv) * 2.0 - 1.0;
+    highp vec4 q = materialParams.reprojection * vec4(ndc, depth, 1.0);
+    highp vec2 prevUv = uvToRenderTargetUV((q.xy / q.w) * 0.5 + 0.5);
+    return prevUv - uv;
+}
+
+void postProcess(inout PostProcessInputs postProcess) {
+    ivec2 pxPos = ivec2(gl_FragCoord.xy);
+    ivec2 renderSize = ivec2(materialParams.renderSize);
+
+    // FindDepthExtents(), with reversed-Z
+    const ivec2 sampleOffsets[9] = ivec2[](
+            ivec2( 0,  0), ivec2( 1,  0), ivec2( 0,  1), ivec2( 0, -1), ivec2(-1,  0),
+            ivec2(-1,  1), ivec2( 1,  1), ivec2(-1, -1), ivec2( 1, -1));
+
+    highp float depth[9];
+    for (int i = 0; i < 9; i++) {
+        depth[i] = loadInputDepth(pxPos + sampleOffsets[i]);
+    }
+
+    ivec2 nearestCoord = pxPos;
+    highp float nearest = depth[0];
+    highp float farthest = depth[0];
+    for (int i = 1; i < 9; i++) {
+        ivec2 pos = pxPos + sampleOffsets[i];
+        if (fsr3IsOnScreen(pos, renderSize)) {
+            highp float d = depth[i];
+            if (d > nearest) {
+                farthest = min(farthest, d);
+                nearestCoord = pos;
+                nearest = d;
+            }
+        }
+    }
+
+    // DilateMotionVector(), with low resolution motion vectors
+    highp vec2 dilatedMotionVector = loadInputMotionVector(nearestCoord, nearest);
+
+    highp float farthestDepthInMeters = min(
+            fsr3GetViewSpaceDepthInMeters(farthest, materialParams.depthParams), FSR3_FP16_MAX);
+
+    highp vec3 rgb = max(vec3(0.0), texelFetch(materialParams_color, pxPos, 0).rgb);
+
+    postProcess.dilatedMotionVector = dilatedMotionVector;
+    postProcess.dilatedDepth = nearest;
+    postProcess.luma = fsr3RGBToLuma(rgb);
+    postProcess.farthestDepth = farthestDepthInMeters;
+}
+
+}
diff --git a/filament/src/materials/fsr3/fsr3_prepare_reactivity.mat b/filament/src/materials/fsr3/fsr3_prepare_reactivity.mat
new file mode 100644
index 00000000..ca54bc7a
--- /dev/null
+++ b/filament/src/materials/fsr3/fsr3_prepare_reactivity.mat
@@ -0,0 +1,301 @@
+// Derived from ffx_fsr3upscaler_prepare_reactivity.h (FidelityFX SDK v1.1.4), see fsr3_common.fs
+// for the license and conventions.
+//
+// Differences with the original:
+// - The disocclusion test uses last frame's dilated depth transformed into this frame's view
+//   space, instead of this frame's depth scattered to last frame's positions.
+// - There are no user-provided reactive or transparency-and-composition masks.
+// - New locks are stored at the render resolution in the 2nd output, the accumulation pass maps
+//   them to the upscaled resolution.
+
+material {
+    name : fsr3_prepare_reactivity,
+    parameters : [
+        {
+            type : sampler2d,
+            name : dilatedMotionVectors,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : dilatedDepth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : previousDepth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : shadingChange,
+            precision: high
+        },
+        {
+            type : sampler2d,
+            name : previousAccumulation,
+            precision: high
+        },
+        {
+            type : sampler2d,
+            name : currentLuma,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : mat4,
+            name : viewFromPreviousClip,
+            precision: high
+        },
+        {
+            type : float4,
+            name : depthParams,
+            precision: high
+        },
+        {
+            type : float2,
+            name : renderSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : shadingChangeSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : jitter,
+            precision: high
+        },
+        {
+            type : float2,
+            name : previousJitter,
+            precision: high
+        },
+        {
+            type : float,
+            name : accumulationAddedPerFrame
+        },
+        {
+            type : float,
+            name : minDisocclusionAccumulation
+        },
+        {
+            type : bool,
+            name : hasHistory
+        }
+    ],
+    outputs : [
+        {
+            name : reactiveMasks,
+            target : color,
+            type : float4
+        },
+        {
+            name : accumulationAndLocks,
+            target : color,
+            type : float2
+        }
+    ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+
+#include "fsr3_common.fs"
+
+highp float getViewSpaceDepth(highp float depth) {
+    return fsr3GetViewSpaceDepth(depth, materialParams.depthParams);
+}
+
+// View-space distance, in this frame's view, of the surface visible last frame at pos
+highp float loadPreviousViewSpaceDepth(ivec2 pos) {
+    highp float depth = texelFetch(materialParams_previousDepth, pos, 0).r;
+    highp vec2 uv = (vec2(pos) + 0.5 - materialParams.previousJitter) / materialParams.renderSize;
+    highp vec2 ndc = uvToRenderTargetUV(uv) * 2.0 - 1.0;
+    highp vec4 p = materialParams.viewFromPreviousClip * vec4(ndc, depth, 1.0);
+    return -p.z / p.w;
+}
+
+highp float computeDisocclusions(highp vec2 uv, highp vec2 motionVector,
+        highp float currentDepthViewSpace) {
+    ivec2 renderSize = ivec2(materialParams.renderSize);
+    highp float nearestDepthInMeters = min(currentDepthViewSpace, FSR3_FP16_MAX);
+    highp float threshold = fsr3ReconstructedDepthMvPxThreshold(nearestDepthInMeters);
+    motionVector *= float(fsr3Get4KVelocity(motionVector) > threshold);
+
+    highp vec2 reprojectedUv = uv + motionVector;
+    Fsr3BilinearSamplingData bilinearInfo =
+            fsr3GetBilinearSamplingData(reprojectedUv, materialParams.renderSize);
+
+    highp float disocclusion = 0.0;
+    highp float weightSum = 0.0;
+    bool potentialDisocclusion = true;
+
+    for (int i = 0; i < 4 && potentialDisocclusion; i++) {
+        ivec2 samplePos = fsr3ClampLoad(bilinearInfo.basePos, bilinearInfo.offsets[i], renderSize);
+        highp float weight = bilinearInfo.weights[i];
+        if (weight > FSR3_RECONSTRUCTED_DEPTH_BILINEAR_WEIGHT_THRESHOLD) {
+            highp float prevDepthViewSpace = loadPreviousViewSpaceDepth(samplePos);
+            highp float depthDifference = currentDepthViewSpace - prevDepthViewSpace;
+            potentialDisocclusion = potentialDisocclusion && (depthDifference > FSR3_FP32_MIN);
+            if (potentialDisocclusion) {
+                highp float halfViewportWidth = length(materialParams.renderSize * 0.5);
+                highp float depthThreshold = max(currentDepthViewSpace, prevDepthViewSpace);
+                const highp float Ksep = 1.37e-05;
+                highp float requiredDepthSeparation = Ksep * halfViewportWidth * depthThreshold;
+                disocclusion += saturate(requiredDepthSeparation / depthDifference) * weight;
+                weightSum += weight;
+            }
+        }
+    }
+
+    return (potentialDisocclusion && weightSum > 0.0) ?
+            saturate(1.0 - disocclusion / weightSum) : 0.0;
+}
+
+highp float computeMotionDivergence(highp vec2 uv, highp vec2 motionVector,
+        highp float currentDepthSample) {
+    ivec2 renderSize = ivec2(materialParams.renderSize);
+    ivec2 reprojectedPos = clamp(ivec2((uv + motionVector) * materialParams.renderSize),
+            ivec2(0), renderSize - 1);
+    highp float reprojectedDepth = texelFetch(materialParams_dilatedDepth, reprojectedPos, 0).r;
+    highp vec2 reprojectedMotionVector =
+            texelFetch(materialParams_dilatedMotionVectors, reprojectedPos, 0).rg;
+
+    highp float reprojectedVelocity = fsr3Get4KVelocity(reprojectedMotionVector);
+    highp float velocity4K = fsr3Get4KVelocity(motionVector);
+    if (velocity4K <= 0.0) {
+        // avoids 0/0 below, the velocity factor is 0 in that case anyway
+        return 0.0;
+    }
+
+    highp float nucleusDepthInMeters =
+            fsr3GetViewSpaceDepthInMeters(reprojectedDepth, materialParams.depthParams);
+    highp float currentDepthInMeters =
+            fsr3GetViewSpaceDepthInMeters(currentDepthSample, materialParams.depthParams);
+    highp float distanceFactor = fsr3MinDividedByMax(nucleusDepthInMeters, currentDepthInMeters);
+    highp float velocityFactor = saturate(velocity4K / 10.0);
+    return (1.0 - saturate(reprojectedVelocity / velocity4K)) * distanceFactor * velocityFactor;
+}
+
+highp float computeThinFeatureConfidence(ivec2 pxPos) {
+    //  1 2 3
+    //  4 0 5
+    //  6 7 8
+    const int nucleusIndex = 0;
+    const ivec2 sampleOffsets[9] = ivec2[](
+            ivec2( 0,  0), ivec2(-1, -1), ivec2( 0, -1), ivec2( 1, -1), ivec2(-1,  0),
+            ivec2( 1,  0), ivec2(-1,  1), ivec2( 0,  1), ivec2( 1,  1));
+
+    ivec2 renderSize = ivec2(materialParams.renderSize);
+    highp float samples[9];
+    highp float lumaMin = FSR3_FP32_MAX;
+    highp float lumaMax = FSR3_FP32_MIN;
+    for (int i = 0; i < 9; i++) {
+        ivec2 samplePos = fsr3ClampLoad(pxPos, sampleOffsets[i], renderSize);
+        samples[i] = texelFetch(materialParams_currentLuma, samplePos, 0).r;
+        lumaMin = min(lumaMin, samples[i]);
+        lumaMax = max(lumaMax, samples[i]);
+    }
+
+    // A flat neighborhood can't be a ridge. The original relies on NaN comparisons (0/0 below)
+    // to reach the same result, which GLSL compilers don't reliably preserve.
+    if (lumaMax <= lumaMin) {
+        return 0.0;
+    }
+
+    const highp float threshold = 0.9;
+    highp float dissimilarLumaMin = FSR3_FP32_MAX;
+    highp float dissimilarLumaMax = 0.0;
+
+    uint patternMask = 1u << uint(nucleusIndex); // flag nucleus as similar
+    const uint rejectionMasks[4] = uint[](
+            (1u << 1u) | (1u << 2u) | (1u << 4u) | 1u,  // upper left
+            (1u << 2u) | (1u << 3u) | (1u << 5u) | 1u,  // upper right
+            (1u << 4u) | (1u << 6u) | (1u << 7u) | 1u,  // lower left
+            (1u << 5u) | (1u << 7u) | (1u << 8u) | 1u); // lower right
+
+    for (int i = 1; i < 9; i++) {
+        highp float difference = abs(samples[i] - samples[nucleusIndex]) / (lumaMax - lumaMin);
+        if (difference < threshold) {
+            patternMask |= 1u << uint(i);
+        } else {
+            dissimilarLumaMin = min(dissimilarLumaMin, samples[i]);
+            dissimilarLumaMax = max(dissimilarLumaMax, samples[i]);
+        }
+    }
+
+    bool isRidge = samples[nucleusIndex] > dissimilarLumaMax ||
+            samples[nucleusIndex] < dissimilarLumaMin;
+    if (!isRidge) {
+        return 0.0;
+    }
+
+    for (int i = 0; i < 4; i++) {
+        if ((patternMask & rejectionMasks[i]) == rejectionMasks[i]) {
+            return 0.0;
+        }
+    }
+
+    return 1.0 - lumaMin / lumaMax;
+}
+
+highp float updateAccumulation(highp vec2 uv, highp vec2 motionVector,
+        highp float disocclusion, highp float shadingChange, out highp float accumulationToStore) {
+    highp vec2 reprojectedUv = uv + motionVector;
+    highp float accumulation = 0.0;
+    if (materialParams.hasHistory && fsr3IsUvInside(reprojectedUv)) {
+        highp vec2 reprojectedUvHw = fsr3ClampUv(reprojectedUv, materialParams.renderSize);
+        accumulation = saturate(
+                textureLod(materialParams_previousAccumulation, reprojectedUvHw, 0.0).r);
+    }
+
+    accumulation = mix(accumulation, 0.0, shadingChange);
+    accumulation = mix(accumulation,
+            min(materialParams.minDisocclusionAccumulation, accumulation), disocclusion);
+    accumulation *= float(round(accumulation * 100.0) > 1.0);
+
+    // update for next frame, normalized to be stored in unorm
+    accumulationToStore = saturate(accumulation + materialParams.accumulationAddedPerFrame);
+    return accumulation;
+}
+
+highp float computeShadingChange(highp vec2 uv) {
+    // NOTE: Here we re-apply jitter, will be reverted again when sampled in accumulation pass
+    highp vec2 shadingChangeUv = fsr3ClampUv(uv - materialParams.jitter / materialParams.renderSize,
+            materialParams.shadingChangeSize);
+    return saturate(textureLod(materialParams_shadingChange, shadingChangeUv, 0.0).r);
+}
+
+void postProcess(inout PostProcessInputs postProcess) {
+    ivec2 pxPos = ivec2(gl_FragCoord.xy);
+    highp vec2 uv = (vec2(pxPos) + 0.5) / materialParams.renderSize;
+    highp vec2 motionVector = texelFetch(materialParams_dilatedMotionVectors, pxPos, 0).rg;
+    highp float dilatedDepth = texelFetch(materialParams_dilatedDepth, pxPos, 0).r;
+
+    highp float disocclusion = materialParams.hasHistory ?
+            computeDisocclusions(uv, motionVector, getViewSpaceDepth(dilatedDepth)) : 0.0;
+
+    // there are no reactive masks, so DilateReactiveMasks() is always 0
+    highp float shadingChange = computeShadingChange(uv);
+    highp float motionDivergence = computeMotionDivergence(uv, motionVector, dilatedDepth);
+    highp float finalReactiveness = motionDivergence;
+
+    highp float accumulationToStore;
+    highp float accumulation = updateAccumulation(uv, motionVector, disocclusion, shadingChange,
+            accumulationToStore);
+
+    highp float lockStrength = computeThinFeatureConfidence(pxPos);
+
+    postProcess.reactiveMasks = vec4(finalReactiveness, disocclusion, shadingChange, accumulation);
+    postProcess.accumulationAndLocks = vec2(accumulationToStore,
+            lockStrength > (1.0 / 100.0) ? lockStrength : 0.0);
+}
+
+}
diff --git a/filament/src/materials/fsr3/fsr3_reduce.mat b/filament/src/materials/fsr3/fsr3_reduce.mat
new file mode 100644
index 00000000..8779e6d6
--- /dev/null
+++ b/filament/src/materials/fsr3/fsr3_reduce.mat
@@ -0,0 +1,37 @@
+// Replaces the single pass downsampler (SPD) used by the FSR3 upscaler for the luma and shading
+// change pyramids: each invocation averages 2x2 texels of the source, which
+// is SpdReduce4() of ffx_fsr3upscaler_luma_pyramid.h and ffx_fsr3upscaler_shading_change_pyramid.h.
+// The source is either another texture or a single-level view of the previous level.
+
+material {
+    name : fsr3_reduce,
+    parameters : [
+        {
+            type : sampler2d,
+            name : source,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : int2,
+            name : sourceSize
+        }
+    ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+
+void postProcess(inout PostProcessInputs postProcess) {
+    ivec2 pos = ivec2(gl_FragCoord.xy) * 2;
+    ivec2 last = materialParams.sourceSize - 1;
+    highp vec4 s00 = texelFetch(materialParams_source, min(pos + ivec2(0, 0), last), 0);
+    highp vec4 s10 = texelFetch(materialParams_source, min(pos + ivec2(1, 0), last), 0);
+    highp vec4 s01 = texelFetch(materialParams_source, min(pos + ivec2(0, 1), last), 0);
+    highp vec4 s11 = texelFetch(materialParams_source, min(pos + ivec2(1, 1), last), 0);
+    postProcess.color = (s00 + s10 + s01 + s11) * 0.25;
+}
+
+}
diff --git a/filament/src/materials/fsr3/fsr3_shading_change.mat b/filament/src/materials/fsr3/fsr3_shading_change.mat
new file mode 100644
index 00000000..a0fe6d56
--- /dev/null
+++ b/filament/src/materials/fsr3/fsr3_shading_change.mat
@@ -0,0 +1,66 @@
+// Derived from ffx_fsr3upscaler_shading_change.h (FidelityFX SDK v1.1.4), see fsr3_common.fs for
+// the license and conventions.
+//
+// Runs at half the render resolution. The pyramid's level 0 is half the render resolution.
+
+material {
+    name : fsr3_shading_change,
+    parameters : [
+        {
+            type : sampler2d,
+            name : pyramid,
+            precision: high
+        },
+        {
+            type : float2,
+            name : renderSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : shadingChangeSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : jitter,
+            precision: high
+        }
+    ],
+    outputs : [
+        {
+            name : shadingChange,
+            target : color,
+            type : float
+        }
+    ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+
+#include "fsr3_common.fs"
+
+#define MIP_LEVELS_TO_USE 3
+
+void postProcess(inout PostProcessInputs postProcess) {
+    ivec2 pxPos = ivec2(gl_FragCoord.xy);
+    highp vec2 uv = (vec2(pxPos) + 0.5) / materialParams.shadingChangeSize;
+    highp vec2 uvJittered = uv + materialParams.jitter / materialParams.renderSize;
+    highp vec2 mipUv = fsr3ClampUv(uvJittered, materialParams.shadingChangeSize);
+
+    highp float shadingChange = 0.0;
+    for (int level = 0; level < MIP_LEVELS_TO_USE; level++) {
+        highp vec2 s = textureLod(materialParams_pyramid, mipUv, float(level)).rg;
+        highp float value = abs(s.x * s.y);
+        if (value > 0.0) {
+            shadingChange = max(shadingChange, value);
+        }
+    }
+
+    postProcess.shadingChange = saturate(shadingChange);
+}
+
+}
