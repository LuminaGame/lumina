+    auto const reduce = [&](utils::StaticString const name,
+            FrameGraphId<FrameGraphTexture> const source,
+            uint32_t const width, uint32_t const height, uint8_t const levels,
+            TextureFormat const format) {
+        struct ReduceData {
+            FrameGraphId<FrameGraphTexture> source;
+            FrameGraphId<FrameGraphTexture> output;
+        };
+        auto const& pass = fg.addPass<ReduceData>(name.c_str(),
+                [&](FrameGraph::Builder& builder, auto& data) {
+                    data.source = builder.sample(source);
+                    data.output = builder.createTexture(name, {
+                            .width = width, .height = height, .levels = levels,
+                            .format = format });
+                    data.output = builder.write(data.output,
+                            FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                    builder.declareRenderPass(name, {
+                            .attachments = { .color = { data.output }}});
+                },
+                [=, this](FrameGraphResources const& resources, auto const& data,
+                        DriverApi& driver) {
+                    bindPostProcessDescriptorSet(driver);
+                    bindPerRenderableDescriptorSet(driver);
+                    auto const& sourceDesc = resources.getDescriptor(data.source);
+                    auto const& material = getPostProcessMaterial("fsr3_reduce");
+                    FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                    mi->setParameter("source", resources.getTexture(data.source), nearest);
+                    mi->setParameter("sourceSize",
+                            int2{ int32_t(sourceDesc.width), int32_t(sourceDesc.height) });
+                    commitAndRenderFullScreenQuad(driver, resources.getRenderPassInfo(), mi);
+                    unbindAllDescriptorSets(driver);
+                });
+        return pass->output;
+    };
+
+    auto const farthestDepthMip1 = reduce("FSR3 Farthest Depth Mip1",
+            prepareInputs->farthestDepth, halfWidth, halfHeight, 1, TextureFormat::R16F);
+
+    struct LumaDiffData {
+        FrameGraphId<FrameGraphTexture> currentLuma;
+        FrameGraphId<FrameGraphTexture> previousLuma;
+        FrameGraphId<FrameGraphTexture> dilatedMotionVectors;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+    auto const& lumaDiff = fg.addPass<LumaDiffData>("FSR3 Luma Diff",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.currentLuma = builder.sample(prepareInputs->luma);
+                data.previousLuma = builder.sample(lumaHistory);
+                data.dilatedMotionVectors = builder.sample(prepareInputs->dilatedMotionVectors);
+                data.output = builder.createTexture("FSR3 Luma Diff", {
+                        .width = renderWidth, .height = renderHeight,
+                        .format = TextureFormat::RG16F });
+                data.output = builder.write(data.output,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                builder.declareRenderPass("FSR3 Luma Diff Target", {
+                        .attachments = { .color = { data.output }}});
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& material = getPostProcessMaterial("fsr3_luma_diff");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("currentLuma", resources.getTexture(data.currentLuma), nearest);
+                mi->setParameter("previousLuma", resources.getTexture(data.previousLuma), nearest);
+                mi->setParameter("dilatedMotionVectors",
+                        resources.getTexture(data.dilatedMotionVectors), nearest);
+                mi->setParameter("renderSize", renderSize);
+                mi->setParameter("jitter", jitter);
+                mi->setParameter("previousJitter", previousJitter);
+                mi->setParameter("deltaPreExposure", deltaPreExposure);
+                mi->setParameter("hasHistory", hasHistory);
+                commitAndRenderFullScreenQuad(driver, resources.getRenderPassInfo(), mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    // The shading change pyramid has 3 levels, starting at half the render resolution
+    constexpr uint8_t SHADING_CHANGE_LEVELS = 3;
+    auto const shadingChangePyramid = reduce("FSR3 Shading Change Pyramid",
+            lumaDiff->output, halfWidth, halfHeight, SHADING_CHANGE_LEVELS, TextureFormat::RG16F);
+
+    struct PyramidMipmapData {
+        FrameGraphId<FrameGraphTexture> pyramid;
+    };
+    auto const& pyramidMipmap = fg.addPass<PyramidMipmapData>("FSR3 Shading Change Mipmap",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                builder.reserveRenderTargets(SHADING_CHANGE_LEVELS - 1);
+                data.pyramid = builder.sample(shadingChangePyramid);
+                for (uint8_t level = 1; level < SHADING_CHANGE_LEVELS; level++) {
+                    auto out = builder.createSubresource(data.pyramid,
+                            "FSR3 Shading Change Pyramid mip", { .level = level });
+                    out = builder.write(out, FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                    builder.declareRenderPass("FSR3 Shading Change Pyramid mip target", {
+                            .attachments = { .color = { out }}});
+                }
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const in = resources.getTexture(data.pyramid);
+                auto const& material = getPostProcessMaterial("fsr3_reduce");
+                FMaterial const* const ma = material.getMaterial(mEngine);
+                FMaterialInstance* const mi = getMaterialInstance(driver, ma);
+                // Only the source texture is changing in the material instance (no UBO
+                // updates), we do not move getMaterialInstance() inside the loop.
+                auto const pipeline = getPipelineState(mi);
+                for (uint8_t level = 0; level < SHADING_CHANGE_LEVELS - 1; level++) {
+                    auto const out = resources.getRenderPassInfo(level);
+                    auto const th = driver.createTextureView(in, level, 1);
+                    mi->setParameter("source", th, SamplerParams{
+                            .filterMin = SamplerMinFilter::NEAREST_MIPMAP_NEAREST });
+                    mi->setParameter("sourceSize", int2{
+                            int32_t(std::max(1u, halfWidth >> level)),
+                            int32_t(std::max(1u, halfHeight >> level)) });
+                    mi->commit(driver, getUboManager());
+                    mi->use(driver);
+                    renderFullScreenQuad(out, pipeline, driver);
+                    DescriptorSet::unbind(driver, DescriptorSetBindingPoints::PER_MATERIAL);
+                    driver.destroyTexture(th);
+                }
+                unbindAllDescriptorSets(driver);
+            });
+
+    struct ShadingChangeData {
+        FrameGraphId<FrameGraphTexture> pyramid;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+    auto const& shadingChange = fg.addPass<ShadingChangeData>("FSR3 Shading Change",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.pyramid = builder.sample(pyramidMipmap->pyramid);
+                data.output = builder.createTexture("FSR3 Shading Change", {
+                        .width = halfWidth, .height = halfHeight,
+                        .format = TextureFormat::R8 });
+                data.output = builder.write(data.output,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                builder.declareRenderPass("FSR3 Shading Change Target", {
+                        .attachments = { .color = { data.output }}});
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& material = getPostProcessMaterial("fsr3_shading_change");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("pyramid", resources.getTexture(data.pyramid), SamplerParams{
+                        .filterMag = SamplerMagFilter::LINEAR,
+                        .filterMin = SamplerMinFilter::LINEAR_MIPMAP_NEAREST });
+                mi->setParameter("renderSize", renderSize);
+                mi->setParameter("shadingChangeSize", halfSize);
+                mi->setParameter("jitter", jitter);
+                commitAndRenderFullScreenQuad(driver, resources.getRenderPassInfo(), mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    /*
+     * Reactivity: disocclusion, shading change, accumulation and new locks
+     */
+
+    struct PrepareReactivityData {
+        FrameGraphId<FrameGraphTexture> dilatedMotionVectors;
+        FrameGraphId<FrameGraphTexture> dilatedDepth;
+        FrameGraphId<FrameGraphTexture> previousDepth;
+        FrameGraphId<FrameGraphTexture> shadingChange;
+        FrameGraphId<FrameGraphTexture> previousAccumulation;
+        FrameGraphId<FrameGraphTexture> currentLuma;
+        FrameGraphId<FrameGraphTexture> reactiveMasks;
+        FrameGraphId<FrameGraphTexture> accumulation;
+    };
+    auto const& prepareReactivity = fg.addPass<PrepareReactivityData>("FSR3 Prepare Reactivity",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.dilatedMotionVectors = builder.sample(prepareInputs->dilatedMotionVectors);
+                data.dilatedDepth = builder.sample(prepareInputs->dilatedDepth);
+                data.previousDepth = builder.sample(depthHistory);
+                data.shadingChange = builder.sample(shadingChange->output);
+                data.previousAccumulation = builder.sample(accumulationHistory);
+                data.currentLuma = builder.sample(prepareInputs->luma);
+                data.reactiveMasks = builder.createTexture("FSR3 Reactive Masks", {
+                        .width = renderWidth, .height = renderHeight,
+                        .format = TextureFormat::RGBA8 });
+                data.accumulation = builder.createTexture("FSR3 Accumulation", {
+                        .width = renderWidth, .height = renderHeight,
+                        .format = TextureFormat::RG8 });
+                data.reactiveMasks = builder.write(data.reactiveMasks,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                data.accumulation = builder.write(data.accumulation,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                builder.declareRenderPass("FSR3 Prepare Reactivity Target", {
+                        .attachments = { .color = { data.reactiveMasks, data.accumulation }}});
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& material = getPostProcessMaterial("fsr3_prepare_reactivity");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("dilatedMotionVectors",
+                        resources.getTexture(data.dilatedMotionVectors), nearest);
+                mi->setParameter("dilatedDepth", resources.getTexture(data.dilatedDepth), nearest);
+                mi->setParameter("previousDepth",
+                        resources.getTexture(data.previousDepth), nearest);
+                mi->setParameter("shadingChange",
+                        resources.getTexture(data.shadingChange), linear);
+                mi->setParameter("previousAccumulation",
+                        resources.getTexture(data.previousAccumulation), linear);
+                mi->setParameter("currentLuma", resources.getTexture(data.currentLuma), nearest);
+                mi->setParameter("viewFromPreviousClip", viewFromPreviousClip);
+                mi->setParameter("depthParams", depthParams);
+                mi->setParameter("renderSize", renderSize);
+                mi->setParameter("shadingChangeSize", halfSize);
+                mi->setParameter("jitter", jitter);
+                mi->setParameter("previousJitter", previousJitter);
+                // FSR3's defaults
+                mi->setParameter("accumulationAddedPerFrame", 1.0f / 3.0f);
+                mi->setParameter("minDisocclusionAccumulation", -1.0f / 3.0f);
+                mi->setParameter("hasHistory", hasHistory);
+                commitAndRenderFullScreenQuad(driver, resources.getRenderPassInfo(), mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    /*
+     * Luma instability
+     */
+
+    struct LumaInstabilityData {
+        FrameGraphId<FrameGraphTexture> dilatedMotionVectors;
+        FrameGraphId<FrameGraphTexture> reactiveMasks;
+        FrameGraphId<FrameGraphTexture> currentLuma;
+        FrameGraphId<FrameGraphTexture> previousLumaHistory;
+        FrameGraphId<FrameGraphTexture> lumaHistory;
+        FrameGraphId<FrameGraphTexture> lumaInstability;
+    };
+    auto const& lumaInstability = fg.addPass<LumaInstabilityData>("FSR3 Luma Instability",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.dilatedMotionVectors = builder.sample(prepareInputs->dilatedMotionVectors);
+                data.reactiveMasks = builder.sample(prepareReactivity->reactiveMasks);
+                data.currentLuma = builder.sample(prepareInputs->luma);
+                data.previousLumaHistory = builder.sample(lumaHistoryHistory);
+                data.lumaHistory = builder.createTexture("FSR3 Luma History", {
+                        .width = renderWidth, .height = renderHeight,
+                        .format = TextureFormat::RGBA16F });
+                data.lumaInstability = builder.createTexture("FSR3 Luma Instability", {
+                        .width = renderWidth, .height = renderHeight,
+                        .format = TextureFormat::R16F });
+                data.lumaHistory = builder.write(data.lumaHistory,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                data.lumaInstability = builder.write(data.lumaInstability,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                builder.declareRenderPass("FSR3 Luma Instability Target", {
+                        .attachments = { .color = { data.lumaHistory, data.lumaInstability }}});
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& material = getPostProcessMaterial("fsr3_luma_instability");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("dilatedMotionVectors",
+                        resources.getTexture(data.dilatedMotionVectors), nearest);
+                mi->setParameter("reactiveMasks",
+                        resources.getTexture(data.reactiveMasks), linear);
+                mi->setParameter("currentLuma", resources.getTexture(data.currentLuma), linear);
+                mi->setParameter("lumaHistory",
+                        resources.getTexture(data.previousLumaHistory), linear);
+                mi->setParameter("renderSize", renderSize);
+                mi->setParameter("jitter", jitter);
+                mi->setParameter("previousJitter", previousJitter);
+                mi->setParameter("deltaPreExposure", deltaPreExposure);
+                commitAndRenderFullScreenQuad(driver, resources.getRenderPassInfo(), mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    /*
+     * Accumulation, at the upscaled resolution
+     */
+
+    struct AccumulateData {
+        FrameGraphId<FrameGraphTexture> color;
+        FrameGraphId<FrameGraphTexture> dilatedMotionVectors;
+        FrameGraphId<FrameGraphTexture> previousHistory;
+        FrameGraphId<FrameGraphTexture> lumaInstability;
+        FrameGraphId<FrameGraphTexture> farthestDepthMip1;
+        FrameGraphId<FrameGraphTexture> reactiveMasks;
+        FrameGraphId<FrameGraphTexture> accumulation;
+        FrameGraphId<FrameGraphTexture> history;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+    auto const& accumulate = fg.addPass<AccumulateData>("FSR3 Accumulate",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.color = builder.sample(input);
+                data.dilatedMotionVectors = builder.sample(prepareInputs->dilatedMotionVectors);
+                data.previousHistory = builder.sample(colorHistory);
+                data.lumaInstability = builder.sample(lumaInstability->lumaInstability);
+                data.farthestDepthMip1 = builder.sample(farthestDepthMip1);
+                data.reactiveMasks = builder.sample(prepareReactivity->reactiveMasks);
+                data.accumulation = builder.sample(prepareReactivity->accumulation);
+                data.history = builder.createTexture("FSR3 History", {
+                        .width = upscaleWidth, .height = upscaleHeight,
+                        .format = TextureFormat::RGBA16F });
+                data.output = builder.createTexture("FSR3 Output", {
+                        .width = upscaleWidth, .height = upscaleHeight,
+                        .format = inputDesc.format });
+                data.history = builder.write(data.history,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                data.output = builder.write(data.output,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                builder.declareRenderPass("FSR3 Accumulate Target", {
+                        .attachments = { .color = { data.history, data.output }}});
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& material = getPostProcessMaterial("fsr3_accumulate");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("color", resources.getTexture(data.color), nearest);
+                mi->setParameter("dilatedMotionVectors",
+                        resources.getTexture(data.dilatedMotionVectors), nearest);
+                mi->setParameter("history", resources.getTexture(data.previousHistory), nearest);
+                mi->setParameter("lumaInstability",
+                        resources.getTexture(data.lumaInstability), linear);
+                mi->setParameter("farthestDepthMip1",
+                        resources.getTexture(data.farthestDepthMip1), linear);
+                mi->setParameter("reactiveMasks",
+                        resources.getTexture(data.reactiveMasks), linear);
+                mi->setParameter("accumulationAndLocks",
+                        resources.getTexture(data.accumulation), nearest);
+                mi->setParameter("renderSize", renderSize);
+                mi->setParameter("upscaleSize", upscaleSize);
+                mi->setParameter("farthestDepthMip1Size", halfSize);
+                mi->setParameter("jitter", jitter);
+                mi->setParameter("deltaPreExposure", deltaPreExposure);
+                mi->setParameter("jitterSequenceLength", jitterSequenceLength);
+                mi->setParameter("velocityFactor", 1.0f);
+                mi->setParameter("hasHistory", hasHistory);
+                commitAndRenderFullScreenQuad(driver, resources.getRenderPassInfo(), mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    /*
+     * Export the history for the next frame
+     */
+
+    struct ExportHistoryData {
+        FrameGraphId<FrameGraphTexture> color;
+        FrameGraphId<FrameGraphTexture> luma;
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> accumulation;
+        FrameGraphId<FrameGraphTexture> lumaHistory;
+        FrameGraphId<FrameGraphTexture> motionVectors;
+    };
+    fg.addPass<ExportHistoryData>("Export FSR3 history",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                // We need to use sideEffect here to ensure this pass won't be culled.
+                // The "output" of this pass is going to be used during the next frame as
+                // an "import".
+                builder.sideEffect();
+                data.color = builder.sample(accumulate->history);
+                data.luma = builder.sample(prepareInputs->luma);
+                data.depth = builder.sample(prepareInputs->dilatedDepth);
+                data.accumulation = builder.sample(prepareReactivity->accumulation);
+                data.lumaHistory = builder.sample(lumaInstability->lumaHistory);
+                data.motionVectors = builder.sample(prepareInputs->dilatedMotionVectors);
+            }, [&current](FrameGraphResources const& resources, auto const& data) {
+                resources.detach(data.color, &current.color.texture, &current.color.desc);
+                resources.detach(data.luma, &current.luma.texture, &current.luma.desc);
+                resources.detach(data.depth, &current.depth.texture, &current.depth.desc);
+                resources.detach(data.accumulation,
+                        &current.accumulation.texture, &current.accumulation.desc);
+                resources.detach(data.lumaHistory,
+                        &current.lumaHistory.texture, &current.lumaHistory.desc);
+                resources.detach(data.motionVectors,
+                        &current.motionVectors.texture, &current.motionVectors.desc);
+            });
+
+    // used by frame generation, see frameInterpolation()
+    auto& blackboard = fg.getBlackboard();
+    blackboard["fsr3DilatedMotionVectors"] = prepareInputs->dilatedMotionVectors;
+    blackboard["fsr3DilatedDepth"] = prepareInputs->dilatedDepth;
+    blackboard["fsr3ReactiveMasks"] = prepareReactivity->reactiveMasks;
+
+    FrameGraphId<FrameGraphTexture> output = accumulate->output;
+
+    // optional sharpen pass from FSR1
+    if (taaOptions.sharpness > 0.0f) {
+        output = rcas(fg, taaOptions.sharpness, output, fg.getDescriptor(output),
+                translucent ? RcasMode::ALPHA_PASSTHROUGH : RcasMode::OPAQUE);
+    }
+
+    return output;
+}
+
+FrameGraphId<FrameGraphTexture> PostProcessManager::frameInterpolation(FrameGraph& fg,
+        FrameGraphId<FrameGraphTexture> const current, FrameHistory& frameHistory) noexcept {
+    auto& blackboard = fg.getBlackboard();
+    auto const motionVectors = blackboard.get<FrameGraphTexture>("fsr3DilatedMotionVectors");
+    auto const depth = blackboard.get<FrameGraphTexture>("fsr3DilatedDepth");
+    auto const reactiveMasks = blackboard.get<FrameGraphTexture>("fsr3ReactiveMasks");
+    assert_invariant(motionVectors && depth && reactiveMasks);
+
+    auto const& previousEntry = frameHistory.getPrevious().frameGeneration;
+    auto& currentEntry = frameHistory.getCurrent().frameGeneration;
+
+    FrameGraphTexture::Descriptor const desc = fg.getDescriptor(current);
+    bool const hasHistory = previousEntry.color.handle &&
+            previousEntry.desc.width == desc.width &&
+            previousEntry.desc.height == desc.height &&
+            previousEntry.desc.format == desc.format;
+    FrameGraphId<FrameGraphTexture> const previous = hasHistory ?
+            fg.import("Frame generation history", previousEntry.desc,
+                    FrameGraphTexture::Usage::SAMPLEABLE, previousEntry.color) :
+            current;
+
+    // Last frame's motion vectors and depth, to check candidate motions against the previous
+    // frame too. Without them, this frame's are used and the check always passes.
+    auto const& previousFsr3 = frameHistory.getPrevious().fsr3;
+    FrameGraphTexture::Descriptor const mvDesc = fg.getDescriptor(motionVectors);
+    bool const hasPreviousMotion = hasHistory &&
+            previousFsr3.motionVectors.texture.handle && previousFsr3.depth.texture.handle &&
+            previousFsr3.motionVectors.desc.width == mvDesc.width &&
+            previousFsr3.motionVectors.desc.height == mvDesc.height &&
+            previousFsr3.depth.desc.width == mvDesc.width &&
+            previousFsr3.depth.desc.height == mvDesc.height;
+    FrameGraphId<FrameGraphTexture> const previousMotionVectors = hasPreviousMotion ?
+            fg.import("Frame generation previous motion vectors",
+                    previousFsr3.motionVectors.desc, FrameGraphTexture::Usage::SAMPLEABLE,
+                    previousFsr3.motionVectors.texture) :
+            motionVectors;
+    FrameGraphId<FrameGraphTexture> const previousDepth = hasPreviousMotion ?
+            fg.import("Frame generation previous depth",
+                    previousFsr3.depth.desc, FrameGraphTexture::Usage::SAMPLEABLE,
+                    previousFsr3.depth.texture) :
+            depth;
+
+    struct FrameInterpolationData {
+        FrameGraphId<FrameGraphTexture> previous;
+        FrameGraphId<FrameGraphTexture> current;
+        FrameGraphId<FrameGraphTexture> motionVectors;
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> reactiveMasks;
+        FrameGraphId<FrameGraphTexture> previousMotionVectors;
+        FrameGraphId<FrameGraphTexture> previousDepth;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+    auto const& interpolation = fg.addPass<FrameInterpolationData>("FSR3 Frame Interpolation",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.previous = builder.sample(previous);
+                data.current = builder.sample(current);
+                data.motionVectors = builder.sample(motionVectors);
+                data.depth = builder.sample(depth);
+                data.reactiveMasks = builder.sample(reactiveMasks);
+                data.previousMotionVectors = builder.sample(previousMotionVectors);
+                data.previousDepth = builder.sample(previousDepth);
+                data.output = builder.createTexture("Interpolated Frame", {
+                        .width = desc.width, .height = desc.height, .format = desc.format });
+                data.output = builder.write(data.output,
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                builder.declareRenderPass("FSR3 Frame Interpolation Target", {
+                        .attachments = { .color = { data.output }}});
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& mvDesc = resources.getDescriptor(data.motionVectors);
+                SamplerParams const linear{
+                        .filterMag = SamplerMagFilter::LINEAR,
+                        .filterMin = SamplerMinFilter::LINEAR };
+                auto const& material = getPostProcessMaterial("fsr3_frame_interpolation");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("previous", resources.getTexture(data.previous), linear);
+                mi->setParameter("current", resources.getTexture(data.current), linear);
+                mi->setParameter("dilatedMotionVectors",
+                        resources.getTexture(data.motionVectors), SamplerParams{});
+                mi->setParameter("dilatedDepth", resources.getTexture(data.depth), SamplerParams{});
+                mi->setParameter("reactiveMasks",
+                        resources.getTexture(data.reactiveMasks), linear);
+                mi->setParameter("previousMotionVectors",
+                        resources.getTexture(data.previousMotionVectors), SamplerParams{});
+                mi->setParameter("previousDepth",
+                        resources.getTexture(data.previousDepth), SamplerParams{});
+                mi->setParameter("hasPreviousMotion", hasPreviousMotion);
+                mi->setParameter("renderSize",
+                        float2{ float(mvDesc.width), float(mvDesc.height) });
+                mi->setParameter("outputSize", float2{ float(desc.width), float(desc.height) });
+                commitAndRenderFullScreenQuad(driver, resources.getRenderPassInfo(), mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    // The rendered frame is kept for the next frame's interpolation, and is presented by the
+    // Renderer after the interpolated one (hence BLIT_SRC).
+    struct ExportData {
+        FrameGraphId<FrameGraphTexture> color;
+    };
+    fg.addPass<ExportData>("Export frame generation history",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                // the "output" of this pass is used during endFrame() and the next frame
+                builder.sideEffect();
