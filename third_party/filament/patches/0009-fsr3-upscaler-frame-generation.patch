+        FrameGraphId<FrameGraphTexture> velocity;
+        FrameGraphId<FrameGraphTexture> dilatedMotionVectors;
+        FrameGraphId<FrameGraphTexture> dilatedDepth;
+        FrameGraphId<FrameGraphTexture> luma;
+        FrameGraphId<FrameGraphTexture> farthestDepth;
+    };
