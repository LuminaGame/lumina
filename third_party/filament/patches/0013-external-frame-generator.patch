+/**
+ * Frame generation implemented outside Filament (DLSS Frame Generation for instance): from the
+ * final frame of a view rendered into the SwapChain, its depth and its motion, generates
+ * generatedFrameCount() frames between the previous final frame and this one. The first is
+ * presented in place of this frame's present; Renderer::endFrame() then presents the others and
+ * finally the rendered frame, spacing the presents evenly when the SwapChain has no vsync
+ * (SwapChain::CONFIG_DISABLE_VSYNC). Vulkan only; the view must render into the SwapChain
+ * without guard band and not be translucent. FSR3 frame generation takes precedence.
+ *
+ * @see View::setExternalFrameGenerator
+ */
+class UTILS_PUBLIC ExternalFrameGenerator {
+public:
+    /** At most this many frames are generated per rendered frame (6x presentation). */
+    static constexpr uint32_t MAX_GENERATED_FRAMES = 5;
+
+    /** Indices of the images evaluate() receives in ExternalPassContext::images. */
+    enum Image : uint32_t {
+        COLOR = 0,      //!< the final frame of the view (after colour grading), read-only
+        DEPTH = 1,      //!< the colour pass depth at the render resolution (reversed Z)
+        MOTION = 2,     //!< as ExternalPostPass::MOTION, at the final frame's size
+        /**
+         * OUTPUT + i (i < generatedFrameCount()): storage images of the final frame's size and
+         * format for generated frame i + 1 of the sequence between the previous frame and this
+         * one (OUTPUT is the earliest).
+         */
+        OUTPUT = 3,
+    };
+
+    /** Frames to generate per rendered frame, 1 to MAX_GENERATED_FRAMES. Asked every frame. */
+    virtual uint32_t generatedFrameCount() const noexcept = 0;
+
+    /**
+     * Called on the main thread with the final frame's size. Return false to present this frame
+     * alone.
+     */
+    virtual bool supports(uint32_t width, uint32_t height) noexcept = 0;
+
+    /**
+     * Called on the backend thread while the frame's command buffer records; frame.flags
+     * carries ExternalPassFrame::FLAG_HISTORY_RESET on the first frame and after
+     * View::resetExternalPostPassHistory(). Record into context.commandBuffer only and write
+     * every output.
+     */
+    virtual void evaluate(backend::ExternalPassContext const& context) noexcept = 0;
+
+protected:
+    ~ExternalFrameGenerator() = default;
+};
