+FrameGraphId<FrameGraphTexture> PostProcessManager::externalFrameGeneration(FrameGraph& fg,
+        ExternalFrameGenerator* const generator, FrameGraphId<FrameGraphTexture> const input,
+        FrameGraphId<FrameGraphTexture> const depth, FrameGraphId<FrameGraphTexture> const velocity,
+        math::float2 jitter, uint32_t const frameId, bool const resetHistory,
+        CameraInfo const& cameraInfo, FrameHistory& frameHistory) noexcept {
+
+    auto const& inputDesc = fg.getDescriptor(input);
+    uint32_t const count = std::min(generator ? generator->generatedFrameCount() : 0u,
+            ExternalFrameGenerator::MAX_GENERATED_FRAMES);
+    if (!generator || !depth || count == 0 ||
+            !generator->supports(inputDesc.width, inputDesc.height)) {
+        return input;
+    }
+    auto const& depthDesc = fg.getDescriptor(depth);
+
+    // the motion at the final frame's size, as for the external post pass
+    switch (mEngine.getBackend()) {
+        case Backend::METAL:
+        case Backend::VULKAN:
+        case Backend::WEBGPU:
+            jitter.y = -jitter.y;
+            break;
+        default:
+            break;
+    }
+    math::mat4f const projection = cameraInfo.projection;
+    math::mat4f jittered = projection;
+    jittered[2].xy -= jitter * (2.0f / math::float2{ depthDesc.width, depthDesc.height });
+    math::mat4 const clipFromWorld = math::mat4(projection) * math::mat4(cameraInfo.view);
+    math::mat4 const worldFromClip = math::mat4(cameraInfo.model) * inverse(math::mat4(jittered));
+    auto const& previous = frameHistory.getPrevious().postPass;
+    auto& current = frameHistory.getCurrent().postPass;
+    bool const historyValid = previous.valid && !resetHistory;
+    math::mat4 const prevClipFromWorld = historyValid ? previous.clipFromWorld : clipFromWorld;
+    current.clipFromWorld = clipFromWorld;
+    current.valid = true;
+
+    struct MotionData {
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> velocity;
+        FrameGraphId<FrameGraphTexture> motion;
+    };
+    auto const& motionPass = fg.addPass<MotionData>("external frame generation motion",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.depth = builder.sample(depth);
+                if (velocity) {
+                    data.velocity = builder.sample(velocity);
+                }
+                data.motion = builder.createTexture("external frame generation motion", {
+                        .width = inputDesc.width, .height = inputDesc.height,
+                        .format = TextureFormat::RGBA16F });
+                data.motion = builder.declareRenderPass(data.motion);
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& out = resources.getRenderPassInfo();
+                auto const& material = getPostProcessMaterial("postPassMotion");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("depth", resources.getTexture(data.depth), SamplerParams{});
+                math::float2 velocitySize{ 1.0f, 1.0f };
+                if (data.velocity) {
+                    auto const& vdesc = resources.getDescriptor(data.velocity);
+                    velocitySize = { float(vdesc.width), float(vdesc.height) };
+                    mi->setParameter("velocity", resources.getTexture(data.velocity),
+                            SamplerParams{});
+                } else {
+                    mi->setParameter("velocity", mEngine.getZeroTexture(), SamplerParams{});
+                }
+                mi->setParameter("worldFromClip", math::mat4f(worldFromClip));
+                mi->setParameter("clipFromWorld", math::mat4f(clipFromWorld));
+                mi->setParameter("prevClipFromWorld", math::mat4f(prevClipFromWorld));
+                mi->setParameter("resolution", math::float4{
+                        float(inputDesc.width), float(inputDesc.height),
+                        1.0f / float(inputDesc.width), 1.0f / float(inputDesc.height) });
+                mi->setParameter("depthSize",
+                        math::float2{ float(depthDesc.width), float(depthDesc.height) });
+                mi->setParameter("velocitySize", velocitySize);
+                mi->setParameter("hasVelocity", data.velocity ? 1.0f : 0.0f);
+                mi->setParameter("historyValid", historyValid ? 1.0f : 0.0f);
+                commitAndRenderFullScreenQuad(driver, out, mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    struct GenerationData {
+        FrameGraphId<FrameGraphTexture> color;
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> motion;
+        FrameGraphId<FrameGraphTexture> outputs[ExternalFrameGenerator::MAX_GENERATED_FRAMES];
+    };
+    float const exposure = Exposure::exposure(cameraInfo.ev100);
+    math::mat4f const viewFromWorld = cameraInfo.view;
+    auto const& generation = fg.addPass<GenerationData>("external frame generation",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.color = builder.read(input, FrameGraphTexture::Usage::SAMPLEABLE);
+                data.depth = builder.read(depth, FrameGraphTexture::Usage::SAMPLEABLE);
+                data.motion = builder.read(motionPass->motion, FrameGraphTexture::Usage::SAMPLEABLE);
+                for (uint32_t i = 0; i < count; i++) {
+                    data.outputs[i] = builder.createTexture("generated frame", {
+                            .width = inputDesc.width, .height = inputDesc.height,
+                            .format = inputDesc.format });
+                    data.outputs[i] = builder.write(data.outputs[i],
+                            FrameGraphTexture::Usage::STORAGE | FrameGraphTexture::Usage::SAMPLEABLE |
+                            FrameGraphTexture::Usage::COLOR_ATTACHMENT |
+                            FrameGraphTexture::Usage::BLIT_SRC);
+                    builder.declareRenderPass(builder.getName(data.outputs[i]), {
+                            .attachments = { .color = { data.outputs[i] } } });
+                }
+                builder.sideEffect();
+            },
+            [generator, count, inputDesc, depthDesc, historyValid, exposure, projection,
+                    viewFromWorld, jitter, frameId](FrameGraphResources const& resources,
+                    auto const& data, DriverApi& driver) {
+                ExternalPassDescriptor descriptor{};
+                descriptor.callback = [](ExternalPassContext const& context) {
+                    static_cast<ExternalFrameGenerator*>(context.user)->evaluate(context);
+                };
+                descriptor.user = generator;
+                descriptor.textureCount = ExternalFrameGenerator::OUTPUT + count;
+                descriptor.textures[ExternalFrameGenerator::COLOR] = resources.getTexture(data.color);
+                descriptor.textures[ExternalFrameGenerator::DEPTH] = resources.getTexture(data.depth);
+                descriptor.textures[ExternalFrameGenerator::MOTION] = resources.getTexture(data.motion);
+                for (uint32_t i = 0; i < count; i++) {
+                    descriptor.textures[ExternalFrameGenerator::OUTPUT + i] =
+                            resources.getTexture(data.outputs[i]);
+                    descriptor.writeMask |= 1u << (ExternalFrameGenerator::OUTPUT + i);
+                }
+                descriptor.frame.jitter[0] = jitter.x;
+                descriptor.frame.jitter[1] = jitter.y;
+                descriptor.frame.renderWidth = depthDesc.width;
+                descriptor.frame.renderHeight = depthDesc.height;
+                descriptor.frame.outputWidth = inputDesc.width;
+                descriptor.frame.outputHeight = inputDesc.height;
+                descriptor.frame.frameId = frameId;
+                descriptor.frame.flags = historyValid ? 0u : ExternalPassFrame::FLAG_HISTORY_RESET;
+                descriptor.frame.exposure = exposure;
+                std::memcpy(descriptor.frame.viewFromWorld, &viewFromWorld,
+                        sizeof(descriptor.frame.viewFromWorld));
+                std::memcpy(descriptor.frame.clipFromView, &projection,
+                        sizeof(descriptor.frame.clipFromView));
+                driver.externalPass(descriptor);
+            });
+
+    // The rendered frame and the later generated frames are presented by the Renderer after
+    // the first generated one (hence BLIT_SRC), and kept for the next frame.
+    auto& currentEntry = frameHistory.getCurrent().frameGeneration;
+    currentEntry.generatedCount = count - 1;
+    struct ExportData {
+        FrameGraphId<FrameGraphTexture> color;
+        FrameGraphId<FrameGraphTexture> generated[ExternalFrameGenerator::MAX_GENERATED_FRAMES - 1];
+    };
+    fg.addPass<ExportData>("Export external frame generation",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                builder.sideEffect();
+                data.color = builder.read(input, FrameGraphTexture::Usage::BLIT_SRC);
+                for (uint32_t i = 1; i < count; i++) {
+                    data.generated[i - 1] = builder.read(generation->outputs[i],
+                            FrameGraphTexture::Usage::BLIT_SRC);
+                }
+            }, [&currentEntry, count](FrameGraphResources const& resources, auto const& data) {
+                resources.detach(data.color, &currentEntry.color, &currentEntry.desc);
+                for (uint32_t i = 1; i < count; i++) {
+                    FrameGraphTexture::Descriptor desc;
+                    resources.detach(data.generated[i - 1], &currentEntry.generated[i - 1], &desc);
+                }
+            });
+
+    return generation->outputs[0];
+}
