+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "VulkanPresentPacer.h"
+
+#include "VulkanAsyncHandles.h"
+
+#include <utils/JobSystem.h>
+
+#include <algorithm>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+#endif
+
+namespace filament::backend {
+
+uint64_t VulkanPresentHistory::now() noexcept {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+void VulkanPresentHistory::record(uint64_t const nanos) noexcept {
+    std::lock_guard const lock(mLock);
+    mTimes[mCount % CAPACITY] = nanos;
+    mCount++;
+}
+
+size_t VulkanPresentHistory::read(uint64_t* out, size_t capacity) const noexcept {
+    std::lock_guard const lock(mLock);
+    size_t const n = std::min({ mCount, CAPACITY, capacity });
+    for (size_t i = 0; i < n; i++) {
+        out[i] = mTimes[(mCount - n + i) % CAPACITY];
+    }
+    return n;
+}
+
+VulkanPresentPacer::VulkanPresentPacer(VkDevice const device, PresentFn present,
+        VulkanPresentHistory* history)
+        : mDevice(device), mPresent(std::move(present)), mHistory(history) {
+#if defined(_WIN32)
+    mTimer = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+            TIMER_ALL_ACCESS);
+#endif
+    mThread = std::thread([this] { loop(); });
+}
+
+VulkanPresentPacer::~VulkanPresentPacer() {
+    {
+        std::lock_guard const lock(mLock);
+        mStop = true;
+    }
+    mCondition.notify_all();
+    if (mThread.joinable()) {
+        mThread.join();
+    }
+    mDone.clear();
+#if defined(_WIN32)
+    if (mTimer) {
+        CloseHandle(HANDLE(mTimer));
+    }
+#endif
+}
+
+void VulkanPresentPacer::enqueue(uint32_t const index, VkSemaphore const finished,
+        std::shared_ptr<VulkanCmdFence> fence, uint32_t const slot, uint32_t const count) {
+    std::vector<std::shared_ptr<VulkanCmdFence>> done;
+    std::unique_lock lock(mLock);
+    mCondition.wait(lock, [this] { return mQueue.size() < MAX_QUEUED; });
+    mQueue.push_back({ index, finished, std::move(fence), slot, std::max(1u, count) });
+    done.swap(mDone);
+    lock.unlock();
+    mCondition.notify_all();
+}
+
+void VulkanPresentPacer::drain() {
+    std::vector<std::shared_ptr<VulkanCmdFence>> done;
+    std::unique_lock lock(mLock);
+    mCondition.wait(lock, [this] { return mQueue.empty() && !mBusy; });
+    done.swap(mDone);
+}
+
+void VulkanPresentPacer::waitUntil(clock::time_point const target) noexcept {
+    // Sleep most of the wait and yield the rest. Windows' default timer tick is 15.6 ms,
+    // longer than the spacing of generated frames: a high-resolution waitable timer sleeps
+    // to the sub-millisecond there.
+    constexpr auto margin = std::chrono::microseconds(500);
+    auto const remaining = target - clock::now();
+    if (remaining > margin) {
+#if defined(_WIN32)
+        if (mTimer) {
+            LARGE_INTEGER due;
+            // relative, in 100 ns units
+            due.QuadPart = -LONGLONG(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                    remaining - margin).count() / 100);
+            if (SetWaitableTimerEx(HANDLE(mTimer), &due, 0, nullptr, nullptr, nullptr, 0)) {
+                WaitForSingleObject(HANDLE(mTimer), INFINITE);
+            }
+        } else {
+            std::this_thread::sleep_until(target - margin);
+        }
+#else
+        std::this_thread::sleep_until(target - margin);
+#endif
+    }
+    while (clock::now() < target) {
+        std::this_thread::yield();
+    }
+}
+
+void VulkanPresentPacer::loop() {
+    utils::JobSystem::setThreadName("FilamentPresent");
+    while (true) {
+        Job job;
+        bool behind = false;
+        {
+            std::unique_lock lock(mLock);
+            mCondition.wait(lock, [this] { return !mQueue.empty() || mStop; });
+            if (mQueue.empty()) {
+                break; // stopping, nothing left
+            }
+            job = std::move(mQueue.front());
+            mQueue.pop_front();
+            mBusy = true;
+            // The GPU runs a frame or two behind the driver thread, so later rendered frames are
+            // normally queued already; more than that is a backlog: present without spacing to
+            // catch up.
+            behind = std::count_if(mQueue.begin(), mQueue.end(),
+                    [](Job const& j) { return j.slot == 0; }) > MAX_FRAMES_AHEAD;
+        }
+        mCondition.notify_all();
+
+        // the image is ready once the command buffer that drew it completed
+        if (job.fence) {
+            job.fence->wait(mDevice, uint64_t(-1), clock::time_point::max());
+        }
+        clock::time_point const ready = clock::now();
+        if (job.slot == 0) {
+            if (mLastReady.time_since_epoch().count()) {
+                double const dt = std::chrono::duration<double>(ready - mLastReady).count();
+                // a long pause (frame generation just turned on, a hitch) does not count
+                if (dt < 0.25) {
+                    mInterval = mInterval > 0.0 ? mInterval * 0.9 + dt * 0.1 : dt;
+                }
+            }
+            mLastReady = ready;
+        }
+
+        clock::time_point target = ready;
+        if (job.count > 1 && mInterval > 0.0 && !behind && mLastPresent.time_since_epoch().count()) {
+            auto const spacing = std::chrono::duration_cast<clock::duration>(
+                    std::chrono::duration<double>(mInterval / double(job.count)));
+            target = std::max(ready, mLastPresent + spacing);
+            // never hold a frame longer than one rendered-frame interval
+            target = std::min(target, ready + std::chrono::duration_cast<clock::duration>(
+                    std::chrono::duration<double>(mInterval)));
+        }
+        waitUntil(target);
+
+        if (mPresent) {
+            mPresent(job.index, job.finished);
+        }
+        mLastPresent = clock::now();
+        if (mHistory) {
+            mHistory->record(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                    mLastPresent.time_since_epoch()).count()));
+        }
+        {
+            std::lock_guard const lock(mLock);
+            if (job.fence) {
+                mDone.push_back(std::move(job.fence));
+            }
+            mBusy = false;
+        }
+        mCondition.notify_all();
+    }
+}
+
+} // namespace filament::backend
