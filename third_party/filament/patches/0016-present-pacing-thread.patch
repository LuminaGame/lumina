diff --git a/filament/backend/src/vulkan/VulkanPresentPacer.cpp b/filament/backend/src/vulkan/VulkanPresentPacer.cpp
new file mode 100644
index 00000000..a7e63eba
--- /dev/null
+++ b/filament/backend/src/vulkan/VulkanPresentPacer.cpp
@@ -0,0 +1,201 @@
+/*
