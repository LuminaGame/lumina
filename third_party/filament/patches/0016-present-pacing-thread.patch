+#ifndef TNT_FILAMENT_BACKEND_VULKANPRESENTPACER_H
+#define TNT_FILAMENT_BACKEND_VULKANPRESENTPACER_H
+
+#include <bluevk/BlueVK.h>
+
+#include <array>
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include <stdint.h>
+
+namespace filament::backend {
+
+struct VulkanCmdFence;
+
+/**
+ * The steady-clock times of a SwapChain's most recent presents, shared by the driver thread
+ * (direct presents) and the present thread, read by Renderer::getPresentTimes().
+ */
+class VulkanPresentHistory {
+public:
+    static constexpr size_t CAPACITY = 1024;
+    void record(uint64_t nanos) noexcept;
+    size_t read(uint64_t* out, size_t capacity) const noexcept;
+    static uint64_t now() noexcept;
+
+private:
+    mutable std::mutex mLock;
+    std::array<uint64_t, CAPACITY> mTimes{};
+    size_t mCount = 0;
+};
+
+/**
+ * Presents a vsync-less SwapChain's images from its own thread. The driver thread queues each
+ * image with the fence of the command buffer that drew it and its slot among the presents of
+ * one rendered frame (frame generation presents several); the thread waits for the GPU, then
+ * spaces the presents of a rendered frame evenly over the measured rendered-frame interval.
+ * The render and driver threads never wait for the pacing, so generated frames multiply the
+ * presented frame rate instead of stretching the frame. Queue access is serialised with the
+ * driver thread's submits (fvkutils::queueMutex()).
+ */
+class VulkanPresentPacer {
+public:
+    // presents one image (null for headless SwapChains, which only record the time)
+    using PresentFn = std::function<VkResult(uint32_t index, VkSemaphore finished)>;
+
+    VulkanPresentPacer(VkDevice device, PresentFn present, VulkanPresentHistory* history);
+    ~VulkanPresentPacer();
+
+    VulkanPresentPacer(VulkanPresentPacer const&) = delete;
+    VulkanPresentPacer& operator=(VulkanPresentPacer const&) = delete;
+
+    // Queues one present: slot is its index among the `count` presents of one rendered frame.
+    // Blocks only when too many presents are already queued.
+    void enqueue(uint32_t index, VkSemaphore finished, std::shared_ptr<VulkanCmdFence> fence,
+            uint32_t slot, uint32_t count);
+
+    // Waits until every queued present has been issued.
+    void drain();
+
+private:
+    struct Job {
+        uint32_t index;
+        VkSemaphore finished;
+        std::shared_ptr<VulkanCmdFence> fence;
+        uint32_t slot;
