+
+namespace filament::backend::fvkutils {
+
+// Vulkan queues are externally synchronised. The driver thread submits and the present threads
+// of vsync-less SwapChains (VulkanPresentPacer) present on the same queue: every
+// vkQueueSubmit, vkQueuePresentKHR and vkQueueWaitIdle takes this lock.
