+void VulkanDriver::setPresentPacing(Handle<HwSwapChain> sch, uint32_t slot, uint32_t count) {
+    if (!sch) {
+        return;
+    }
+    auto swapChain = resource_ptr<VulkanSwapChain>::cast(&mResourceManager, sch);
+    swapChain->setPresentPacing(slot, count);
+}
+
+bool VulkanDriver::isPresentPacingSupported() {
+    return true;
+}
+
+size_t VulkanDriver::getPresentTimes(Handle<HwSwapChain> sch, uint64_t* times, size_t capacity) {
+    // a synchronous call: the histories are looked up under the timing lock, like
+    // queryCompositorTiming(), instead of touching the ref-counted swap chain
+    std::shared_ptr<VulkanPresentHistory> history;
+    {
+        utils::LockGuard const lock(mTiming.lock);
+        auto const it = mTiming.presentHistories.find(sch.getId());
+        if (it != mTiming.presentHistories.end()) {
+            history = it->second;
+        }
+    }
+    return history && times ? history->read(times, capacity) : 0;
+}
