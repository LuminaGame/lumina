+// The first bone update of a frame turns the palette the previous frame rendered with (the
+// CPU shadow) into the previous palette the motion vectors read; later updates in the same
+// frame only move the current one.
+void FRenderableManager::keepPreviousBones(Bones& bones) noexcept {
+    if (!bones.prevHandle || !bones.shadow || bones.prevFrame == mMotionFrame) {
+        return;
+    }
+    auto& driver = mEngine.getDriverApi();
+    auto* prev = driver.allocatePod<PerRenderableBoneUib::BoneData>(bones.count);
+    std::copy_n(bones.shadow, bones.count, prev);
+    driver.updateBufferObject(bones.prevHandle, {
+            prev, bones.count * sizeof(PerRenderableBoneUib::BoneData) }, 0);
+    bones.prevFrame = mMotionFrame;
+    bones.prevStale = true;
+}
+
+void FRenderableManager::syncPreviousPose(Instance const instance) noexcept {
+    if (!instance) {
+        return;
+    }
+    auto& driver = mEngine.getDriverApi();
+    Bones& bones = mManager[instance].bones;
+    if (bones.prevHandle && bones.shadow && bones.prevStale && bones.prevFrame != mMotionFrame) {
+        auto* prev = driver.allocatePod<PerRenderableBoneUib::BoneData>(bones.count);
+        std::copy_n(bones.shadow, bones.count, prev);
+        driver.updateBufferObject(bones.prevHandle, {
+                prev, bones.count * sizeof(PerRenderableBoneUib::BoneData) }, 0);
+        bones.prevStale = false;
+    }
+    MorphWeights& morphWeights = mManager[instance].morphWeights;
+    if (morphWeights.prevHandle && morphWeights.shadow && morphWeights.prevStale
+            && morphWeights.prevFrame != mMotionFrame) {
+        auto* prev = static_cast<float4*>(driver.allocate(sizeof(float4) * morphWeights.count));
+        std::copy_n(morphWeights.shadow, morphWeights.count, prev);
+        driver.updateBufferObject(morphWeights.prevHandle, { prev, sizeof(float4) * morphWeights.count }, 0);
+        morphWeights.prevStale = false;
+    }
+}
