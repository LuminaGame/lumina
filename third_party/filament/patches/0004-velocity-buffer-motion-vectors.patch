diff --git a/shaders/src/surface_getters.vs b/shaders/src/surface_getters.vs
index 5eb08579..56b1c1ac 100644
--- a/shaders/src/surface_getters.vs
+++ b/shaders/src/surface_getters.vs
@@ -271,6 +271,95 @@ vec4 getPosition() {
     return pos;
 }
 
+#if defined(VARIANT_DEPTH)
+#if defined(VARIANT_HAS_SKINNING_OR_MORPHING)
+// The previous frame's pose (motion vectors): the same morphing and skinning as getPosition(),
+// read from the previous frame's weights and bone palette.
+vec3 mulBoneVertexPrev(vec3 v, uint i) {
+    highp mat4x3 m = transpose(prevBonesUniforms.bones[i].transform);
+    return v.x * m[0].xyz + (v.y * m[1].xyz + (v.z * m[2].xyz + m[3].xyz));
+}
+
+void skinPositionPrev(inout vec3 p, const uvec4 ids, const vec4 weights) {
+    if (weights.w >= 0.0) {
+        p = weights.x * mulBoneVertexPrev(p, uint(ids.x))
+            + weights.y * mulBoneVertexPrev(p, uint(ids.y))
+            + weights.z * mulBoneVertexPrev(p, uint(ids.z))
+            + weights.w * mulBoneVertexPrev(p, uint(ids.w));
+        return;
+    }
+    vec3 posSum = weights.x * mulBoneVertexPrev(p, uint(ids.x));
+    posSum += weights.y * mulBoneVertexPrev(p, uint(ids.y));
+    posSum += weights.z * mulBoneVertexPrev(p, uint(ids.z));
+    uint pairIndex = uint(-weights.w - 1.);
+    uint pairStop = pairIndex + uint(ids.w - 3u);
+    for (uint i = pairIndex; i < pairStop; ++i) {
+        ivec2 texcoord = ivec2(i % MAX_SKINNING_BUFFER_WIDTH, i / MAX_SKINNING_BUFFER_WIDTH);
+        vec2 indexWeight = texelFetch(sampler1_indicesAndWeights, texcoord, 0).rg;
+        posSum += mulBoneVertexPrev(p, uint(indexWeight.r)) * indexWeight.g;
+    }
+    p = posSum;
+}
+
+#if !defined(LEGACY_MORPHING)
+void morphPositionPrev(inout vec4 p) {
+    int index = getVertexIndex() + pushConstants.morphingBufferOffset;
+    ivec3 texcoord = ivec3(index % MAX_MORPH_TARGET_BUFFER_WIDTH, index / MAX_MORPH_TARGET_BUFFER_WIDTH, 0);
+    int c = object_uniforms_morphTargetCount;
+    for (int i = 0; i < c; ++i) {
+        float w = prevMorphingUniforms.weights[i][0];
+        if (w != 0.0) {
+            texcoord.z = i;
+            p += w * texelFetch(sampler1_positions, texcoord, 0);
+        }
+    }
+}
+#endif
+
+vec4 getPreviousPosition() {
+    vec4 pos = mesh_position;
+    if ((object_uniforms_flagsChannels & FILAMENT_OBJECT_MORPHING_POSITION_BIT) != 0) {
+#if defined(LEGACY_MORPHING)
+        pos += prevMorphingUniforms.weights[0] * mesh_custom0;
+        pos += prevMorphingUniforms.weights[1] * mesh_custom1;
+        pos += prevMorphingUniforms.weights[2] * mesh_custom2;
+        pos += prevMorphingUniforms.weights[3] * mesh_custom3;
+#else
+        morphPositionPrev(pos);
+#endif
+    }
+    if ((object_uniforms_flagsChannels & FILAMENT_OBJECT_SKINNING_ENABLED_BIT) != 0) {
+        skinPositionPrev(pos.xyz, mesh_bone_indices, mesh_bone_weights);
+    }
+    return pos;
+}
+#else
+vec4 getPreviousPosition() {
+    return getPosition();
+}
+#endif
+
+/**
+ * Clip-space position of this vertex on the previous frame, for motion vectors: the object's
+ * previous world transform, its previous pose (bones, morph weights) and the previous frame's
+ * (unjittered) clip <- world matrix. Returns [currentPosition] when motion vectors are off or
+ * the vertex domain carries no object motion (view, device), which yields a zero velocity.
+ */
+highp vec4 computePreviousClipPosition(const highp vec4 currentPosition) {
+    if (frameUniforms.velocityParams.x == 0.0) {
+        return currentPosition;
+    }
+#if defined(VERTEX_DOMAIN_OBJECT)
+    highp vec4 prevWorld = mulMat4x4Float3(object_uniforms_prevWorldFromModelMatrix, getPreviousPosition().xyz);
+    return frameUniforms.prevClipFromWorldMatrix * prevWorld;
+#elif defined(VERTEX_DOMAIN_WORLD)
+    return frameUniforms.prevClipFromWorldMatrix * vec4(getPreviousPosition().xyz, 1.0);
+#else
+    return currentPosition;
+#endif
+}
+#endif
+
 #if defined(HAS_ATTRIBUTE_CUSTOM0)
 vec4 getCustom0() { return mesh_custom0; }
 #endif
