+
+#ifndef TNT_FILAMENT_BACKEND_VULKANBLASDEFORMER_H
+#define TNT_FILAMENT_BACKEND_VULKANBLASDEFORMER_H
+
+#include <bluevk/BlueVK.h>
+
+#include <stdint.h>
+
+namespace filament::backend {
+
+/**
+ * The compute pipelines that pose skinned and morphed vertices for deformable bottom-level
+ * acceleration structures (VulkanBlasDeform.comp): one without and one with the morph target
+ * texture. Created on first use; the push constants carry buffer device addresses, so the only
+ * descriptor is the morph target texture of the morphing pipeline.
+ */
+class VulkanBlasDeformer {
+public:
+    // element formats the shader decodes
+    enum Format : uint32_t { FLOAT = 0, HALF = 1, UBYTE = 2, USHORT = 3 };
+    enum Flags : uint32_t { SKIN = 1, MORPH = 2 };
+
+    struct PushConstants {
+        VkDeviceAddress positions;
+        VkDeviceAddress joints;
+        VkDeviceAddress weights;
+        VkDeviceAddress bones;
+        VkDeviceAddress morphWeights;
+        VkDeviceAddress posed;
+        uint32_t vertexCount;
+        uint32_t positionStride;
+        uint32_t positionFormat;
+        uint32_t jointsStride;
+        uint32_t jointsFormat;
+        uint32_t weightsStride;
+        uint32_t weightsFormat;
+        uint32_t morphOffset;
+        uint32_t morphCount;
+        uint32_t flags;
+    };
+    static_assert(sizeof(PushConstants) <= 128, "push constants beyond the guaranteed minimum");
+
+    static constexpr uint32_t WORKGROUP_SIZE = 64;
+
+    VulkanBlasDeformer() noexcept = default;
+    VulkanBlasDeformer(VulkanBlasDeformer const&) = delete;
+    VulkanBlasDeformer& operator=(VulkanBlasDeformer const&) = delete;
+
+    // Creates the pipelines on first use; false when that failed.
+    bool initialize(VkDevice device) noexcept;
+    void terminate() noexcept;
+
+    VkPipeline getPipeline(bool morph) const noexcept { return morph ? mMorphPipeline : mSkinPipeline; }
+    VkPipelineLayout getLayout(bool morph) const noexcept { return morph ? mMorphLayout : mSkinLayout; }
+    VkDescriptorSetLayout getMorphSetLayout() const noexcept { return mMorphSetLayout; }
+    VkSampler getSampler() const noexcept { return mSampler; }
+
+private:
+    VkDevice mDevice = VK_NULL_HANDLE;
+    bool mFailed = false;
+    VkDescriptorSetLayout mMorphSetLayout = VK_NULL_HANDLE;
+    VkSampler mSampler = VK_NULL_HANDLE;
+    VkPipelineLayout mSkinLayout = VK_NULL_HANDLE;
+    VkPipelineLayout mMorphLayout = VK_NULL_HANDLE;
+    VkPipeline mSkinPipeline = VK_NULL_HANDLE;
+    VkPipeline mMorphPipeline = VK_NULL_HANDLE;
+};
+
+} // namespace filament::backend
+
+#endif // TNT_FILAMENT_BACKEND_VULKANBLASDEFORMER_H
