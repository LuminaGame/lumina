+struct AccelerationStructureDeformation {
+    Handle<HwBufferObject> joints;          //!< bone indices (UBYTE4 or USHORT4); null: no skinning
+    uint32_t jointsOffset = 0;
+    uint32_t jointsStride = 0;
+    ElementType jointsType = ElementType::USHORT4;
+    Handle<HwBufferObject> weights;         //!< bone weights (FLOAT4, or normalized UBYTE4/USHORT4)
+    uint32_t weightsOffset = 0;
+    uint32_t weightsStride = 0;
+    ElementType weightsType = ElementType::FLOAT4;
+    Handle<HwBufferObject> bones;           //!< the bone palette (PerRenderableBoneUib::BoneData)
+    uint32_t bonesOffset = 0;               //!< byte offset of the renderable's first bone
+    Handle<HwTexture> morphPositions;       //!< morph target position deltas; null: no morphing
+    uint32_t morphOffset = 0;               //!< the primitive's first texel in morphPositions
+    uint32_t morphCount = 0;                //!< morph targets
+    Handle<HwBufferObject> morphWeights;    //!< one float4 per morph target, weight in x
+    AccelerationStructureBuildMode mode = AccelerationStructureBuildMode::BUILD;
 };
 
