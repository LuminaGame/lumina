+
+bool VulkanAccelerationStructure::deform(VulkanCommandBuffer& commands,
+        VulkanBlasDeformer& deformer, DeformInputs const& in) {
+    Impl& impl = *mImpl;
+    AccelerationStructureDeformation const& d = in.desc;
+    if (!impl.deformable || !impl.vertexBuffer || impl.vertexCount == 0) {
+        return false;
+    }
+    VulkanBlasDeformer::PushConstants pc{};
+    if (!positionFormat(impl.vertexFormat, pc.positionFormat) ||
+            (impl.vertexOffset | impl.vertexStride) % 4u != 0) {
+        return false;
+    }
+    bool const skin = in.joints && in.weights && in.bones &&
+            jointsFormat(d.jointsType, pc.jointsFormat) &&
+            weightsFormat(d.weightsType, pc.weightsFormat) &&
+            (d.jointsOffset | d.jointsStride | d.weightsOffset | d.weightsStride) % 4u == 0 &&
+            d.bonesOffset % 16u == 0;
+    bool const morph = in.morphPositions && in.morphWeights && d.morphCount > 0;
+    VkDevice const dev = impl.device;
+    if (!deformer.initialize(dev)) {
+        return false;
+    }
+
+    pc.positions = bufferAddress(dev, impl.vertexBuffer->getVkBuffer()) + impl.vertexOffset;
+    pc.positionStride = impl.vertexStride;
+    pc.vertexCount = impl.vertexCount;
+    pc.posed = impl.posed.address;
+    if (skin) {
+        pc.joints = bufferAddress(dev, in.joints->getVkBuffer()) + d.jointsOffset;
+        pc.jointsStride = d.jointsStride;
+        pc.weights = bufferAddress(dev, in.weights->getVkBuffer()) + d.weightsOffset;
+        pc.weightsStride = d.weightsStride;
+        pc.bones = bufferAddress(dev, in.bones->getVkBuffer()) + d.bonesOffset;
+        pc.flags |= VulkanBlasDeformer::SKIN;
+    }
+    if (morph) {
+        if (impl.morphPool == VK_NULL_HANDLE) {
+            VkDescriptorPoolSize const size = {
+                .type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                .descriptorCount = 1,
+            };
+            VkDescriptorPoolCreateInfo const poolInfo = {
+                .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                .maxSets = 1,
+                .poolSizeCount = 1,
+                .pPoolSizes = &size,
+            };
+            if (vkCreateDescriptorPool(dev, &poolInfo, VKALLOC, &impl.morphPool) != VK_SUCCESS) {
+                impl.morphPool = VK_NULL_HANDLE;
+                return false;
+            }
+            VkDescriptorSetLayout const layout = deformer.getMorphSetLayout();
+            VkDescriptorSetAllocateInfo const allocInfo = {
+                .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                .descriptorPool = impl.morphPool,
+                .descriptorSetCount = 1,
+                .pSetLayouts = &layout,
+            };
+            if (vkAllocateDescriptorSets(dev, &allocInfo, &impl.morphSet) != VK_SUCCESS) {
+                vkDestroyDescriptorPool(dev, impl.morphPool, VKALLOC);
+                impl.morphPool = VK_NULL_HANDLE;
+                impl.morphSet = VK_NULL_HANDLE;
+                return false;
+            }
+        }
+        VulkanTexture& texture = *in.morphPositions.get();
+        VkImageView const view = texture.getView(texture.getPrimaryViewRange());
+        if (view != impl.morphView) {
+            // A renderable's morph target texture is set once; rewriting the set while an earlier
+            // frame still reads it would need a second set, so a change is only taken here.
+            VkDescriptorImageInfo const info = {
+                .sampler = deformer.getSampler(),
+                .imageView = view,
+                .imageLayout = fvkutils::getVkLayout(texture.getSamplerLayout()),
+            };
+            VkWriteDescriptorSet const write = {
+                .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+                .dstSet = impl.morphSet,
+                .dstBinding = 0,
+                .descriptorCount = 1,
+                .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                .pImageInfo = &info,
+            };
+            vkUpdateDescriptorSets(dev, 1, &write, 0, nullptr);
+            impl.morphView = view;
+            impl.morphTexture = in.morphPositions;
+        }
+        pc.morphWeights = bufferAddress(dev, in.morphWeights->getVkBuffer());
+        pc.morphOffset = d.morphOffset;
+        pc.morphCount = d.morphCount;
+        pc.flags |= VulkanBlasDeformer::MORPH;
+    }
+
+    commands.acquire(impl.vertexBuffer);
+    if (skin) {
+        commands.acquire(in.joints);
+        commands.acquire(in.weights);
+        commands.acquire(in.bones);
+    }
+    if (morph) {
+        commands.acquire(in.morphWeights);
+        commands.acquire(in.morphPositions);
+    }
+
+    VkCommandBuffer const cmd = commands.buffer();
+    // The bone palette, the morph weights and the geometry uploads must be complete, and the
+    // previous build must be done reading the posed positions.
+    VkMemoryBarrier const before = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_HOST_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+    };
+    vkCmdPipelineBarrier(cmd,
+            VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_HOST_BIT |
+                    VK_PIPELINE_STAGE_ACCELERATION_STRUCTURE_BUILD_BIT_KHR,
+            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &before, 0, nullptr, 0, nullptr);
+
+    vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, deformer.getPipeline(morph));
+    if (morph) {
+        vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, deformer.getLayout(true), 0,
+                1, &impl.morphSet, 0, nullptr);
+    }
+    vkCmdPushConstants(cmd, deformer.getLayout(morph), VK_SHADER_STAGE_COMPUTE_BIT, 0,
+            sizeof(pc), &pc);
+    vkCmdDispatch(cmd, (impl.vertexCount + VulkanBlasDeformer::WORKGROUP_SIZE - 1) /
+            VulkanBlasDeformer::WORKGROUP_SIZE, 1, 1);
+
+    // The posed positions feed the build; later uploads of the inputs wait for the reads.
+    VkMemoryBarrier const after = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_ACCELERATION_STRUCTURE_READ_BIT_KHR,
+    };
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+            VK_PIPELINE_STAGE_ACCELERATION_STRUCTURE_BUILD_BIT_KHR | VK_PIPELINE_STAGE_TRANSFER_BIT,
+            0, 1, &after, 0, nullptr, 0, nullptr);
+
+    build(commands, d.mode);
+    return true;
+}
+
 void VulkanAccelerationStructure::setInstances(AccelerationStructureInstance const* instances,
         uint32_t count, BlasResolver const& resolve) {
     Impl& impl = *mImpl;
