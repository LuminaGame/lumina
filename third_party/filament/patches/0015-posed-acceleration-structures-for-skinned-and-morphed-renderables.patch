+    uint o = v * params.weightsStride;
+    if (params.weightsFormat == FORMAT_UBYTE) {
+        uint w = wordAt(params.weights, o);
+        return vec4(w & 0xFFu, (w >> 8u) & 0xFFu, (w >> 16u) & 0xFFu, w >> 24u) / 255.0;
+    }
+    if (params.weightsFormat == FORMAT_USHORT) {
+        uint a = wordAt(params.weights, o);
+        uint b = wordAt(params.weights, o + 4u);
+        return vec4(a & 0xFFFFu, a >> 16u, b & 0xFFFFu, b >> 16u) / 65535.0;
+    }
