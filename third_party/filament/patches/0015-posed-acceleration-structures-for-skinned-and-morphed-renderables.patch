+// the element formats the deformation shader decodes; false for the others
+bool positionFormat(ElementType const type, uint32_t& out) {
+    switch (type) {
+        case ElementType::FLOAT3:
+        case ElementType::FLOAT4: out = VulkanBlasDeformer::FLOAT; return true;
+        case ElementType::HALF3:
+        case ElementType::HALF4: out = VulkanBlasDeformer::HALF; return true;
+        default: return false;
+    }
+}
+
+bool jointsFormat(ElementType const type, uint32_t& out) {
+    switch (type) {
+        case ElementType::UBYTE4: out = VulkanBlasDeformer::UBYTE; return true;
+        case ElementType::USHORT4: out = VulkanBlasDeformer::USHORT; return true;
+        default: return false;
+    }
+}
+
+bool weightsFormat(ElementType const type, uint32_t& out) {
+    switch (type) {
+        case ElementType::FLOAT4: out = VulkanBlasDeformer::FLOAT; return true;
+        case ElementType::UBYTE4: out = VulkanBlasDeformer::UBYTE; return true;
+        case ElementType::USHORT4: out = VulkanBlasDeformer::USHORT; return true;
+        default: return false;
+    }
+}
