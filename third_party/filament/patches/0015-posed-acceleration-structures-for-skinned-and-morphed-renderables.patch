     // Allow the stage pool to clean up.
@@ -856,6 +857,38 @@ void VulkanDriver::buildAccelerationStructure(Handle<HwAccelerationStructure> as
     as->build(commands, mode);
 }
 
+void VulkanDriver::deformAccelerationStructure(Handle<HwAccelerationStructure> ash,
+        AccelerationStructureDeformation deformation) {
+    FVK_SYSTRACE_SCOPE();
+    if (!ash || !mContext.isRayQuerySupported()) {
+        return;
+    }
+    FILAMENT_CHECK_PRECONDITION(!mCurrentRenderPass.renderPass)
+            << "deformAccelerationStructure() cannot be invoked inside a render pass.";
+    auto as = resource_ptr<VulkanAccelerationStructure>::cast(&mResourceManager, ash);
+    VulkanAccelerationStructure::DeformInputs inputs{ .desc = deformation };
+    auto buffer = [this](Handle<HwBufferObject> const h) {
+        return h ? resource_ptr<VulkanBufferObject>::cast(&mResourceManager, h)
+                 : resource_ptr<VulkanBufferObject>{};
+    };
+    inputs.joints = buffer(deformation.joints);
+    inputs.weights = buffer(deformation.weights);
+    inputs.bones = buffer(deformation.bones);
+    inputs.morphWeights = buffer(deformation.morphWeights);
+    if (deformation.morphPositions) {
+        inputs.morphPositions =
+                resource_ptr<VulkanTexture>::cast(&mResourceManager, deformation.morphPositions);
+    }
+    VulkanCommandBuffer& commands = mCommands.get();
+    commands.acquire(as);
+    if (!as->deform(commands, mBlasDeformer, inputs)) {
+        // poses it cannot compute keep the rest positions: build from them once
+        if (!as->isBuilt()) {
+            as->build(commands, AccelerationStructureBuildMode::BUILD);
+        }
+    }
+}
