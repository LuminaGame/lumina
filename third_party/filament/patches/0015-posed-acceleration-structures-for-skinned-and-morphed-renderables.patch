+
+#include "VulkanBlasDeformer.h"
+
+#include "VulkanBlasDeformSpirv.h"
+#include "VulkanConstants.h"
+
+#include <utils/Logger.h>
+
+using namespace bluevk;
+
+namespace filament::backend {
+
+namespace {
+
+VkPipeline createPipeline(VkDevice device, VkPipelineLayout layout, uint32_t const* code,
+        size_t bytes) {
+    VkShaderModuleCreateInfo const moduleInfo = {
+        .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+        .codeSize = bytes,
+        .pCode = code,
+    };
+    VkShaderModule module = VK_NULL_HANDLE;
+    if (vkCreateShaderModule(device, &moduleInfo, VKALLOC, &module) != VK_SUCCESS) {
+        return VK_NULL_HANDLE;
+    }
+    VkComputePipelineCreateInfo const pipelineInfo = {
+        .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+        .stage = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+            .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+            .module = module,
+            .pName = "main",
+        },
+        .layout = layout,
+    };
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    VkResult const result = vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &pipelineInfo,
+            VKALLOC, &pipeline);
+    vkDestroyShaderModule(device, module, VKALLOC);
+    return result == VK_SUCCESS ? pipeline : VK_NULL_HANDLE;
+}
+
+} // namespace
+
+bool VulkanBlasDeformer::initialize(VkDevice const device) noexcept {
+    if (mSkinPipeline != VK_NULL_HANDLE) {
+        return true;
+    }
+    if (mFailed) {
+        return false;
+    }
+    mDevice = device;
+
+    VkDescriptorSetLayoutBinding const binding = {
+        .binding = 0,
+        .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+        .descriptorCount = 1,
+        .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+    };
+    VkDescriptorSetLayoutCreateInfo const setInfo = {
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+        .bindingCount = 1,
+        .pBindings = &binding,
+    };
+    VkSamplerCreateInfo const samplerInfo = {
+        .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+        .magFilter = VK_FILTER_NEAREST,
+        .minFilter = VK_FILTER_NEAREST,
+        .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+        .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .maxLod = 0.0f,
+    };
+    VkPushConstantRange const range = {
+        .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+        .offset = 0,
+        .size = sizeof(PushConstants),
+    };
+    VkPipelineLayoutCreateInfo skinLayoutInfo = {
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+        .setLayoutCount = 0,
+        .pushConstantRangeCount = 1,
+        .pPushConstantRanges = &range,
+    };
+    bool ok = vkCreateDescriptorSetLayout(device, &setInfo, VKALLOC, &mMorphSetLayout) == VK_SUCCESS &&
+              vkCreateSampler(device, &samplerInfo, VKALLOC, &mSampler) == VK_SUCCESS &&
+              vkCreatePipelineLayout(device, &skinLayoutInfo, VKALLOC, &mSkinLayout) == VK_SUCCESS;
+    if (ok) {
+        VkPipelineLayoutCreateInfo morphLayoutInfo = skinLayoutInfo;
+        morphLayoutInfo.setLayoutCount = 1;
+        morphLayoutInfo.pSetLayouts = &mMorphSetLayout;
+        ok = vkCreatePipelineLayout(device, &morphLayoutInfo, VKALLOC, &mMorphLayout) == VK_SUCCESS;
+    }
+    if (ok) {
+        mSkinPipeline = createPipeline(device, mSkinLayout, BLAS_DEFORM_SKIN_SPV,
+                sizeof(BLAS_DEFORM_SKIN_SPV));
+        mMorphPipeline = createPipeline(device, mMorphLayout, BLAS_DEFORM_MORPH_SPV,
+                sizeof(BLAS_DEFORM_MORPH_SPV));
+        ok = mSkinPipeline != VK_NULL_HANDLE && mMorphPipeline != VK_NULL_HANDLE;
+    }
+    if (!ok) {
+        FVK_LOGE << "ray tracing: the skinning/morphing compute pipelines could not be created; "
+                      "deformable acceleration structures keep their bind pose";
+        terminate();
+        mFailed = true;
+        return false;
+    }
+    return true;
+}
+
+void VulkanBlasDeformer::terminate() noexcept {
+    if (mDevice == VK_NULL_HANDLE) {
+        return;
+    }
+    if (mSkinPipeline) vkDestroyPipeline(mDevice, mSkinPipeline, VKALLOC);
+    if (mMorphPipeline) vkDestroyPipeline(mDevice, mMorphPipeline, VKALLOC);
+    if (mSkinLayout) vkDestroyPipelineLayout(mDevice, mSkinLayout, VKALLOC);
+    if (mMorphLayout) vkDestroyPipelineLayout(mDevice, mMorphLayout, VKALLOC);
+    if (mSampler) vkDestroySampler(mDevice, mSampler, VKALLOC);
+    if (mMorphSetLayout) vkDestroyDescriptorSetLayout(mDevice, mMorphSetLayout, VKALLOC);
+    mSkinPipeline = mMorphPipeline = VK_NULL_HANDLE;
+    mSkinLayout = mMorphLayout = VK_NULL_HANDLE;
+    mSampler = VK_NULL_HANDLE;
+    mMorphSetLayout = VK_NULL_HANDLE;
+}
+
+} // namespace filament::backend
