diff --git a/filament/backend/src/vulkan/VulkanBlasDeform.comp b/filament/backend/src/vulkan/VulkanBlasDeform.comp
new file mode 100644
index 00000000..ecbe6102
--- /dev/null
+++ b/filament/backend/src/vulkan/VulkanBlasDeform.comp
@@ -0,0 +1,151 @@
+#version 460
+// Poses the vertices of a skinned and/or morphed primitive for its bottom-level acceleration
+// structure: the same morphing (position deltas from the morph target texture, weighted by the
+// renderable's morph weights) and four-bone linear blend skinning (the renderable's bone palette)
+// as Filament's vertex shaders (shaders/src/surface_getters.vs), written as tightly packed
+// float3 positions the acceleration structure is built from.
+//
+// Regenerate VulkanBlasDeformSpirv.h after changing this file:
+//   glslangValidator -V --target-env vulkan1.1 --vn BLAS_DEFORM_SKIN_SPV -o skin.h VulkanBlasDeform.comp
+//   glslangValidator -V --target-env vulkan1.1 -DMORPH --vn BLAS_DEFORM_MORPH_SPV -o morph.h VulkanBlasDeform.comp
+// (see the header for the exact command the patch used).
+
+#extension GL_EXT_buffer_reference : require
+
+layout(local_size_x = 64) in;
+
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words {
+    uint w[];
+};
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Positions {
+    float f[];
+};
+layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Vec4s {
+    vec4 v[];
+};
+
+#ifdef MORPH
+layout(set = 0, binding = 0) uniform highp sampler2DArray morphPositions;
+#endif
+
+// element formats (VulkanBlasDeformer::Format)
+const uint FORMAT_FLOAT = 0u;   // 32-bit float components
+const uint FORMAT_HALF = 1u;    // 16-bit float components
