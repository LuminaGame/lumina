@@ -38,6 +43,36 @@ struct AccelerationStructureGeometry {
     Handle<HwIndexBuffer> indexBuffer;      //!< null for non-indexed geometry
     uint32_t indexOffset = 0;               //!< first index (in indices, not bytes)
     uint32_t indexCount = 0;                //!< indices of the primitive (a multiple of 3)
