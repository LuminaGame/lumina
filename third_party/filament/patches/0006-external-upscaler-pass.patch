+bool PostProcessManager::useExternalUpscaler(DynamicResolutionOptions const& dsrOptions,
+        ExternalUpscaleInputs const& external, filament::Viewport const& vp,
+        FrameGraphTexture::Descriptor const& outDesc) noexcept {
+    if (dsrOptions.upscaler != Upscaler::EXTERNAL || !external.upscaler) {
+        return false;
+    }
+    if (!external.depth || !external.velocity) {
+        return false;
+    }
+    return external.upscaler->supports(vp.width, vp.height, outDesc.width, outDesc.height);
+}
+
+FrameGraphId<FrameGraphTexture> PostProcessManager::upscaleExternal(FrameGraph& fg,
+        ExternalUpscaleInputs const& external, FrameGraphId<FrameGraphTexture> const input,
+        filament::Viewport const& vp, FrameGraphTexture::Descriptor const& outDesc) noexcept {
+
+    struct ExternalData {
+        FrameGraphId<FrameGraphTexture> color;
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> velocity;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+
+    auto const& pass = fg.addPass<ExternalData>("external upscaling",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.color = builder.read(input, FrameGraphTexture::Usage::SAMPLEABLE);
+                data.depth = builder.read(external.depth, FrameGraphTexture::Usage::SAMPLEABLE);
+                data.velocity = builder.read(external.velocity, FrameGraphTexture::Usage::SAMPLEABLE);
+                auto desc = outDesc;
+                desc.samples = 1;
+                data.output = builder.createTexture("external upscaled output", desc);
+                data.output = builder.write(data.output,
+                        FrameGraphTexture::Usage::STORAGE | FrameGraphTexture::Usage::SAMPLEABLE |
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT | FrameGraphTexture::Usage::BLIT_SRC);
+                // A write-only texture is never materialized by the frame graph; declaring it as
+                // this pass's render target (never begun) gives it the reference the other
+                // upscalers get from their blit, so it is allocated before the callback runs.
+                builder.declareRenderPass(builder.getName(data.output), {
+                        .attachments = { .color = { data.output } } });
+                // the output is produced outside the frame graph's knowledge
+                builder.sideEffect();
+            },
+            [external, vp, outDesc](FrameGraphResources const& resources,
+                    auto const& data, DriverApi& driver) {
+                ExternalPassDescriptor descriptor{};
+                descriptor.callback = [](ExternalPassContext const& context) {
+                    static_cast<ExternalUpscaler*>(context.user)->evaluate(context);
+                };
+                descriptor.user = external.upscaler;
+                descriptor.textureCount = 4;
+                descriptor.textures[ExternalUpscaler::COLOR] = resources.getTexture(data.color);
+                descriptor.textures[ExternalUpscaler::DEPTH] = resources.getTexture(data.depth);
+                descriptor.textures[ExternalUpscaler::VELOCITY] = resources.getTexture(data.velocity);
+                descriptor.textures[ExternalUpscaler::OUTPUT] = resources.getTexture(data.output);
+                descriptor.writeMask = 1u << ExternalUpscaler::OUTPUT;
+                descriptor.frame.jitter[0] = external.jitter.x;
+                descriptor.frame.jitter[1] = external.jitter.y;
+                descriptor.frame.renderWidth = vp.width;
+                descriptor.frame.renderHeight = vp.height;
+                descriptor.frame.outputWidth = outDesc.width;
+                descriptor.frame.outputHeight = outDesc.height;
+                descriptor.frame.frameId = external.frameId;
+                driver.externalPass(descriptor);
+            });
+
+    return pass->output;
+}
