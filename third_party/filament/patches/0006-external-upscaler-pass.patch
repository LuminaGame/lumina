+#ifndef TNT_FILAMENT_BACKEND_EXTERNALPASS_H
+#define TNT_FILAMENT_BACKEND_EXTERNALPASS_H
+
+#include <backend/DriverEnums.h>
+#include <backend/Handle.h>
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace filament::backend {
+
+/**
+ * One texture handed to an external pass: the backend's native image objects, so that a
+ * library outside Filament (an upscaler, a denoiser) can read or write it. All handles are
+ * the backend's own types cast to 64 bits (Vulkan: VkImage, VkImageView, VkFormat,
+ * VkImageLayout). The image is in a general-purpose layout for the duration of the pass.
+ */
+struct ExternalPassImage {
+    uint64_t image = 0;
+    uint64_t imageView = 0;
+    uint32_t format = 0;
+    uint32_t layout = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t aspect = 0;        // the image aspect the view selects (color or depth)
+};
+
+/**
+ * Per-pass parameters the client passes through the command stream unchanged.
+ */
+struct ExternalPassFrame {
+    float jitter[2] = { 0.0f, 0.0f };   // see ExternalUpscaler::evaluate()
+    uint32_t renderWidth = 0;
+    uint32_t renderHeight = 0;
+    uint32_t outputWidth = 0;
+    uint32_t outputHeight = 0;
+    uint32_t flags = 0;
+    uint32_t frameId = 0;
+};
+
+/**
+ * Everything an external pass callback receives: the backend's device objects, the command
+ * buffer that is currently recording (commands recorded into it execute in order with
+ * Filament's own) and the requested images.
+ */
+struct ExternalPassContext {
+    static constexpr size_t MAX_IMAGES = 4;
+    Backend backend = Backend::NOOP;
+    uint64_t instance = 0;          // VkInstance
+    uint64_t physicalDevice = 0;    // VkPhysicalDevice
+    uint64_t device = 0;            // VkDevice
+    uint64_t commandBuffer = 0;     // VkCommandBuffer, recording
+    uint32_t imageCount = 0;
+    ExternalPassImage images[MAX_IMAGES];
+    ExternalPassFrame frame;
+    void* user = nullptr;
+};
+
+/**
+ * The callback runs on the backend thread while the command stream executes; it must only
+ * record into the given command buffer and never submit, wait or create Filament objects.
+ */
+using ExternalPassCallback = void (*)(ExternalPassContext const& context);
+
+/**
+ * Describes an external pass: which textures to expose, which of them the pass writes, the
+ * callback and its user pointer.
+ */
+struct ExternalPassDescriptor {
+    ExternalPassCallback callback = nullptr;
+    void* user = nullptr;
+    uint32_t textureCount = 0;
+    Handle<HwTexture> textures[ExternalPassContext::MAX_IMAGES];
+    uint32_t writeMask = 0;         // bit i set when textures[i] is written by the pass
+    ExternalPassFrame frame;
+};
+
+} // namespace filament::backend
+
+#endif // TNT_FILAMENT_BACKEND_EXTERNALPASS_H
