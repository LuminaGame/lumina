+void VulkanDriver::externalPass(ExternalPassDescriptor descriptor) {
+    FVK_SYSTRACE_SCOPE();
+
+    FILAMENT_CHECK_PRECONDITION(!mCurrentRenderPass.renderPass)
+            << "externalPass() cannot be invoked inside a render pass.";
+    if (UTILS_UNLIKELY(!descriptor.callback)) {
+        return;
+    }
+
+    VulkanCommandBuffer& commands = mCommands.get();
+
+    ExternalPassContext context{};
+    context.backend = Backend::VULKAN;
+    context.instance = reinterpret_cast<uint64_t>(mPlatform->getInstance());
+    context.physicalDevice = reinterpret_cast<uint64_t>(mPlatform->getPhysicalDevice());
+    context.device = reinterpret_cast<uint64_t>(mPlatform->getDevice());
+    context.commandBuffer = reinterpret_cast<uint64_t>(commands.buffer());
+    context.frame = descriptor.frame;
+    context.user = descriptor.user;
+
+    uint32_t const count = std::min(descriptor.textureCount,
+            uint32_t(ExternalPassContext::MAX_IMAGES));
+    for (uint32_t i = 0; i < count; i++) {
+        if (!descriptor.textures[i]) {
+            continue;
+        }
+        auto texture = resource_ptr<VulkanTexture>::cast(&mResourceManager, descriptor.textures[i]);
+        commands.acquire(texture);
+        VkImageSubresourceRange const range = texture->getPrimaryViewRange();
+        // A general layout is readable and writable by any stage; the layout tracking keeps
+        // it so the next pass transitions from the right state.
+        texture->transitionLayout(&commands, range, VulkanLayout::STAGING);
+        ExternalPassImage& image = context.images[i];
+        image.image = reinterpret_cast<uint64_t>(texture->getVkImage());
+        // a plain 2D view (no swizzle): usable as a storage image and a sampled image
+        image.imageView = reinterpret_cast<uint64_t>(
+                texture->getAttachmentView(range, VK_IMAGE_VIEW_TYPE_2D));
+        image.format = uint32_t(texture->getVkFormat());
+        image.layout = uint32_t(fvkutils::getVkLayout(VulkanLayout::STAGING));
+        image.width = texture->width;
+        image.height = texture->height;
+        image.aspect = uint32_t(range.aspectMask);
+    }
+    context.imageCount = count;
+
+    descriptor.callback(context);
+
+    // Whatever the pass recorded must be visible to the shaders and transfers that follow.
+    VkMemoryBarrier const barrier = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT |
+                VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+    };
+    vkCmdPipelineBarrier(commands.buffer(),
+            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+            VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+}
