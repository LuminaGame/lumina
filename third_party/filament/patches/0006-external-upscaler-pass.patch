+/**
+ * An upscaler implemented outside Filament (DLSS for instance), driven by
+ * DynamicResolutionOptions::upscaler == Upscaler::EXTERNAL. Filament renders the frame at
+ * the dynamic resolution, jitters the camera as TAA does when TemporalAntiAliasingOptions is
+ * enabled (the TAA resolve itself is skipped, the upscaler owns the temporal accumulation),
+ * then hands the low-resolution colour, depth and motion vectors and the full-resolution
+ * output to evaluate() through an external pass.
+ *
+ * @see View::setExternalUpscaler
+ */
+class UTILS_PUBLIC ExternalUpscaler {
+public:
+    /** Indices of the images evaluate() receives in ExternalPassContext::images. */
+    enum Image : uint32_t {
+        COLOR = 0,      //!< the frame at the render resolution, after colour grading (LDR)
+        DEPTH = 1,      //!< the colour pass depth at the render resolution
+        VELOCITY = 2,   //!< motion vectors (RG16F, texels of uv_curr - uv_prev, y up)
+        OUTPUT = 3,     //!< the storage image to write, at the output resolution
+    };
+
+    /**
+     * Called on the main thread while the frame is set up. Return false to let Filament use
+     * its FSR1 path for this frame (the resolution is not supported, the runtime failed, ...).
+     */
+    virtual bool supports(uint32_t renderWidth, uint32_t renderHeight,
+            uint32_t outputWidth, uint32_t outputHeight) noexcept = 0;
+
+    /**
+     * Called on the backend thread while the frame's command buffer records. The context
+     * carries the four images (Image) and, in frame.jitter, the sub-pixel sample offset of
+     * this frame in texels of the render target, in the same orientation as the images and
+     * the motion vectors (x right, y up): the projection was translated by -jitter. Record
+     * into context.commandBuffer only; never submit or wait.
+     */
+    virtual void evaluate(backend::ExternalPassContext const& context) noexcept = 0;
+
+protected:
+    ~ExternalUpscaler() = default;
+};
