+        auto as = resource_ptr<VulkanAccelerationStructure>::cast(&mResourceManager, tlas);
+        auto const* records = static_cast<AccelerationStructureInstance const*>(instances.buffer);
+        uint32_t const count = uint32_t(instances.size / sizeof(AccelerationStructureInstance));
