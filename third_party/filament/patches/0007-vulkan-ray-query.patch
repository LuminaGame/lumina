+
+#include "VulkanAccelerationStructure.h"
+
+#include "VulkanCommands.h"
+#include "VulkanContext.h"
+#include "VulkanHandles.h"
+#include "VulkanMemory.h"
+
+#include <utils/Logger.h>
+#include <utils/Panic.h>
+
+#include <algorithm>
+#include <cstring>
+#include <vector>
+
+using namespace bluevk;
+
+namespace filament::backend {
+
+namespace {
+
+VkDeviceAddress bufferAddress(VkDevice device, VkBuffer buffer) {
+    VkBufferDeviceAddressInfo const info = {
+        .sType = VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO,
+        .buffer = buffer,
+    };
+    // the KHR entry point: Filament creates a Vulkan 1.1 device, where the core 1.2 one is absent
+    return vkGetBufferDeviceAddressKHR(device, &info);
+}
+
+VkFormat vertexFormat(ElementType const type) {
+    switch (type) {
+        case ElementType::FLOAT3:
+        case ElementType::FLOAT4:
+            return VK_FORMAT_R32G32B32_SFLOAT;
+        case ElementType::HALF3:
+        case ElementType::HALF4:
+            return VK_FORMAT_R16G16B16A16_SFLOAT;
+        case ElementType::SHORT3:
+        case ElementType::SHORT4:
+            return VK_FORMAT_R16G16B16A16_SNORM;
+        default:
+            return VK_FORMAT_R32G32B32_SFLOAT;
+    }
+}
+
+VkDeviceSize alignUp(VkDeviceSize const value, VkDeviceSize const alignment) {
+    return (value + alignment - 1) / alignment * alignment;
+}
+
+} // namespace
+
+struct VulkanAccelerationStructure::Impl {
+    struct Buffer {
+        VkBuffer buffer = VK_NULL_HANDLE;
+        VmaAllocation allocation = VK_NULL_HANDLE;
+        VkDeviceAddress address = 0;
+        void* mapped = nullptr;
+        VkDeviceSize size = 0;
+    };
+
+    Impl(VmaAllocator allocator, VkDevice device, bool topLevel, uint32_t scratchAlignment)
+            : allocator(allocator), device(device), isTopLevel(topLevel),
+              scratchAlignment(std::max(1u, scratchAlignment)) {}
+
+    ~Impl() {
+        if (handle != VK_NULL_HANDLE) {
+            vkDestroyAccelerationStructureKHR(device, handle, VKALLOC);
+        }
+        destroyBuffer(storage);
+        destroyBuffer(scratch);
+        destroyBuffer(instances);
+    }
+
+    void createBuffer(Buffer& out, VkDeviceSize size, VkBufferUsageFlags usage, bool hostVisible) {
+        VkBufferCreateInfo const bufferInfo = {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+            .size = std::max<VkDeviceSize>(size, 16),
+            .usage = usage,
+        };
+        VmaAllocationCreateInfo allocInfo = {
+            .usage = VMA_MEMORY_USAGE_AUTO,
+        };
+        if (hostVisible) {
+            allocInfo.flags = VMA_ALLOCATION_CREATE_MAPPED_BIT |
+                    VMA_ALLOCATION_CREATE_HOST_ACCESS_SEQUENTIAL_WRITE_BIT;
+        } else {
+            allocInfo.requiredFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+        }
+        VmaAllocationInfo info{};
+        VkResult const result = vmaCreateBuffer(allocator, &bufferInfo, &allocInfo, &out.buffer,
+                &out.allocation, &info);
+        FILAMENT_CHECK_POSTCONDITION(result == VK_SUCCESS)
+                << "acceleration structure buffer allocation failed, error=" << int32_t(result);
+        out.size = bufferInfo.size;
+        out.mapped = hostVisible ? info.pMappedData : nullptr;
+        out.address = bufferAddress(device, out.buffer);
+    }
+
+    void destroyBuffer(Buffer& buffer) {
+        if (buffer.buffer != VK_NULL_HANDLE) {
+            vmaDestroyBuffer(allocator, buffer.buffer, buffer.allocation);
+            buffer = {};
+        }
+    }
+
+    void createStructure(VkAccelerationStructureTypeKHR type, VkDeviceSize size) {
+        createBuffer(storage, size,
+                VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE_BIT_KHR |
+                        VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT, false);
+        VkAccelerationStructureCreateInfoKHR const createInfo = {
+            .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_KHR,
+            .buffer = storage.buffer,
+            .offset = 0,
+            .size = storage.size,
+            .type = type,
+        };
+        VkResult const result = vkCreateAccelerationStructureKHR(device, &createInfo, VKALLOC, &handle);
+        FILAMENT_CHECK_POSTCONDITION(result == VK_SUCCESS)
+                << "vkCreateAccelerationStructureKHR failed, error=" << int32_t(result);
+        VkAccelerationStructureDeviceAddressInfoKHR const addressInfo = {
+            .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_DEVICE_ADDRESS_INFO_KHR,
+            .accelerationStructure = handle,
+        };
+        deviceAddress = vkGetAccelerationStructureDeviceAddressKHR(device, &addressInfo);
+    }
+
+    VkAccelerationStructureBuildGeometryInfoKHR buildInfo(bool refit) const {
+        return {
+            .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR,
+            .type = isTopLevel ? VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR
+                               : VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR,
+            .flags = VkBuildAccelerationStructureFlagsKHR(
+                    (isTopLevel ? VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT_KHR
+                                : VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT_KHR) |
+                    VK_BUILD_ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT_KHR),
+            .mode = refit ? VK_BUILD_ACCELERATION_STRUCTURE_MODE_UPDATE_KHR
+                          : VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR,
+            .srcAccelerationStructure = refit ? handle : VK_NULL_HANDLE,
+            .dstAccelerationStructure = handle,
+            .geometryCount = 1,
+            .pGeometries = &geometry,
+            .scratchData = { .deviceAddress = alignUp(scratch.address, scratchAlignment) },
+        };
+    }
+
+    void allocateForBuild(uint32_t maxPrimitives) {
+        VkAccelerationStructureBuildGeometryInfoKHR const info = buildInfo(false);
+        VkAccelerationStructureBuildSizesInfoKHR sizes = {
+            .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR,
+        };
+        vkGetAccelerationStructureBuildSizesKHR(device,
+                VK_ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR, &info, &maxPrimitives, &sizes);
+        createStructure(info.type, sizes.accelerationStructureSize);
+        createBuffer(scratch,
+                alignUp(std::max(sizes.buildScratchSize, sizes.updateScratchSize), scratchAlignment) +
+                        scratchAlignment,
+                VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT, false);
+    }
+
+    VmaAllocator const allocator;
+    VkDevice const device;
+    bool const isTopLevel;
+    uint32_t const scratchAlignment;
+    bool built = false;
+    VkDeviceAddress deviceAddress = 0;
+    VkAccelerationStructureKHR handle = VK_NULL_HANDLE;
+    Buffer storage;
+    Buffer scratch;
+    Buffer instances;               // top level only
+    uint32_t instanceCapacity = 0;  // top level only
+    uint32_t instanceCount = 0;     // top level only
+    uint32_t primitiveCount = 0;    // bottom level only
+    VkAccelerationStructureGeometryKHR geometry{};
+    // the inputs this structure reads, kept alive with it
+    fvkmemory::resource_ptr<VulkanBufferObject> vertexBuffer;
+    fvkmemory::resource_ptr<VulkanIndexBuffer> indexBuffer;
+    std::vector<fvkmemory::resource_ptr<VulkanAccelerationStructure>> referencedBlas;
+};
+
+VulkanAccelerationStructure::VulkanAccelerationStructure(VulkanContext const& context,
+        VmaAllocator allocator, VkDevice device, AccelerationStructureGeometry const& geometry,
+        fvkmemory::resource_ptr<VulkanBufferObject> vertexBuffer,
+        fvkmemory::resource_ptr<VulkanIndexBuffer> indexBuffer)
+        : mImpl(std::make_unique<Impl>(allocator, device, false,
+                  context.getAccelerationStructureScratchAlignment())) {
+    Impl& impl = *mImpl;
+    impl.vertexBuffer = std::move(vertexBuffer);
+    impl.indexBuffer = std::move(indexBuffer);
+
+    VkAccelerationStructureGeometryTrianglesDataKHR triangles = {
+        .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR,
+        .vertexFormat = vertexFormat(geometry.vertexFormat),
+        .vertexData = { .deviceAddress =
+                bufferAddress(device, impl.vertexBuffer->getVkBuffer()) + geometry.vertexOffset },
+        .vertexStride = geometry.vertexStride,
+        .maxVertex = geometry.vertexCount > 0 ? geometry.vertexCount - 1 : 0,
+        .indexType = VK_INDEX_TYPE_NONE_KHR,
+        .transformData = { .deviceAddress = 0 },
+    };
+    if (impl.indexBuffer) {
+        triangles.indexType = impl.indexBuffer->indexType;
+        triangles.indexData.deviceAddress =
+                bufferAddress(device, impl.indexBuffer->getVkBuffer()) +
+                VkDeviceSize(geometry.indexOffset) * impl.indexBuffer->elementSize;
+        impl.primitiveCount = geometry.indexCount / 3;
+    } else {
+        impl.primitiveCount = geometry.vertexCount / 3;
+    }
+    impl.geometry = {
+        .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR,
+        .geometryType = VK_GEOMETRY_TYPE_TRIANGLES_KHR,
+        .geometry = { .triangles = triangles },
+        .flags = VK_GEOMETRY_OPAQUE_BIT_KHR,
+    };
+    impl.allocateForBuild(impl.primitiveCount);
+}
+
+VulkanAccelerationStructure::VulkanAccelerationStructure(VulkanContext const& context,
+        VmaAllocator allocator, VkDevice device, uint32_t const instanceCapacity)
+        : mImpl(std::make_unique<Impl>(allocator, device, true,
+                  context.getAccelerationStructureScratchAlignment())) {
+    Impl& impl = *mImpl;
+    impl.instanceCapacity = std::max(1u, instanceCapacity);
+    impl.createBuffer(impl.instances,
+            VkDeviceSize(impl.instanceCapacity) * sizeof(VkAccelerationStructureInstanceKHR),
+            VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT |
+                    VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR,
+            true);
+    std::memset(impl.instances.mapped, 0, size_t(impl.instances.size));
+    impl.geometry = {
+        .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR,
+        .geometryType = VK_GEOMETRY_TYPE_INSTANCES_KHR,
+        .geometry = { .instances = {
+            .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR,
+            .arrayOfPointers = VK_FALSE,
+            .data = { .deviceAddress = impl.instances.address },
+        }},
+    };
+    impl.allocateForBuild(impl.instanceCapacity);
+}
+
+VulkanAccelerationStructure::~VulkanAccelerationStructure() = default;
+
+VkAccelerationStructureKHR VulkanAccelerationStructure::getHandle() const noexcept {
+    return mImpl->handle;
+}
+
+VkDeviceAddress VulkanAccelerationStructure::getDeviceAddress() const noexcept {
+    return mImpl->deviceAddress;
+}
+
+bool VulkanAccelerationStructure::isTopLevel() const noexcept {
+    return mImpl->isTopLevel;
+}
+
+uint32_t VulkanAccelerationStructure::getInstanceCapacity() const noexcept {
+    return mImpl->instanceCapacity;
+}
+
+uint32_t VulkanAccelerationStructure::getInstanceCount() const noexcept {
+    return mImpl->instanceCount;
+}
+
+bool VulkanAccelerationStructure::isBuilt() const noexcept {
+    return mImpl->built;
+}
+
+void VulkanAccelerationStructure::setInstances(AccelerationStructureInstance const* instances,
+        uint32_t count, BlasResolver const& resolve) {
+    Impl& impl = *mImpl;
+    if (!impl.isTopLevel || !impl.instances.mapped) {
+        return;
+    }
+    count = std::min(count, impl.instanceCapacity);
+    auto* out = static_cast<VkAccelerationStructureInstanceKHR*>(impl.instances.mapped);
+    impl.referencedBlas.clear();
+    impl.referencedBlas.reserve(count);
+    uint32_t written = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        AccelerationStructureInstance const& in = instances[i];
+        auto blas = resolve(in.blas);
+        if (!blas || !blas->isBuilt()) {
+            continue;
+        }
+        VkAccelerationStructureInstanceKHR& vk = out[written++];
+        std::memcpy(vk.transform.matrix, in.transform, sizeof(vk.transform.matrix));
+        vk.instanceCustomIndex = in.customIndex & 0xFFFFFFu;
+        vk.mask = in.mask;
+        vk.instanceShaderBindingTableRecordOffset = 0;
+        vk.flags = VK_GEOMETRY_INSTANCE_TRIANGLE_FACING_CULL_DISABLE_BIT_KHR;
+        vk.accelerationStructureReference = blas->getDeviceAddress();
+        impl.referencedBlas.push_back(std::move(blas));
+    }
+    impl.instanceCount = written;
+    vmaFlushAllocation(impl.allocator, impl.instances.allocation, 0, VK_WHOLE_SIZE);
+}
+
+void VulkanAccelerationStructure::build(VulkanCommandBuffer& commands,
+        AccelerationStructureBuildMode mode) {
+    Impl& impl = *mImpl;
+    uint32_t const primitiveCount = impl.isTopLevel ? impl.instanceCount : impl.primitiveCount;
+    // an update needs a previous build; an empty top level is still built (zero instances)
+    bool const refit = mode == AccelerationStructureBuildMode::REFIT && impl.built;
+    VkAccelerationStructureBuildGeometryInfoKHR const info = impl.buildInfo(refit);
+    VkAccelerationStructureBuildRangeInfoKHR const range = {
+        .primitiveCount = primitiveCount,
+        .primitiveOffset = 0,
+        .firstVertex = 0,
+        .transformOffset = 0,
+    };
+    VkAccelerationStructureBuildRangeInfoKHR const* ranges[] = { &range };
+
+    for (auto const& blas : impl.referencedBlas) {
+        commands.acquire(blas);
+    }
+    if (impl.vertexBuffer) commands.acquire(impl.vertexBuffer);
+    if (impl.indexBuffer) commands.acquire(impl.indexBuffer);
+
+    VkCommandBuffer const cmd = commands.buffer();
+
+    // the inputs (vertex/index/instance uploads, previous builds) must be complete
+    VkMemoryBarrier const before = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_HOST_WRITE_BIT |
+                VK_ACCESS_ACCELERATION_STRUCTURE_WRITE_BIT_KHR,
+        .dstAccessMask = VK_ACCESS_ACCELERATION_STRUCTURE_READ_BIT_KHR |
+                VK_ACCESS_SHADER_READ_BIT,
+    };
+    vkCmdPipelineBarrier(cmd,
+            VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_HOST_BIT |
+                    VK_PIPELINE_STAGE_ACCELERATION_STRUCTURE_BUILD_BIT_KHR,
+            VK_PIPELINE_STAGE_ACCELERATION_STRUCTURE_BUILD_BIT_KHR, 0, 1, &before, 0, nullptr, 0,
+            nullptr);
+
+    vkCmdBuildAccelerationStructuresKHR(cmd, 1, &info, ranges);
+
+    // the structure is read by ray queries in any shader stage and by later builds
+    VkMemoryBarrier const after = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_ACCELERATION_STRUCTURE_WRITE_BIT_KHR,
+        .dstAccessMask = VK_ACCESS_ACCELERATION_STRUCTURE_READ_BIT_KHR | VK_ACCESS_SHADER_READ_BIT,
+    };
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ACCELERATION_STRUCTURE_BUILD_BIT_KHR,
+            VK_PIPELINE_STAGE_ACCELERATION_STRUCTURE_BUILD_BIT_KHR |
+                    VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_VERTEX_SHADER_BIT |
+                    VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+            0, 1, &after, 0, nullptr, 0, nullptr);
+
+    impl.built = true;
+}
+
+} // namespace filament::backend
