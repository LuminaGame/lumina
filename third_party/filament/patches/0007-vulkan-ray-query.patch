+void FScene::updateAccelerationStructures(FEngine& engine, DriverApi& driver) noexcept {
+    using namespace backend;
+    RayTracingState& rt = mRayTracing;
+    rt.frame++;
+
+    // the GPU time of the previous build, when its timer query resolved
+    if (rt.timerPending && rt.timer) {
+        uint64_t nanos = 0;
+        TimerQueryResult const result = driver.getTimerQueryValue(rt.timer, &nanos);
+        if (result == TimerQueryResult::AVAILABLE) {
+            rt.lastBuildNanos = nanos;
+            rt.timerPending = false;
+        } else if (result == TimerQueryResult::ERROR) {
+            rt.timerPending = false;
+        }
+    }
+
+    FRenderableManager const& rcm = engine.getRenderableManager();
+    FTransformManager const& tcm = engine.getTransformManager();
+
+    std::vector<AccelerationStructureInstance> instances;
+    rt.entities.clear();
+    uint32_t renderableCount = 0;
+
+    // every renderable of the scene, not only the ones visible to a view: shadows and ray
+    // queries see what is off-screen too
+    mEntities.forEachSetBit([&](uint32_t const bit) {
+        Entity const entity = Entity::import(int32_t(bit));
+        FRenderableManager::Instance const ri = rcm.getInstance(entity);
+        if (!ri || !rcm.isRayTracingVisible(ri)) {
+            return;
+        }
+        FTransformManager::Instance const ti = tcm.getInstance(entity);
+        math::mat4f const worldTransform = ti ? tcm.getWorldTransform(ti) : math::mat4f{};
+        auto const primitives = rcm.getRenderPrimitives(ri, 0);
+        bool contributed = false;
+        for (FRenderPrimitive const& primitive : primitives) {
+            if (primitive.getPrimitiveType() != PrimitiveType::TRIANGLES) {
+                continue;
+            }
+            FVertexBuffer const* const vb = primitive.getVertexBuffer();
+            if (!vb) {
+                continue;
+            }
+            BufferObjectHandle boh;
+            uint32_t positionOffset = 0;
+            uint32_t positionStride = 0;
+            ElementType positionType = ElementType::FLOAT3;
+            if (!vb->getPositionBinding(boh, positionOffset, positionStride, positionType)) {
+                continue; // the buffer object is not uploaded yet
+            }
+            FIndexBuffer const* const ib = primitive.getIndexBuffer();
+            // one bottom-level structure per geometry, shared by the renderables that draw it
+            uint64_t key = uint64_t(boh.getId());
+            key = key * 1000003u ^ uint64_t(ib ? ib->getHwHandle().getId() : 0u);
+            key = key * 1000003u ^ uint64_t(primitive.getOffset());
+            key = key * 1000003u ^ uint64_t(primitive.getCount());
+            key = key * 1000003u ^ uint64_t(positionOffset);
+            auto it = rt.blas.find(key);
+            if (it == rt.blas.end()) {
+                AccelerationStructureGeometry geometry{};
+                geometry.vertexBuffer = boh;
+                geometry.vertexStride = positionStride;
+                geometry.vertexFormat = positionType;
+                if (ib) {
+                    geometry.vertexOffset = positionOffset;
+                    geometry.vertexCount = uint32_t(vb->getVertexCount());
+                    geometry.indexBuffer = ib->getHwHandle();
+                    geometry.indexOffset = primitive.getOffset();
+                    geometry.indexCount = primitive.getCount();
+                } else {
+                    geometry.vertexOffset = positionOffset + primitive.getOffset() * positionStride;
+                    geometry.vertexCount = primitive.getCount();
+                }
+                if (geometry.vertexCount == 0 || (ib && geometry.indexCount < 3)) {
+                    return;
+                }
+                auto const handle = driver.createAccelerationStructureBlas(geometry);
+                driver.buildAccelerationStructure(handle, AccelerationStructureBuildMode::BUILD);
+                it = rt.blas.emplace(key, RayTracingState::Blas{ handle, rt.frame }).first;
+            }
+            it->second.lastUsedFrame = rt.frame;
+
+            AccelerationStructureInstance instance{};
+            for (size_t r = 0; r < 3; r++) {
+                for (size_t c = 0; c < 4; c++) {
+                    instance.transform[r][c] = worldTransform[c][r];
+                }
+            }
+            instance.customIndex = uint32_t(rt.entities.size()) & 0xFFFFFFu;
+            instance.mask = 0xFF;
+            instance.blas = it->second.handle;
+            instances.push_back(instance);
+            rt.entities.push_back(entity);
+            contributed = true;
+        }
+        if (contributed) {
+            renderableCount++;
+        }
+    });
+    rt.renderableCount = renderableCount;
+
+    // bottom-level structures nobody drew for a while go away
+    for (auto it = rt.blas.begin(); it != rt.blas.end();) {
+        if (rt.frame - it->second.lastUsedFrame > 120u) {
+            driver.destroyAccelerationStructure(it->second.handle);
+            it = rt.blas.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    // the top-level structure grows with the instance count
+    uint32_t const needed = std::max<uint32_t>(1u, uint32_t(instances.size()));
+    if (!rt.tlas || needed > rt.tlasCapacity) {
+        if (rt.tlas) {
+            driver.destroyAccelerationStructure(rt.tlas);
+        }
+        rt.tlasCapacity = std::max<uint32_t>(16u, needed * 2u);
+        rt.tlas = driver.createAccelerationStructureTlas(rt.tlasCapacity);
+    }
+
+    size_t const bytes = instances.size() * sizeof(AccelerationStructureInstance);
+    void* const copy = ::malloc(std::max<size_t>(bytes, sizeof(AccelerationStructureInstance)));
+    if (bytes) {
+        std::memcpy(copy, instances.data(), bytes);
+    }
+    driver.updateTlasInstances(rt.tlas, BufferDescriptor(copy, bytes,
+            [](void* buffer, size_t, void*) { ::free(buffer); }));
+
+    if (!rt.timer) {
+        rt.timer = driver.createTimerQuery();
+    }
+    bool const timeThisBuild = !rt.timerPending;
+    if (timeThisBuild) {
+        driver.beginTimerQuery(rt.timer);
+    }
+    driver.buildAccelerationStructure(rt.tlas, AccelerationStructureBuildMode::BUILD);
+    if (timeThisBuild) {
+        driver.endTimerQuery(rt.timer);
+        rt.timerPending = true;
+    }
 }
 
