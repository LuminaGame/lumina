diff --git a/filament/src/materials/rt/rayVisibility.mat b/filament/src/materials/rt/rayVisibility.mat
new file mode 100644
index 00000000..19daa73e
--- /dev/null
+++ b/filament/src/materials/rt/rayVisibility.mat
@@ -0,0 +1,53 @@
+material {
+    name : rayVisibility,
+    parameters : [
+        {
+            type : float3,
+            name : origin,
+            precision: high
+        },
+        {
+            type : float3,
+            name : direction,
+            precision: high
+        },
+        {
+            type : float,
+            name : maxDistance,
+            precision: high
+        }
+    ],
+    outputs : [
+        {
+            name : hit,
+            target : color,
+            type : float4
+        }
+    ],
+    domain : postprocess,
+    rayQuery : true,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+    // One visibility ray, read back by View::traceRay(): (distance, instance custom index,
+    // primitive index, 1) for a hit, zeros for a miss.
+    void postProcess(inout PostProcessInputs postProcess) {
+        rayQueryEXT rq;
+        rayQueryInitializeEXT(rq, sceneTlas, gl_RayFlagsOpaqueEXT, 0xFFu,
+                materialParams.origin, 0.0, normalize(materialParams.direction),
+                materialParams.maxDistance);
+        // every geometry is opaque, so one step completes the traversal
+        rayQueryProceedEXT(rq);
+        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
+            postProcess.hit = vec4(
+                    rayQueryGetIntersectionTEXT(rq, true),
+                    float(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)),
+                    float(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true)),
+                    1.0);
+        } else {
+            postProcess.hit = vec4(0.0);
+        }
+    }
+}
