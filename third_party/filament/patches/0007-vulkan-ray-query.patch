diff --git a/filament/src/materials/rt/rtShadow.mat b/filament/src/materials/rt/rtShadow.mat
new file mode 100644
index 00000000..8d59f5fb
--- /dev/null
+++ b/filament/src/materials/rt/rtShadow.mat
@@ -0,0 +1,78 @@
+material {
+    name : rtShadow,
+    parameters : [
+        {
+            type : sampler2d,
+            name : depth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : mat4,
+            name : worldFromClip,
+            precision: high
+        },
+        {
+            type : float4,
+            name : resolution,
+            precision: high
+        },
+        {
+            type : float3,
+            name : toLight,
+            precision: high
+        },
+        {
+            type : float3,
+            name : cameraPosition,
+            precision: high
+        },
+        {
+            type : float,
+            name : bias,
+            precision: high
+        }
+    ],
+    outputs : [
+        {
+            name : visibility,
+            target : color,
+            type : float
+        }
+    ],
+    domain : postprocess,
+    rayQuery : true,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+    // Hard sun shadows traced against the scene's acceleration structure: one visibility
+    // ray per pixel from the surface the structure depth describes toward the light.
+    void postProcess(inout PostProcessInputs postProcess) {
+        ivec2 icoord = ivec2(gl_FragCoord.xy);
+        highp float depth = texelFetch(materialParams_depth, icoord, 0).r;
+        float visibility = 1.0;
+        // reversed-Z: 0 is the far plane, nothing to shadow there
+        if (depth > 0.0) {
+            highp vec2 uv = (vec2(icoord) + 0.5) * materialParams.resolution.zw;
+            highp vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
+            highp vec4 world = materialParams.worldFromClip * clip;
+            world.xyz /= world.w;
+            // offset the origin along the ray, scaled with the distance to the camera so that
+            // depth quantization does not make surfaces shadow themselves
+            highp float distanceToCamera = length(world.xyz - materialParams.cameraPosition);
+            highp float bias = materialParams.bias * (1.0 + distanceToCamera * 0.02);
+            highp vec3 origin = world.xyz + materialParams.toLight * bias;
+            rayQueryEXT rq;
+            rayQueryInitializeEXT(rq, sceneTlas,
+                    gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu,
+                    origin, 0.0, materialParams.toLight, 1.0e5);
+            rayQueryProceedEXT(rq);
+            if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
+                visibility = 0.0;
+            }
+        }
+        postProcess.visibility = visibility;
+    }
+}
