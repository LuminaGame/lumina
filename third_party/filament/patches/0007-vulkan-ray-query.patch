+FrameGraphId<FrameGraphTexture> PostProcessManager::rayTracedShadows(FrameGraph& fg,
+        FrameGraphId<FrameGraphTexture> const depth, CameraInfo const& cameraInfo,
+        math::float3 const toLight) noexcept {
+
+    struct RayTracedShadowData {
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> mask;
+    };
+
+    auto const& pass = fg.addPass<RayTracedShadowData>("ray-traced shadows",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                auto const& desc = fg.getDescriptor(depth);
+                data.depth = builder.sample(depth);
+                data.mask = builder.createTexture("ray-traced shadow mask", {
+                        .width = desc.width, .height = desc.height,
+                        .format = TextureFormat::R8 });
+                data.mask = builder.declareRenderPass(data.mask);
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                mRayQueryDescriptorSet.bind(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& desc = resources.getDescriptor(data.depth);
+                auto const& depthTexture = resources.getTexture(data.depth);
+                auto const& out = resources.getRenderPassInfo();
+
+                auto const& material = getPostProcessMaterial("rtShadow");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("depth", depthTexture, SamplerParams{});
+                // The acceleration structures hold the renderables' true world transforms,
+                // while the camera (and everything shaded) lives in the world shifted by
+                // cameraInfo.worldTransform: reconstruct the pixel back in the true world.
+                math::mat4 const trueWorldFromShaderWorld = inverse(cameraInfo.worldTransform);
+                math::mat4 const worldFromClip = trueWorldFromShaderWorld *
+                        math::mat4(cameraInfo.model) * inverse(math::mat4(cameraInfo.projection));
+                mi->setParameter("worldFromClip", math::mat4f(worldFromClip));
+                mi->setParameter("resolution", math::float4{
+                        float(desc.width), float(desc.height),
+                        1.0f / float(desc.width), 1.0f / float(desc.height) });
+                mi->setParameter("toLight", toLight);
+                mi->setParameter("cameraPosition", math::float3(
+                        (trueWorldFromShaderWorld * math::double4(cameraInfo.getPosition(), 1.0)).xyz));
+                // a fraction of the depth range that keeps surfaces from shadowing themselves
+                mi->setParameter("bias", std::max(0.002f, cameraInfo.zn * 0.5f));
+
+                commitAndRenderFullScreenQuad(driver, out, mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    return pass->mask;
+}
+
+void PostProcessManager::rayQueries(FrameGraph& fg, FView& view) noexcept {
+    FView::FRayQuery* list = view.takeRayQueries();
+    while (list) {
+        FView::FRayQuery* const query = list;
+        list = query->next;
+        query->next = nullptr;
+        query->scene = view.getScene();
+
+        struct RayQueryData {
+            FrameGraphId<FrameGraphTexture> result;
+        };
+        // the ray's answer: one RGBA32F texel
+        auto const& pass = fg.addPass<RayQueryData>("ray query",
+                [&](FrameGraph::Builder& builder, auto& data) {
+                    data.result = builder.createTexture("ray query result", {
+                            .width = 1, .height = 1, .format = TextureFormat::RGBA32F });
+                    data.result = builder.declareRenderPass(data.result);
+                },
+                [=, this](FrameGraphResources const& resources, auto const&, DriverApi& driver) {
+                    mRayQueryDescriptorSet.bind(driver);
+                    bindPerRenderableDescriptorSet(driver);
+                    auto const& out = resources.getRenderPassInfo();
+
+                    auto const& material = getPostProcessMaterial("rayVisibility");
+                    FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                    mi->setParameter("origin", query->origin);
+                    mi->setParameter("direction", query->direction);
+                    mi->setParameter("maxDistance", query->maxDistance);
+                    commitAndRenderFullScreenQuad(driver, out, mi);
+                    unbindAllDescriptorSets(driver);
+                });
+
+        // read it back outside the frame graph, like the picking resolve pass: the texel is
+        // read as a blit source once the render pass that wrote it is over
+        struct RayQueryReadData {
+            FrameGraphId<FrameGraphTexture> result;
+        };
+        fg.addPass<RayQueryReadData>("ray query read-back",
+                [&](FrameGraph::Builder& builder, auto& data) {
+                    data.result = builder.read(pass->result,
+                            FrameGraphTexture::Usage::COLOR_ATTACHMENT |
+                            FrameGraphTexture::Usage::BLIT_SRC);
+                    builder.declareRenderPass("ray query read-back target", {
+                            .attachments = { .color = { data.result }}
+                    });
+                    builder.sideEffect();
+                },
+                [=](FrameGraphResources const& resources, auto const&, DriverApi& driver) {
+                    auto const& out = resources.getRenderPassInfo();
+                    driver.readPixels(out.target, 0, 0, 1, 1, PixelBufferDescriptor{
+                            query->raw, sizeof(query->raw),
+                            PixelDataFormat::RGBA, PixelDataType::FLOAT,
+                            query->handler, [](void*, size_t, void* user) {
+                                FView::FRayQuery* const q = static_cast<FView::FRayQuery*>(user);
+                                bool const hit = q->raw[3] > 0.5f;
+                                q->result.hit = hit;
+                                q->result.distance = hit ? q->raw[0] : 0.0f;
+                                q->result.primitive = hit ? uint32_t(q->raw[2] + 0.5f) : 0u;
+                                q->result.renderable = (hit && q->scene)
+                                        ? q->scene->getRayTracedEntity(uint32_t(q->raw[1] + 0.5f))
+                                        : utils::Entity{};
+                                q->callback(q->result, q);
+                                FView::FRayQuery::put(q);
+                            }, query });
+                });
+    }
+}
