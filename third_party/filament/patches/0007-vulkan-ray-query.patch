+/**
+ * A ray tracing acceleration structure (VK_KHR_acceleration_structure): either a bottom-level
+ * structure over one triangle geometry, or a top-level structure over instances of bottom-level
+ * ones. The structure owns its backing buffer and a scratch buffer sized for its builds; the
+ * top-level one also owns a host-visible instance buffer. The state lives behind a pointer so
+ * the handle stays small enough for the handle allocator.
+ */
+struct VulkanAccelerationStructure : public HwAccelerationStructure, fvkmemory::Resource {
+    using BlasResolver = std::function<fvkmemory::resource_ptr<VulkanAccelerationStructure>(
+            Handle<HwAccelerationStructure>)>;
+
+    // bottom level
+    VulkanAccelerationStructure(VulkanContext const& context, VmaAllocator allocator,
+            VkDevice device, AccelerationStructureGeometry const& geometry,
+            fvkmemory::resource_ptr<VulkanBufferObject> vertexBuffer,
+            fvkmemory::resource_ptr<VulkanIndexBuffer> indexBuffer);
+
+    // top level
+    VulkanAccelerationStructure(VulkanContext const& context, VmaAllocator allocator,
+            VkDevice device, uint32_t instanceCapacity);
+
+    ~VulkanAccelerationStructure();
+
+    // Copies the backend-neutral instances into the instance buffer, resolving each
+    // bottom-level handle to its structure. Top level only.
+    void setInstances(AccelerationStructureInstance const* instances, uint32_t count,
+            BlasResolver const& resolve);
+
+    // Records the build (or refit) into the command buffer, followed by the barrier that makes
+    // the structure visible to ray queries and to later builds.
+    void build(VulkanCommandBuffer& commands, AccelerationStructureBuildMode mode);
+
+    VkAccelerationStructureKHR getHandle() const noexcept;
+    VkDeviceAddress getDeviceAddress() const noexcept;
+    bool isTopLevel() const noexcept;
+    uint32_t getInstanceCapacity() const noexcept;
+    uint32_t getInstanceCount() const noexcept;
+    bool isBuilt() const noexcept;
+
+    struct Impl;
+
+private:
+    std::unique_ptr<Impl> mImpl;
+};
+
+} // namespace filament::backend
+
+#endif // TNT_FILAMENT_BACKEND_VULKANACCELERATIONSTRUCTURE_H
