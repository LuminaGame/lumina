+bool VulkanPlatform::isExtraDeviceFeatureEnabled(uint32_t const sType,
+        uint32_t const fieldOffset) const noexcept {
+    for (auto const& chosen: mImpl->mExtraDeviceFeatures) {
+        if (uint32_t(reinterpret_cast<VkBaseOutStructure const*>(chosen.data())->sType) != sType) {
+            continue;
+        }
+        if (fieldOffset < sizeof(VkBaseOutStructure) ||
+                fieldOffset + sizeof(VkBool32) > chosen.size()) {
+            return false;
+        }
+        VkBool32 value = VK_FALSE;
+        std::memcpy(&value, chosen.data() + fieldOffset, sizeof(value));
+        return value == VK_TRUE;
+    }
+    return false;
+}
+
+bool VulkanPlatform::isDeviceExtensionEnabled(char const* name) const noexcept {
+    if (!name) {
+        return false;
+    }
+    return std::any_of(mImpl->mEnabledDeviceExtensions.begin(),
+            mImpl->mEnabledDeviceExtensions.end(),
+            [name](std::string const& ext) { return ext == name; });
+}
+
 void VulkanPlatform::setPresentationTime(int64_t presentTime) noexcept {
     mImpl->mPresentationTime = presentTime;
 }
