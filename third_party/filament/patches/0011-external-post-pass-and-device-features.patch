+
+FrameGraphId<FrameGraphTexture> PostProcessManager::externalPostPass(FrameGraph& fg,
+        ExternalPostPassInputs const& external, FrameGraphId<FrameGraphTexture> const input,
+        CameraInfo const& cameraInfo, FrameHistory& frameHistory) noexcept {
+
+    auto const& inputDesc = fg.getDescriptor(input);
+    if (!external.pass || !external.depth ||
+            !external.pass->supports(inputDesc.width, inputDesc.height)) {
+        return input;
+    }
+    auto const& depthDesc = fg.getDescriptor(external.depth);
+
+    math::float2 jitter = external.jitter;
+    switch (mEngine.getBackend()) {
+        case Backend::METAL:
+        case Backend::VULKAN:
+        case Backend::WEBGPU:
+            jitter.y = -jitter.y;
+            break;
+        default:
+            break;
+    }
+    // cameraInfo holds the unjittered projection; the colour pass (and its depth) used the
+    // jittered one (TaaJitterCamera). The surface is reconstructed with the jittered
+    // projection it was rendered with and projected by the unjittered cameras of both frames.
+    math::mat4f const projection = cameraInfo.projection;
+    math::mat4f jittered = projection;
+    jittered[2].xy -= jitter * (2.0f / math::float2{ depthDesc.width, depthDesc.height });
+    math::mat4 const clipFromWorld = math::mat4(projection) * math::mat4(cameraInfo.view);
+    math::mat4 const worldFromClip = math::mat4(cameraInfo.model) * inverse(math::mat4(jittered));
+    auto const& previous = frameHistory.getPrevious().postPass;
+    auto& current = frameHistory.getCurrent().postPass;
+    bool const historyValid = previous.valid && !external.resetHistory;
+    math::mat4 const prevClipFromWorld = historyValid ? previous.clipFromWorld : clipFromWorld;
+    current.clipFromWorld = clipFromWorld;
+    current.valid = true;
+
+    struct MotionData {
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> velocity;
+        FrameGraphId<FrameGraphTexture> motion;
+    };
+    auto const& motionPass = fg.addPass<MotionData>("external post pass motion",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.depth = builder.sample(external.depth);
+                if (external.velocity) {
+                    data.velocity = builder.sample(external.velocity);
+                }
+                data.motion = builder.createTexture("external post pass motion", {
+                        .width = inputDesc.width, .height = inputDesc.height,
+                        .format = TextureFormat::RGBA16F });
+                data.motion = builder.declareRenderPass(data.motion);
+            },
+            [=, this](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& out = resources.getRenderPassInfo();
+                auto const& material = getPostProcessMaterial("postPassMotion");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("depth", resources.getTexture(data.depth), SamplerParams{});
+                math::float2 velocitySize{ 1.0f, 1.0f };
+                if (data.velocity) {
+                    auto const& vdesc = resources.getDescriptor(data.velocity);
+                    velocitySize = { float(vdesc.width), float(vdesc.height) };
+                    mi->setParameter("velocity", resources.getTexture(data.velocity),
+                            SamplerParams{});
+                } else {
+                    mi->setParameter("velocity", mEngine.getZeroTexture(), SamplerParams{});
+                }
+                mi->setParameter("worldFromClip", math::mat4f(worldFromClip));
+                mi->setParameter("clipFromWorld", math::mat4f(clipFromWorld));
+                mi->setParameter("prevClipFromWorld", math::mat4f(prevClipFromWorld));
+                mi->setParameter("resolution", math::float4{
+                        float(inputDesc.width), float(inputDesc.height),
+                        1.0f / float(inputDesc.width), 1.0f / float(inputDesc.height) });
+                mi->setParameter("depthSize",
+                        math::float2{ float(depthDesc.width), float(depthDesc.height) });
+                mi->setParameter("velocitySize", velocitySize);
+                mi->setParameter("hasVelocity", data.velocity ? 1.0f : 0.0f);
+                mi->setParameter("historyValid", historyValid ? 1.0f : 0.0f);
+                commitAndRenderFullScreenQuad(driver, out, mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    struct PostPassData {
+        FrameGraphId<FrameGraphTexture> color;
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> motion;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+    float const exposure = Exposure::exposure(cameraInfo.ev100);
+    math::mat4f const viewFromWorld = cameraInfo.view;
+    auto const& pass = fg.addPass<PostPassData>("external post pass",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                data.color = builder.read(input, FrameGraphTexture::Usage::SAMPLEABLE);
+                data.depth = builder.read(external.depth, FrameGraphTexture::Usage::SAMPLEABLE);
+                data.motion = builder.read(motionPass->motion, FrameGraphTexture::Usage::SAMPLEABLE);
+                data.output = builder.createTexture("external post pass output", {
+                        .width = inputDesc.width, .height = inputDesc.height,
+                        .format = TextureFormat::RGBA16F });
+                data.output = builder.write(data.output,
+                        FrameGraphTexture::Usage::STORAGE | FrameGraphTexture::Usage::SAMPLEABLE |
+                        FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                // as for the external upscaler: give the write-only output a reference so the
+                // frame graph allocates it before the callback runs
+                builder.declareRenderPass(builder.getName(data.output), {
+                        .attachments = { .color = { data.output } } });
+                builder.sideEffect();
+            },
+            [external, inputDesc, depthDesc, historyValid, exposure, projection, viewFromWorld](
+                    FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                ExternalPassDescriptor descriptor{};
+                descriptor.callback = [](ExternalPassContext const& context) {
+                    static_cast<ExternalPostPass*>(context.user)->evaluate(context);
+                };
+                descriptor.user = external.pass;
+                descriptor.textureCount = 4;
+                descriptor.textures[ExternalPostPass::COLOR] = resources.getTexture(data.color);
+                descriptor.textures[ExternalPostPass::DEPTH] = resources.getTexture(data.depth);
+                descriptor.textures[ExternalPostPass::MOTION] = resources.getTexture(data.motion);
+                descriptor.textures[ExternalPostPass::OUTPUT] = resources.getTexture(data.output);
+                descriptor.writeMask = 1u << ExternalPostPass::OUTPUT;
+                descriptor.frame.jitter[0] = external.jitter.x;
+                descriptor.frame.jitter[1] = external.jitter.y;
+                descriptor.frame.renderWidth = depthDesc.width;
+                descriptor.frame.renderHeight = depthDesc.height;
+                descriptor.frame.outputWidth = inputDesc.width;
+                descriptor.frame.outputHeight = inputDesc.height;
+                descriptor.frame.frameId = external.frameId;
+                descriptor.frame.flags =
+                        (external.velocity ? ExternalPassFrame::FLAG_VELOCITY_BUFFER : 0u) |
+                        (historyValid ? 0u : ExternalPassFrame::FLAG_HISTORY_RESET);
+                descriptor.frame.exposure = exposure;
+                std::memcpy(descriptor.frame.viewFromWorld, &viewFromWorld,
+                        sizeof(descriptor.frame.viewFromWorld));
+                std::memcpy(descriptor.frame.clipFromView, &projection,
+                        sizeof(descriptor.frame.clipFromView));
