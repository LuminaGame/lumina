+/**
+ * A pass implemented outside Filament that rewrites the anti-aliased (and possibly upscaled)
+ * HDR frame before depth of field, bloom and colour grading: a denoiser, a learned
+ * post-process or a neural rendering network. It runs after Filament's TAA / FSR3 resolve
+ * or after an ExternalUpscaler of Stage::HDR, at that pass's resolution (the output
+ * resolution when one of them upscales, the render resolution otherwise), every frame the
+ * view renders on the Vulkan backend. The other backends skip it.
+ *
+ * @see View::setExternalPostPass
+ */
+class UTILS_PUBLIC ExternalPostPass {
+public:
+    /** Indices of the images evaluate() receives in ExternalPassContext::images. */
+    enum Image : uint32_t {
+        COLOR = 0,      //!< the pre-exposed linear HDR frame (read-only)
+        DEPTH = 1,      //!< the colour pass depth at the render resolution (reversed Z)
+        /**
+         * RGBA16F at the colour's size: rg = motion in texels of that size (uv_curr - uv_prev,
+         * x right, y up, as the structure pass velocity buffer), b = 1 where the previous
+         * position was on screen (the history there is usable), a = 1 where the pixel is the
+         * sky (depth at the far plane) and its motion is the camera's alone.
+         */
+        MOTION = 2,
+        OUTPUT = 3,     //!< RGBA16F storage image at the colour's size; replaces COLOR
+    };
+
+    /**
+     * Called on the main thread while the frame is set up with the size of the colour the
+     * pass would get. Return false to skip the pass for this frame (the colour then
+     * continues unchanged).
+     */
+    virtual bool supports(uint32_t width, uint32_t height) noexcept = 0;
+
+    /**
+     * Called on the backend thread while the frame's command buffer records, with the four
+     * images (Image) in a general layout. frame.outputWidth/Height is the colour's size,
+     * frame.renderWidth/Height the depth's, frame.jitter the sub-pixel offset of the render
+     * (0 when TAA is off), frame.flags carries ExternalPassFrame::FLAG_*, and the matrices
+     * and exposure describe the camera. Record into context.commandBuffer only, write every
+     * texel of OUTPUT, never submit or wait.
+     */
+    virtual void evaluate(backend::ExternalPassContext const& context) noexcept = 0;
+
+protected:
+    ~ExternalPostPass() = default;
+};
