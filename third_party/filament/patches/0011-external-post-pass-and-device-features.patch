diff --git a/filament/src/materials/rt/postPassMotion.mat b/filament/src/materials/rt/postPassMotion.mat
new file mode 100644
index 00000000..2bc2dd8d
--- /dev/null
+++ b/filament/src/materials/rt/postPassMotion.mat
@@ -0,0 +1,109 @@
+material {
+    name : postPassMotion,
+    parameters : [
+        {
+            type : sampler2d,
+            name : depth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : velocity,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : mat4,
+            name : worldFromClip,
+            precision: high
+        },
+        {
+            type : mat4,
+            name : clipFromWorld,
+            precision: high
+        },
+        {
+            type : mat4,
+            name : prevClipFromWorld,
+            precision: high
+        },
+        {
+            type : float4,
+            name : resolution,
+            precision: high
+        },
+        {
+            type : float2,
+            name : depthSize,
+            precision: high
+        },
+        {
+            type : float2,
+            name : velocitySize,
+            precision: high
+        },
+        {
+            type : float,
+            name : hasVelocity
+        },
+        {
+            type : float,
+            name : historyValid
+        }
+    ],
+    outputs : [
+        {
+            name : motion,
+            target : color,
+            type : float4
+        }
+    ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+    // The motion an external post pass gets, at its own resolution: the structure pass
+    // velocity buffer (render resolution, texels of uv_curr - uv_prev, y up) rescaled to this
+    // target, or the camera's reprojection where the velocity buffer has nothing (no motion
+    // vectors, the sky). b flags a previous position on screen, a flags the sky.
+    void postProcess(inout PostProcessInputs postProcess) {
+        highp vec2 coord = gl_FragCoord.xy;
+        highp vec2 uv = coord * materialParams.resolution.zw;
+        ivec2 depthCoord = ivec2(min(uv * materialParams.depthSize, materialParams.depthSize - 1.0));
+        highp float depth = texelFetch(materialParams_depth, depthCoord, 0).r;
+        // window y grows downwards, NDC y upwards
+        highp vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
+        bool sky = depth <= 0.0;
+
+        highp vec2 motion = vec2(0.0);
+        bool fromVelocity = false;
+        if (materialParams.hasVelocity > 0.5 && !sky) {
+            ivec2 velocityCoord = ivec2(min(uv * materialParams.velocitySize,
+                    materialParams.velocitySize - 1.0));
+            highp vec2 v = texelFetch(materialParams_velocity, velocityCoord, 0).rg;
+            motion = v * (materialParams.resolution.xy / materialParams.velocitySize);
+            fromVelocity = true;
+        }
+        if (!fromVelocity) {
+            // camera-only motion: the surface (or the far plane, for the sky) the jittered
+            // depth describes, projected by this and the previous frame's unjittered cameras
+            highp vec4 world = materialParams.worldFromClip * vec4(ndc, max(depth, 1.0e-7), 1.0);
+            world.xyz /= world.w;
+            highp vec4 currClip = materialParams.clipFromWorld * vec4(world.xyz, 1.0);
+            highp vec4 prevClip = materialParams.prevClipFromWorld * vec4(world.xyz, 1.0);
+            highp vec2 currNdc = currClip.w > 0.0 ? currClip.xy / currClip.w : ndc;
+            highp vec2 prevNdc = prevClip.w > 0.0 ? prevClip.xy / prevClip.w : currNdc;
+            motion = (currNdc - prevNdc) * 0.5 * materialParams.resolution.xy;
+        }
+        highp vec2 prevNdcFromMotion = ndc - motion * 2.0 * materialParams.resolution.zw;
+        // half a texel of slack: the border texels' centres sit inside, rounding must not
+        // push them out
+        bool onScreen = all(lessThanEqual(abs(prevNdcFromMotion),
+                vec2(1.0) + materialParams.resolution.zw));
+        float valid = (materialParams.historyValid > 0.5 && onScreen) ? 1.0 : 0.0;
+        postProcess.motion = vec4(motion, valid, sky ? 1.0 : 0.0);
+    }
+}
