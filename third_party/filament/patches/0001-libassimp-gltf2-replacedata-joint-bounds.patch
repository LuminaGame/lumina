From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Can Us <me@canus.dev>
Date: Sun, 20 Sep 2026 00:14:10 +0300
Subject: [PATCH 1/3] libassimp: keep glTF2 Buffer::ReplaceData_joint within
 bounds

ReplaceData_joint allocated exactly the new byte length and then always
copied the tail after the replaced range. When the replacement reaches
the end of the buffer that length, new_size - (offset + count), is zero
or wraps around, and the copy runs past both buffers. It also dropped
the buffer's capacity to the new size without saying so, while later
appends trust the recorded capacity.

Allocate max(capacity, new size), record it, and copy the tail only when
there is one. The glTF2 exporter hits this when it rewrites joint
indices of skinned meshes.

diff --git a/third_party/libassimp/code/glTF2/glTF2Asset.inl b/third_party/libassimp/code/glTF2/glTF2Asset.inl
index 6b47b160..48eacf83 100644
--- a/third_party/libassimp/code/glTF2/glTF2Asset.inl
+++ b/third_party/libassimp/code/glTF2/glTF2Asset.inl
@@ -498,15 +498,18 @@ bool Buffer::ReplaceData_joint(const size_t pBufferData_Offset, const size_t pBu
 	}
 
 	const size_t new_data_size = byteLength + pReplace_Count - pBufferData_Count;
-	uint8_t* new_data = new uint8_t[new_data_size];
+	capacity = std::max(capacity, new_data_size);
+	uint8_t* new_data = new uint8_t[capacity];
 	// Copy data which place before replacing part.
 	memcpy(new_data, mData.get(), pBufferData_Offset);
 	// Copy new data.
 	memcpy(&new_data[pBufferData_Offset], pReplace_Data, pReplace_Count);
 	// Copy data which place after replacing part.
-    memcpy(&new_data[pBufferData_Offset + pReplace_Count], &mData.get()[pBufferData_Offset + pBufferData_Count]
-            , new_data_size - (pBufferData_Offset + pReplace_Count)
-          );
+	if (new_data_size > pBufferData_Offset + pReplace_Count) {
+		memcpy(&new_data[pBufferData_Offset + pReplace_Count], &mData.get()[pBufferData_Offset + pBufferData_Count]
+				, new_data_size - (pBufferData_Offset + pReplace_Count)
+			  );
+	}
 	// Apply new data
 	mData.reset(new_data, std::default_delete<uint8_t[]>());
 	byteLength = new_data_size;
