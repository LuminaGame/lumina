+/**
+ * Options for ReSTIR direct lighting.
+ *
+ * When enabled on a device with ray query support (Engine::isRayQuerySupported()) and a scene
+ * that keeps its acceleration structures (Scene::setRayTracingEnabled()), the punctual lights
+ * are no longer evaluated per froxel. Every pixel keeps a reservoir of candidate lights
+ * resampled from the whole scene (initialCandidates per frame), reuses the previous frame's
+ * reservoir (temporal) and its neighbours' (spatialSamples within spatialRadiusPx), traces one
+ * visibility ray to the surviving light (visibilityRays) and shades that light alone with the
+ * material's BRDF. The cost is nearly independent of the light count and every light casts a
+ * hard ray-traced shadow. Directional lights and image-based lighting keep their own paths;
+ * transparent surfaces are not shaded by ReSTIR. Without support the froxel path renders.
+ *
+ * @see View::setRestirOptions, LightManager::setRestirSamplingWeight
+ */
+struct RestirOptions {
+    bool enabled = false;               //!< use ReSTIR for the punctual lights
+    uint8_t initialCandidates = 8;      //!< lights sampled per pixel and frame before reuse
+    uint8_t spatialSamples = 2;         //!< neighbouring reservoirs merged per pixel (0 disables)
+    float spatialRadiusPx = 32.0f;      //!< radius of the neighbourhood, in pixels
+    bool temporal = true;               //!< reuse the previous frame's reservoir
+    uint8_t maxHistory = 20;            //!< how many frames of history one reservoir may weigh
+    bool visibilityRays = true;         //!< trace a visibility ray to the chosen light
+    bool shadeEmissive = false;         //!< reserved: emissive triangles as lights (not implemented)
+};
+
 } // namespace filament
 
 #endif //TNT_FILAMENT_OPTIONS_H
