+
+void FView::prepareRestirLights(FEngine& engine, FScene::LightSoa const& lightData) noexcept {
+    using namespace backend;
+    DriverApi& driver = engine.getDriverApi();
+    FLightManager const& lcm = engine.getLightManager();
+    size_t const total = lightData.size();
+    uint32_t const count = total > FScene::DIRECTIONAL_LIGHTS_COUNT ?
+            uint32_t(total - FScene::DIRECTIONAL_LIGHTS_COUNT) : 0u;
+    mRestir.lightCount = count;
+    if (count == 0) {
+        return;
+    }
+    // four RGBA32F texels per light: (position, 1/falloff^2), (direction, type),
+    // (colour, intensity), (spot scale, spot offset, sampling weight, channels)
+    if (!mRestir.lightTexture || count > mRestir.lightCapacity) {
+        if (mRestir.lightTexture) {
+            driver.destroyTexture(mRestir.lightTexture);
+        }
+        mRestir.lightCapacity = std::max<uint32_t>(64u, count * 2u);
+        mRestir.lightTexture = driver.createTexture(SamplerType::SAMPLER_2D, 1,
+                TextureFormat::RGBA32F, 1, 4, mRestir.lightCapacity, 1,
+                TextureUsage::SAMPLEABLE | TextureUsage::UPLOADABLE);
+    }
+    size_t const bytes = size_t(count) * 4 * sizeof(math::float4);
+    auto* const texels = static_cast<math::float4*>(::malloc(bytes));
+    auto const* const spheres = lightData.data<FScene::POSITION_RADIUS>();
+    auto const* const directions = lightData.data<FScene::DIRECTION>();
+    auto const* const entities = lightData.data<FScene::LIGHT_ENTITY>();
+    for (uint32_t i = 0; i < count; i++) {
+        size_t const li = i + FScene::DIRECTIONAL_LIGHTS_COUNT;
+        auto const instance = lcm.getInstance(entities[li]);
+        auto const& spot = lcm.getSpotParams(instance);
+        texels[i * 4 + 0] = { spheres[li].xyz, lcm.getSquaredFalloffInv(instance) };
+        texels[i * 4 + 1] = { directions[li], lcm.isPointLight(instance) ? 0.0f : 1.0f };
+        texels[i * 4 + 2] = { lcm.getColor(instance), lcm.getIntensity(instance) };
+        texels[i * 4 + 3] = { spot.scaleOffset.x, spot.scaleOffset.y,
+                lcm.getRestirSamplingWeight(instance), float(lcm.getLightChannels(instance)) };
+    }
+    driver.update3DImage(mRestir.lightTexture, 0, 0, 0, 0, 4, count, 1,
+            PixelBufferDescriptor(texels, bytes, PixelDataFormat::RGBA, PixelDataType::FLOAT,
+                    [](void* buffer, size_t, void*) { ::free(buffer); }));
+}
+
+void FView::prepareRestir(FEngine& engine, Handle<HwTexture> const reservoir, bool const active) const noexcept {
+    Handle<HwTexture> const zero = engine.getZeroTexture();
+    getColorPassDescriptorSet().prepareRestir(
+            active && reservoir ? reservoir : zero,
+            active && mRestir.lightTexture ? mRestir.lightTexture : zero,
+            active);
+}
