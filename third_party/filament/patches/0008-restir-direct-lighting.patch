+FrameGraphId<FrameGraphTexture> PostProcessManager::restir(FrameGraph& fg,
+        FrameGraphId<FrameGraphTexture> const depth, CameraInfo const& cameraInfo,
+        FView& view, FrameHistory& frameHistory) noexcept {
+
+    RestirOptions const& options = view.getRestirOptions();
+    FView::RestirState& state = view.getRestirState();
+    auto const& previous = frameHistory.getPrevious().restir;
+    auto& current = frameHistory.getCurrent().restir;
+
+    // the GPU time of the previous frame's passes, once its timer resolved
+    if (state.timerPending && state.timer) {
+        uint64_t nanos = 0;
+        auto const result = mEngine.getDriverApi().getTimerQueryValue(state.timer, &nanos);
+        if (result == TimerQueryResult::AVAILABLE) {
+            state.gpuNanos = nanos;
+            state.timerPending = false;
+        } else if (result == TimerQueryResult::ERROR) {
+            state.timerPending = false;
+        }
+    }
+    if (!state.timer) {
+        state.timer = mEngine.getDriverApi().createTimerQuery();
+    }
+    bool const timeThisFrame = !state.timerPending;
+    state.frame++;
+
+    bool const historyValid = options.temporal && !state.resetHistory && previous.reservoir.handle;
+    state.resetHistory = false;
+    FrameGraphId<FrameGraphTexture> history;
+    if (historyValid) {
+        history = fg.import("ReSTIR history", previous.desc,
+                FrameGraphTexture::Usage::SAMPLEABLE, previous.reservoir);
+    }
+    math::mat4 const clipFromWorld = math::mat4(cameraInfo.projection) * math::mat4(cameraInfo.view);
+    math::mat4 const worldFromClip = math::mat4(cameraInfo.model) * inverse(math::mat4(cameraInfo.projection));
+    math::mat4 const prevClipFromWorld = historyValid ? previous.clipFromWorld : clipFromWorld;
+    current.clipFromWorld = clipFromWorld;
+    // the acceleration structures hold true world transforms; the camera lives in the world
+    // shifted by cameraInfo.worldTransform (a translation)
+    math::float3 const trueWorldOffset = math::float3(
+            (inverse(cameraInfo.worldTransform) * math::double4(0.0, 0.0, 0.0, 1.0)).xyz);
+    Handle<HwTexture> const lightTexture = state.lightTexture;
+    uint32_t const lightCount = state.lightCount;
+
+    struct CandidatesData {
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> history;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+    auto const& candidates = fg.addPass<CandidatesData>("ReSTIR candidates",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                auto const& desc = fg.getDescriptor(depth);
+                data.depth = builder.sample(depth);
+                if (history) {
+                    data.history = builder.sample(history);
+                }
+                data.output = builder.createTexture("ReSTIR reservoirs", {
+                        .width = desc.width, .height = desc.height,
+                        .format = TextureFormat::RGBA32F });
+                data.output = builder.declareRenderPass(data.output);
+            },
+            [=, this, &state](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                if (timeThisFrame) {
+                    driver.beginTimerQuery(state.timer);
+                }
+                mRayQueryDescriptorSet.bind(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& desc = resources.getDescriptor(data.depth);
+                auto const& out = resources.getRenderPassInfo();
+                auto const& material = getPostProcessMaterial("restirCandidates");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("depth", resources.getTexture(data.depth), SamplerParams{});
+                mi->setParameter("lights", lightTexture, SamplerParams{});
+                mi->setParameter("history", data.history ? resources.getTexture(data.history) : mEngine.getZeroTexture(), SamplerParams{});
+                mi->setParameter("worldFromClip", math::mat4f(worldFromClip));
+                mi->setParameter("prevClipFromWorld", math::mat4f(prevClipFromWorld));
+                mi->setParameter("resolution", math::float4{ float(desc.width), float(desc.height),
+                        1.0f / float(desc.width), 1.0f / float(desc.height) });
+                mi->setParameter("cameraPosition", cameraInfo.getPosition());
+                mi->setParameter("lightCount", int32_t(lightCount));
+                mi->setParameter("candidates", int32_t(options.initialCandidates));
+                mi->setParameter("temporal", int32_t(options.temporal ? 1 : 0));
+                mi->setParameter("historyValid", int32_t(data.history ? 1 : 0));
+                mi->setParameter("frame", int32_t(state.frame));
+                mi->setParameter("maxHistory", float(options.maxHistory));
+                commitAndRenderFullScreenQuad(driver, out, mi);
+                unbindAllDescriptorSets(driver);
+            });
+
+    FrameGraphId<FrameGraphTexture> reservoirs = candidates->output;
+    if (options.spatialSamples > 0) {
+        struct SpatialData {
+            FrameGraphId<FrameGraphTexture> depth;
+            FrameGraphId<FrameGraphTexture> input;
+            FrameGraphId<FrameGraphTexture> output;
+        };
+        auto const& spatial = fg.addPass<SpatialData>("ReSTIR spatial reuse",
+                [&](FrameGraph::Builder& builder, auto& data) {
+                    auto const& desc = fg.getDescriptor(depth);
+                    data.depth = builder.sample(depth);
+                    data.input = builder.sample(reservoirs);
+                    data.output = builder.createTexture("ReSTIR reservoirs (spatial)", {
+                            .width = desc.width, .height = desc.height,
+                            .format = TextureFormat::RGBA32F });
+                    data.output = builder.declareRenderPass(data.output);
+                },
+                [=, this, &state](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                    mRayQueryDescriptorSet.bind(driver);
+                    bindPerRenderableDescriptorSet(driver);
+                    auto const& desc = resources.getDescriptor(data.depth);
+                    auto const& out = resources.getRenderPassInfo();
+                    auto const& material = getPostProcessMaterial("restirSpatial");
+                    FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                    mi->setParameter("depth", resources.getTexture(data.depth), SamplerParams{});
+                    mi->setParameter("lights", lightTexture, SamplerParams{});
+                    mi->setParameter("reservoirs", resources.getTexture(data.input), SamplerParams{});
+                    mi->setParameter("worldFromClip", math::mat4f(worldFromClip));
+                    mi->setParameter("resolution", math::float4{ float(desc.width), float(desc.height),
+                            1.0f / float(desc.width), 1.0f / float(desc.height) });
+                    mi->setParameter("cameraPosition", cameraInfo.getPosition());
+                    mi->setParameter("samples", int32_t(options.spatialSamples));
+                    mi->setParameter("frame", int32_t(state.frame));
+                    mi->setParameter("radius", options.spatialRadiusPx);
+                    commitAndRenderFullScreenQuad(driver, out, mi);
+                    unbindAllDescriptorSets(driver);
+                });
+        reservoirs = spatial->output;
+    }
+
+    struct ShadeData {
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> input;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+    auto const& shade = fg.addPass<ShadeData>("ReSTIR visibility",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                auto const& desc = fg.getDescriptor(depth);
+                data.depth = builder.sample(depth);
+                data.input = builder.sample(reservoirs);
+                data.output = builder.createTexture("ReSTIR shading", {
+                        .width = desc.width, .height = desc.height,
+                        .format = TextureFormat::RGBA32F });
+                data.output = builder.declareRenderPass(data.output);
+            },
+            [=, this, &state](FrameGraphResources const& resources, auto const& data, DriverApi& driver) {
+                mRayQueryDescriptorSet.bind(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& desc = resources.getDescriptor(data.depth);
+                auto const& out = resources.getRenderPassInfo();
+                auto const& material = getPostProcessMaterial("restirShade");
+                FMaterialInstance* const mi = getMaterialInstance(mEngine, driver, material);
+                mi->setParameter("depth", resources.getTexture(data.depth), SamplerParams{});
+                mi->setParameter("lights", lightTexture, SamplerParams{});
+                mi->setParameter("reservoirs", resources.getTexture(data.input), SamplerParams{});
+                mi->setParameter("worldFromClip", math::mat4f(worldFromClip));
+                mi->setParameter("resolution", math::float4{ float(desc.width), float(desc.height),
+                        1.0f / float(desc.width), 1.0f / float(desc.height) });
+                mi->setParameter("cameraPosition", cameraInfo.getPosition());
+                mi->setParameter("trueWorldOffset", trueWorldOffset);
+                mi->setParameter("visibilityRays", int32_t(options.visibilityRays ? 1 : 0));
+                mi->setParameter("bias", std::max(0.002f, cameraInfo.zn * 0.5f));
+                commitAndRenderFullScreenQuad(driver, out, mi);
+                unbindAllDescriptorSets(driver);
+                if (timeThisFrame) {
+                    driver.endTimerQuery(state.timer);
+                    state.timerPending = true;
+                }
+            });
+
+    // the reservoirs after reuse become next frame's history
+    struct ExportData {
+        FrameGraphId<FrameGraphTexture> reservoirs;
+    };
+    fg.addPass<ExportData>("Export ReSTIR history",
+            [&](FrameGraph::Builder& builder, auto& data) {
+                builder.sideEffect();
+                data.reservoirs = builder.sample(reservoirs);
+            }, [&current](FrameGraphResources const& resources, auto const& data) {
+                resources.detach(data.reservoirs, &current.reservoir, &current.desc);
+            });
+
+    return shade->output;
+}
