diff --git a/filament/src/materials/rt/restirCandidates.mat b/filament/src/materials/rt/restirCandidates.mat
new file mode 100644
index 00000000..8eaa8663
--- /dev/null
+++ b/filament/src/materials/rt/restirCandidates.mat
@@ -0,0 +1,192 @@
+material {
+    name : restirCandidates,
+    parameters : [
+        {
+            type : sampler2d,
+            name : depth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : lights,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : history,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : mat4,
+            name : worldFromClip,
+            precision: high
+        },
+        {
+            type : mat4,
+            name : prevClipFromWorld,
+            precision: high
+        },
+        {
+            type : float4,
+            name : resolution,
+            precision: high
+        },
+        {
+            type : float3,
+            name : cameraPosition,
+            precision: high
+        },
+        {
+            type : int,
+            name : lightCount
+        },
+        {
+            type : int,
+            name : candidates
+        },
+        {
+            type : int,
+            name : temporal
+        },
+        {
+            type : int,
+            name : historyValid
+        },
+        {
+            type : int,
+            name : frame
+        },
+        {
+            type : float,
+            name : maxHistory
+        }
+    ],
+    outputs : [
+        {
+            name : reservoir,
+            target : color,
+            type : float4
+        }
+    ],
+    domain : postprocess,
+    rayQuery : true,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+    // ReSTIR direct lighting, first pass: resampled importance sampling of the scene's
+    // punctual lights for every pixel of the structure depth, then temporal reuse of the
+    // previous frame's reservoir at the reprojected position. A reservoir texel holds
+    // (light index or -1, W, M, distance to the camera).
+
+    uint hashUint(uint x) {
+        x ^= x >> 16u;
+        x *= 0x7feb352du;
+        x ^= x >> 15u;
+        x *= 0x846ca68bu;
+        x ^= x >> 16u;
+        return x;
+    }
+
+    float nextRandom(inout uint seed) {
+        seed = hashUint(seed);
+        return float(seed & 0x00FFFFFFu) / 16777216.0;
+    }
+
+    highp vec3 worldPositionAt(ivec2 icoord, highp float depth) {
+        highp vec2 uv = (vec2(icoord) + 0.5) * materialParams.resolution.zw;
+        // window y grows downwards, NDC y upwards
+        highp vec4 clip = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
+        highp vec4 world = materialParams.worldFromClip * clip;
+        return world.xyz / world.w;
+    }
+
+    // the unshadowed luminance the light would add to a diffuse surface at P with normal N,
+    // scaled by the light's sampling weight: the resampling target function
+    float targetPdf(int lightIndex, highp vec3 P, vec3 N) {
+        highp vec4 t0 = texelFetch(materialParams_lights, ivec2(0, lightIndex), 0);
+        highp vec4 t1 = texelFetch(materialParams_lights, ivec2(1, lightIndex), 0);
+        highp vec4 t2 = texelFetch(materialParams_lights, ivec2(2, lightIndex), 0);
+        highp vec4 t3 = texelFetch(materialParams_lights, ivec2(3, lightIndex), 0);
+        highp vec3 posToLight = t0.xyz - P;
+        highp float d2 = dot(posToLight, posToLight);
+        float factor = d2 * t0.w;
+        float smoothFactor = saturate(1.0 - factor * factor);
+        float attenuation = smoothFactor * smoothFactor / max(d2, 1e-4);
+        vec3 l = posToLight * inversesqrt(max(d2, 1e-8));
+        if (t1.w > 0.5) {
+            float cd = dot(-t1.xyz, l);
+            float angle = saturate(cd * t3.x + t3.y);
+            attenuation *= angle * angle;
+        }
+        float NoL = saturate(dot(N, l));
+        float luminance = dot(t2.rgb, vec3(0.2126, 0.7152, 0.0722)) * t2.w;
+        return luminance * attenuation * NoL * t3.z;
+    }
+
+    void postProcess(inout PostProcessInputs postProcess) {
+        ivec2 icoord = ivec2(gl_FragCoord.xy);
+        highp float depth = texelFetch(materialParams_depth, icoord, 0).r;
+        int lightCount = materialParams.lightCount;
+        if (depth <= 0.0 || lightCount <= 0) {
+            postProcess.reservoir = vec4(-1.0, 0.0, 0.0, 0.0);
+            return;
+        }
+        highp vec3 P = worldPositionAt(icoord, depth);
+        highp vec3 N = normalize(cross(dFdx(P), dFdy(P)));
+        highp vec3 toCamera = materialParams.cameraPosition - P;
+        if (dot(N, toCamera) < 0.0) N = -N;
+        highp float viewDistance = length(toCamera);
+
+        uint seed = hashUint(uint(icoord.x) * 1973u + uint(icoord.y) * 9277u + uint(materialParams.frame) * 26699u + 1u);
+
+        // initial candidates: uniform light selection, weighted by the target function
+        int selected = -1;
+        float selectedPdf = 0.0;
+        float weightSum = 0.0;
+        float M = 0.0;
+        int candidates = max(materialParams.candidates, 1);
+        for (int i = 0; i < candidates; i++) {
+            int j = min(int(nextRandom(seed) * float(lightCount)), lightCount - 1);
+            float pdf = targetPdf(j, P, N);
+            float w = pdf * float(lightCount);
+            weightSum += w;
+            M += 1.0;
+            if (w > 0.0 && nextRandom(seed) * weightSum < w) {
+                selected = j;
+                selectedPdf = pdf;
+            }
+        }
+
+        // temporal reuse: the previous frame's reservoir where this surface was
+        if (materialParams.temporal != 0 && materialParams.historyValid != 0) {
+            highp vec4 prevClip = materialParams.prevClipFromWorld * vec4(P, 1.0);
+            if (prevClip.w > 0.0) {
+                highp vec2 prevNdc = prevClip.xy / prevClip.w;
+                highp vec2 prevUv = vec2(prevNdc.x * 0.5 + 0.5, 0.5 - prevNdc.y * 0.5);
+                if (all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0)))) {
+                    ivec2 prevCoord = ivec2(prevUv * materialParams.resolution.xy);
+                    highp vec4 h = texelFetch(materialParams_history, prevCoord, 0);
+                    if (h.x >= 0.0 && h.z > 0.0 && abs(h.w - viewDistance) <= 0.1 * viewDistance) {
+                        float Mh = min(h.z, materialParams.maxHistory * max(M, 1.0));
+                        float pdf = targetPdf(int(h.x + 0.5), P, N);
+                        float w = pdf * h.y * Mh;
+                        weightSum += w;
+                        M += Mh;
+                        if (w > 0.0 && nextRandom(seed) * weightSum < w) {
+                            selected = int(h.x + 0.5);
+                            selectedPdf = pdf;
+                        }
+                    }
+                }
+            }
+        }
+
+        float W = (selected >= 0 && selectedPdf > 0.0) ? weightSum / (M * selectedPdf) : 0.0;
+        postProcess.reservoir = vec4(float(selected), W, M, viewDistance);
+    }
+}
diff --git a/filament/src/materials/rt/restirShade.mat b/filament/src/materials/rt/restirShade.mat
new file mode 100644
index 00000000..56c91e3e
--- /dev/null
+++ b/filament/src/materials/rt/restirShade.mat
@@ -0,0 +1,108 @@
+material {
+    name : restirShade,
+    parameters : [
+        {
+            type : sampler2d,
+            name : depth,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : lights,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : sampler2d,
+            name : reservoirs,
+            precision: high,
+            filterable: false
+        },
+        {
+            type : mat4,
+            name : worldFromClip,
+            precision: high
+        },
+        {
+            type : float4,
+            name : resolution,
+            precision: high
+        },
+        {
+            type : float3,
+            name : cameraPosition,
+            precision: high
+        },
+        {
+            type : float3,
+            name : trueWorldOffset,
+            precision: high
+        },
+        {
+            type : int,
+            name : visibilityRays
+        },
+        {
+            type : float,
+            name : bias
+        }
+    ],
+    outputs : [
+        {
+            name : shading,
+            target : color,
+            type : float4
+        }
+    ],
+    domain : postprocess,
+    rayQuery : true,
+    depthWrite : false,
+    depthCulling : false
+}
+
+fragment {
+    // ReSTIR direct lighting, last pass: one visibility ray from the surface to the chosen
+    // light. The colour pass reads (light index or -1, W, visibility, 1) and shades that one
+    // light with the material's full BRDF.
+    highp vec3 worldPositionAt(ivec2 icoord, highp float depth) {
+        highp vec2 uv = (vec2(icoord) + 0.5) * materialParams.resolution.zw;
+        // window y grows downwards, NDC y upwards
+        highp vec4 clip = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
+        highp vec4 world = materialParams.worldFromClip * clip;
+        return world.xyz / world.w;
+    }
+
+    void postProcess(inout PostProcessInputs postProcess) {
+        ivec2 icoord = ivec2(gl_FragCoord.xy);
+        highp vec4 r = texelFetch(materialParams_reservoirs, icoord, 0);
+        if (r.x < 0.0 || r.y <= 0.0) {
+            postProcess.shading = vec4(-1.0, 0.0, 0.0, 1.0);
+            return;
+        }
+        float visibility = 1.0;
+        if (materialParams.visibilityRays != 0) {
+            highp float depth = texelFetch(materialParams_depth, icoord, 0).r;
+            highp vec3 P = worldPositionAt(icoord, depth);
+            highp vec3 N = normalize(cross(dFdx(P), dFdy(P)));
+            if (dot(N, materialParams.cameraPosition - P) < 0.0) N = -N;
+            highp vec4 t0 = texelFetch(materialParams_lights, ivec2(0, int(r.x + 0.5)), 0);
+            // the acceleration structures live in the true world, the camera in the shifted one
+            highp vec3 origin = P + materialParams.trueWorldOffset + N * materialParams.bias;
+            highp vec3 target = t0.xyz + materialParams.trueWorldOffset;
+            highp vec3 toLight = target - origin;
+            highp float distance = length(toLight);
+            if (distance > materialParams.bias) {
+                rayQueryEXT rq;
+                rayQueryInitializeEXT(rq, sceneTlas,
+                        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu,
+                        origin, 0.0, toLight / distance, distance - materialParams.bias);
+                rayQueryProceedEXT(rq);
+                if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
+                    visibility = 0.0;
+                }
+            }
+        }
+        postProcess.shading = vec4(r.x, r.y, visibility, 1.0);
+    }
+}
