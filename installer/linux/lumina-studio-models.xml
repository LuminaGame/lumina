<?xml version="1.0" encoding="UTF-8"?>
<!--
  The 3D model types and the Lumina asset type (.lmas) Lumina Studio opens
  and draws thumbnails for, installed
  to /usr/share/mime/packages/ by the lumina-studio package. Where the system
  database already defines a type (newer shared-mime-info has the glTF ones),
  these definitions merge into it.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="model/gltf-binary">
    <comment>glTF binary 3D model</comment>
    <glob pattern="*.glb"/>
    <magic priority="60">
      <match type="string" value="glTF" offset="0"/>
    </magic>
  </mime-type>
  <mime-type type="model/gltf+json">
    <comment>glTF 3D model</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.gltf"/>
  </mime-type>
  <mime-type type="model/x-fbx">
    <comment>FBX 3D model</comment>
    <glob pattern="*.fbx"/>
    <magic priority="60">
      <match type="string" value="Kaydara FBX Binary" offset="0"/>
    </magic>
  </mime-type>
  <mime-type type="model/obj">
    <comment>Wavefront OBJ 3D model</comment>
    <sub-class-of type="text/plain"/>
    <!-- Above the default weight (50) of the old TGIF drawing glob. -->
    <glob pattern="*.obj" weight="60"/>
  </mime-type>
  <mime-type type="application/x-lumina-asset">
    <comment>Lumina asset</comment>
    <glob pattern="*.lmas"/>
    <magic priority="60">
      <match type="string" value="LMAS" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
