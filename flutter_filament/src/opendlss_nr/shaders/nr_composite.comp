#version 460
// OpenDLSS-NR composition on the external post pass: the network's residual on the display proxy, the temporal
// blend with the reprojected history, the next history, the optional style preset, and the luminance-preserving
// tone upgrade back onto the HDR frame (the hook's OUTPUT replaces the frame before bloom and colour grading).
// Derived from OpenDLSS-NR 9d08f41 demo/shaders/nr_composite.comp (MIT, Copyright (c) 2026 maan; see
// third_party/opendlss_nr/LICENSE). Lumina's changes: HDR output instead of the demo's ACES display transform,
// the hook's images, no custom style knobs, and a non-finite result falls back to the frame.
#extension GL_GOOGLE_include_directive : require
#include "nr_frame_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sceneColor;
layout(set = 0, binding = 1) uniform sampler2D historyPrev;
layout(set = 0, binding = 2) uniform sampler2D motionTex;
layout(std430, set = 0, binding = 3) readonly buffer Head { float head[]; };   // f32 [fullHeight][fullWidth][4]
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outputImage;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D historyNext;

vec3 row3(vec3 a, vec3 b, vec3 c, vec3 value) { return vec3(dot(a, value), dot(b, value), dot(c, value)); }
float luminance(vec3 color) { return dot(color, vec3(0.212639, 0.715169, 0.072192)); }

vec3 toOklab(vec3 color) {
  vec3 lms = row3(vec3(0.4122214708, 0.5363325363, 0.0514459929), vec3(0.2119034982, 0.6806995451, 0.1073969566),
                  vec3(0.0883024619, 0.2817188376, 0.6299787005), color);
  lms = sign(lms) * pow(abs(lms), vec3(1.0 / 3.0));
  return row3(vec3(0.2104542553, 0.7936177850, -0.0040720468), vec3(1.9779984951, -2.4285922050, 0.4505937099),
              vec3(0.0259040371, 0.7827717662, -0.8086757660), lms);
}

vec3 fromOklab(vec3 lab) {
  vec3 lms = row3(vec3(1.0, 0.3963377774, 0.2158037573), vec3(1.0, -0.1055613458, -0.0638541728),
                  vec3(1.0, -0.0894841775, -1.2914855480), lab);
  lms *= lms * lms;
  return row3(vec3(4.0767416621, -3.3077115913, 0.2309699292), vec3(-1.2684380046, 2.6097574011, -0.3413193965),
              vec3(-0.0041960863, -0.7034186147, 1.7076147010), lms);
}

vec3 clampAp1(vec3 color) {
  vec3 ap1 = max(row3(vec3(0.613097, 0.339523, 0.047379), vec3(0.070194, 0.916354, 0.013452),
                      vec3(0.020616, 0.109570, 0.869815), color), vec3(0.0));
  return row3(vec3(1.705051, -0.621792, -0.083259), vec3(-0.130256, 1.140805, -0.010548),
              vec3(-0.024003, -0.128969, 1.152972), ap1);
}

vec3 hueOklab(vec3 incorrect, vec3 correct) {
  vec3 result = toOklab(incorrect);
  vec3 correctLab = toOklab(correct);
  float incorrectChroma = length(result.yz);
  float correctChroma = length(correctLab.yz);
  float scale = correctChroma == 0.0 ? 1.0 : incorrectChroma / correctChroma;
  result = vec3(result.x, correctLab.y * scale, correctLab.z * scale);
  return clampAp1(fromOklab(result));
}

vec3 upgradeToneMap(vec3 original, vec3 proxy, vec3 neural) {
  float originalY = luminance(original);
  float proxyY = luminance(proxy);
  float neuralY = luminance(neural);
  if (neuralY <= 0.00001) return original;
  float ratio = originalY < proxyY ? originalY / max(proxyY, 0.000001) : (neuralY + max(0.0, originalY - proxyY)) / neuralY;
  vec3 scaled = hueOklab(neural * ratio, neural);
  return original + (scaled - original);
}

vec3 nrHsl(vec3 rgb) {
  float high = max(max(rgb.r, rgb.g), rgb.b);
  float low = min(min(rgb.r, rgb.g), rgb.b);
  float sum = high + low;
  float light = sum * 0.5;
  float hue = 0.0, saturation = 0.0;
  if (high > low) {
    float delta = high - low;
    saturation = light > 0.5 ? delta / ((2.0 - high) - low) : delta / sum;
    if (high == rgb.r) hue = fma(rgb.g - rgb.b, 1.0 / delta, rgb.g < rgb.b ? 6.0 : 0.0) / 6.0;
    else if (high == rgb.g) hue = fma(rgb.b - rgb.r, 1.0 / delta, 2.0) / 6.0;
    else hue = fma(rgb.r - rgb.g, 1.0 / delta, 4.0) / 6.0;
  }
  return vec3(hue, saturation, light);
}

float nrHue(float p, float q, float hue) {
  float h = hue;
  if (h < 0.0) h += 1.0;
  if (h > 1.0) h -= 1.0;
  if (h < uintBitsToFloat(0x3e2aaaabu)) return fma(h, (q - p) * 6.0, p);
  if (h < 0.5) return q;
  if (h < uintBitsToFloat(0x3f2aaaabu)) return fma((uintBitsToFloat(0x3f2aaaabu) - h) * (q - p), 6.0, p);
  return p;
}

vec3 nrRgb(vec3 hsl) {
  if (hsl.y <= 0.0) return vec3(hsl.z);
  float q = hsl.z < 0.5 ? hsl.z * (hsl.y + 1.0) : fma(-hsl.z, hsl.y, hsl.z + hsl.y);
  float p = (hsl.z + hsl.z) - q;
  return vec3(nrHue(p, q, hsl.x + uintBitsToFloat(0x3eaaaaabu)), nrHue(p, q, hsl.x), nrHue(p, q, hsl.x - uintBitsToFloat(0x3eaaaaabu)));
}

// The natural (1) / cinematic (2) presets: exposure, contrast and saturation offsets scaled by the local tone.
vec3 nrStyle(vec3 neural, float style, float tone) {
  float styleTone = clamp(tone, 0.0, 1.0);
  float exposure = style == 1.0 ? -0.1 * styleTone : 0.0;
  float contrast = style == 1.0 ? -0.25 * styleTone : 0.0;
  float saturation = style == 1.0 ? -0.1 * styleTone : -0.15 * styleTone;
  vec3 color;
  for (int c = 0; c < 3; c++) {
    float value = clamp(neural[c], 0.0, 1.0);
    float exposed = clamp(value * exp2(exposure), 0.0, 1.0);
    float square = exposed * exposed;
    float curveDelta = fma(square, 3.0 - (exposed + exposed), -exposed);
    float curved = clamp(fma(contrast, curveDelta, exposed), 0.0, 1.0);
    float firstGamma = exp2(log2(curved));
    color[c] = exp2(log2(max(0.0, firstGamma)));
  }
  vec3 hsl = nrHsl(color);
  vec3 adjusted = nrRgb(vec3(hsl.x, clamp(hsl.y * (saturation + 1.0), 0.0, 1.0), hsl.z));
  vec3 again = nrHsl(adjusted);
  return clamp(nrRgb(vec3(again.x, clamp(exp2(log2(again.y)), 0.0, 1.0), again.z)), vec3(0.0), vec3(1.0));
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= params.validWidth || id.y >= params.validHeight) return;
  vec4 raw = texelFetch(sceneColor, ivec2(id), 0);
  vec3 scene = vec3(finiteNonnegative(raw.r), finiteNonnegative(raw.g), finiteNonnegative(raw.b));
  float paper = max(params.paperWhite, 0.05);
  vec3 proxyCode = vec3(proxyComponent(scene.r, paper), proxyComponent(scene.g, paper), proxyComponent(scene.b, paper));
  if (params.nrEnabled == 0u) {
    // bypass: the frame unchanged, the history primed with its proxy so switching on does not flash
    imageStore(historyNext, ivec2(id), vec4(proxyCode, 1.0));
    imageStore(outputImage, ivec2(id), raw);
    return;
  }
  vec3 original = scene / paper;
  vec3 proxyLinear = vec3(srgbDecode(proxyCode.r), srgbDecode(proxyCode.g), srgbDecode(proxyCode.b));
  uint feature = (id.y * params.fullWidth + id.x) * 4u;
  vec3 h = vec3(head[feature], head[feature + 1u], head[feature + 2u]);
  vec3 neural = clamp(fma(h, vec3(0.03125), fma(proxyCode, vec3(0.125), vec3(-0.0625))) * 8.0 + 0.5, vec3(0.0), vec3(1.0));
  // without a history (a reset, or a pixel whose previous position was off screen) the blend weight is 0
  if (params.historyValid != 0u && hasHistory(motionTex, vec2(id))) {
    float scale = clamp(params.blendScale, 0.0, 1.0);
    float weight = clamp((1.0 / (1.0 + exp2(head[feature + 3u] * uintBitsToFloat(0xbfb8aa3bu)))) * scale, 0.0, 1.0);
    vec3 hist = historySample(historyPrev, motionTex, vec2(id), vec2(params.validWidth, params.validHeight));
    neural = fma(vec3(weight), hist - neural, neural);
  }
  vec3 history = vec3(truncateHalf(neural.r), truncateHalf(neural.g), truncateHalf(neural.b));
  if (any(isnan(history)) || any(isinf(history))) history = proxyCode;
  imageStore(historyNext, ivec2(id), vec4(history, 1.0));
  vec3 styled = history;
  bool stylized = params.styleId != 0u;
  if (stylized) styled = nrStyle(history, float(params.styleId), params.localTone);
  vec3 published;
  for (int c = 0; c < 3; c++) {
    if (!stylized && params.intensity == 1.0) published[c] = history[c];
    else published[c] = truncateHalf(clamp(fma(params.intensity, styled[c] - proxyCode[c], proxyCode[c]), 0.0, 1.0));
  }
  vec3 neuralLinear = vec3(srgbDecode(published.r), srgbDecode(published.g), srgbDecode(published.b));
  vec3 upgraded = upgradeToneMap(original, proxyLinear, neuralLinear);
  float originalY = luminance(original);
  float upgradedY = luminance(upgraded);
  float ratio = originalY == 0.0 ? 1.0 : clamp(upgradedY / originalY, 0.0, 4.0);
  vec3 luminanceOnly = original * ratio;
  vec3 result = (luminanceOnly + (upgraded - luminanceOnly) * params.colorStrength) * paper;
  if (any(isnan(result)) || any(isinf(result))) result = scene;
  imageStore(outputImage, ivec2(id), vec4(max(result, vec3(0.0)), raw.a));
}
