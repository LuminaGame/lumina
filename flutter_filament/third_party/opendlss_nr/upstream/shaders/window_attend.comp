#version 460
// Fused 8x8 window cosine attention (exact Ada FP8 MMA, tiled 4x4 token order for the
// learned prior and the value MMA, the network's softmax reduction order).
//
// One workgroup = one (window, head). Four subgroups.
//   S = Q K^T + prior          16 MMAs (16x16x32, C = learned prior tile)
//   w = expWeight(S)          per element, FP16 bit approximation
//   p = fp8(w * f16(1/sum))    the specified softmax order, E4M3 weights
//   O = p V                    16 MMAs (16x16x32, two k32 steps over 64 keys)
// Keys are kept in physical (tiled) order p = tile*16 + within so the
// prior, the softmax tree and the value K dimension all index the same way.
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 128) in;

layout(push_constant) uniform Push {
  uint width;
  uint height;
  uint channels;   // heads * 32
  uint heads;
  uint shiftX;     // window origin offset (0 or 4)
  uint shiftY;
  uint windowsX;   // ceil((width + shiftX) / 8)
  uint windowCount;
} pc;

layout(std430, binding = 0) readonly buffer Normalized { uint8_t qkv[]; };  // E4M3 [tokens][channels*3]
layout(std430, binding = 1) readonly buffer Prior { float16_t prior[]; };   // [heads][64 query][64 physical key]
layout(std430, binding = 5) writeonly buffer Attended { uint8_t attended[]; }; // E4M3 [tokens][channels]

shared uint8_t qs[64 * 32];      // [query][component]
shared uint8_t ks[64 * 32];      // [physical key][component]
shared uint8_t vs[64 * 32];      // [physical key][component]
shared float16_t priors[64 * 64];
shared float16_t scores[64 * 64]; // [query][physical key]
shared uint8_t weights[64 * 64];  // E4M3 [query][physical key]
shared float16_t outputs[64 * 32];

uint inverseTiledToken(uint token) {
  uint tile = token >> 4u, within = token & 15u;
  uint x = (tile & 1u) * 4u + (within & 3u);
  uint y = (tile >> 1u) * 4u + (within >> 2u);
  return y * 8u + x;
}

// the exponential approximation: packed FP16 affine + exponent-field remap (the network's exponential approximation).
float16_t expWeight(float16_t score) {
  precise float affine32 = fma(float(score), 0.044921875, 1.30078125);
  float16_t affine = clamp(float16_t(affine32), float16_t(1.03125), float16_t(1.5693359375));
  uint bits = f16Bits(affine);
  uint exponentialBits = ((bits << 5u) + 0x8000u) & 0xffffu;
  return f16FromBits(exponentialBits);
}

// the specified softmax reduction (keys in physical order): eight 8-key fragments reduced
// per lane pair, then the four column pairs, then even/odd halves.
float16_t softmaxPair(uint row, uint pair, uint parity) {
  uint key = pair * 2u + parity;
  precise float16_t blocks01 = scores[row * 64u + key] + scores[row * 64u + key + 8u];
  precise float16_t blocks23 = scores[row * 64u + key + 16u] + scores[row * 64u + key + 24u];
  precise float16_t blocks45 = scores[row * 64u + key + 32u] + scores[row * 64u + key + 40u];
  precise float16_t blocks67 = scores[row * 64u + key + 48u] + scores[row * 64u + key + 56u];
  precise float16_t a = blocks01 + blocks23;
  precise float16_t b = a + blocks45;
  return b + blocks67;
}

float16_t softmaxSum(uint row) {
  precise float16_t e0 = softmaxPair(row, 0u, 0u) + softmaxPair(row, 1u, 0u);
  precise float16_t e1 = e0 + softmaxPair(row, 2u, 0u);
  precise float16_t even = e1 + softmaxPair(row, 3u, 0u);
  precise float16_t o0 = softmaxPair(row, 0u, 1u) + softmaxPair(row, 1u, 1u);
  precise float16_t o1 = o0 + softmaxPair(row, 2u, 1u);
  precise float16_t odd = o1 + softmaxPair(row, 3u, 1u);
  return even + odd;
}

void main() {
  const uint thread = gl_LocalInvocationID.x;
  const uint subgroup = gl_SubgroupID;
  const uint head = gl_WorkGroupID.x;
  const uint window = gl_WorkGroupID.y + gl_WorkGroupID.z * 65535u;
  if (window >= pc.windowCount) return;
  const int windowX = int((window % pc.windowsX) * 8u) - int(pc.shiftX);
  const int windowY = int((window / pc.windowsX) * 8u) - int(pc.shiftY);
  const uint stride3 = pc.channels * 3u;
  const uint headBase = head * 96u;

  // Stage Q (query order), K/V (physical key order) and the prior.
  for (uint i = thread; i < 64u * 32u; i += 128u) {
    uint token = i >> 5u, component = i & 31u;
    int qx = windowX + int(token & 7u), qy = windowY + int(token >> 3u);
    uint8_t q = uint8_t(0);
    if (qx >= 0 && qy >= 0 && qx < int(pc.width) && qy < int(pc.height)) {
      q = qkv[(uint(qy) * pc.width + uint(qx)) * stride3 + headBase + component];
    }
    qs[i] = q;
    uint keyLocal = inverseTiledToken(token);
    int kx = windowX + int(keyLocal & 7u), ky = windowY + int(keyLocal >> 3u);
    uint8_t k = uint8_t(0), v = uint8_t(0);
    if (kx >= 0 && ky >= 0 && kx < int(pc.width) && ky < int(pc.height)) {
      uint keyBase = (uint(ky) * pc.width + uint(kx)) * stride3 + headBase;
      k = qkv[keyBase + 32u + component];
      v = qkv[keyBase + 64u + component];
    }
    ks[i] = k;
    vs[i] = v;
  }
  for (uint i = thread; i < 64u * 64u; i += 128u) priors[i] = prior[head * 4096u + i];
  barrier();

  // S = Q K^T with the learned prior as the incoming FP16 accumulator.
  for (uint tile = subgroup; tile < 16u; tile += 4u) {
    uint qTile = tile >> 2u, kTile = tile & 3u;
    coopmat<floate4m3_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseA> ma;
    coopMatLoad(ma, qs, qTile * 16u * 32u, 32u, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<floate4m3_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB> mb;
    coopMatLoad(mb, ks, kTile * 16u * 32u, 32u, gl_CooperativeMatrixLayoutColumnMajor);
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mc;
    coopMatLoad(mc, priors, qTile * 16u * 64u + kTile * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);
    mc = coopMatMulAdd(ma, mb, mc);
    coopMatStore(mc, scores, qTile * 16u * 64u + kTile * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);
  }
  barrier();

  // Exponential weights, then the specified reduction, reciprocal and E4M3 publication.
  for (uint i = thread; i < 64u * 64u; i += 128u) scores[i] = expWeight(scores[i]);
  barrier();
  if (thread < 64u) {
    uint row = thread;
    float16_t total = softmaxSum(row);
    float16_t reciprocal = float16_t(1.0 / float(total));
    for (uint key = 0u; key < 64u; ++key) {
      precise float16_t normalized = scores[row * 64u + key] * reciprocal;
      weights[row * 64u + key] = uint8_t(e4m3CodeFromF16Bits(f16Bits(normalized)));
    }
  }
  barrier();

  // O = P V over the 64 physical keys as two k32 steps (four F13 groups in
  // tile order 0,1,2,3), FP16 accumulation from zero.
  for (uint tile = subgroup; tile < 8u; tile += 4u) {
    uint qTile = tile >> 1u, cTile = tile & 1u;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mc =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    for (uint kb = 0u; kb < 64u; kb += 32u) {
      coopmat<floate4m3_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseA> ma;
      coopMatLoad(ma, weights, qTile * 16u * 64u + kb, 64u, gl_CooperativeMatrixLayoutRowMajor);
      coopmat<floate4m3_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB> mb;
      coopMatLoad(mb, vs, kb * 32u + cTile * 16u, 32u, gl_CooperativeMatrixLayoutRowMajor);
      mc = coopMatMulAdd(ma, mb, mc);
    }
    coopMatStore(mc, outputs, qTile * 16u * 32u + cTile * 16u, 32u, gl_CooperativeMatrixLayoutRowMajor);
  }
  barrier();

  for (uint i = thread; i < 64u * 32u; i += 128u) {
    uint token = i >> 5u, component = i & 31u;
    int qx = windowX + int(token & 7u), qy = windowY + int(token >> 3u);
    if (qx < 0 || qy < 0 || qx >= int(pc.width) || qy >= int(pc.height)) continue;
    uint index = (uint(qy) * pc.width + uint(qx)) * pc.channels + head * 32u + component;
    attended[index] = uint8_t(e4m3CodeFromF16Bits(f16Bits(outputs[i])));
  }
}
