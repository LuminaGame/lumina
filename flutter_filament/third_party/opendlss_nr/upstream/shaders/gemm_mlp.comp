#version 460
// Fused two-layer FP8 MLP: D = E4( E4(SiLU(A * W1)) * W2 ), the expert FFN paths
// (C -> 128 -> 32 per expert) and the split-512 branches (64 -> 256 -> 64).
//
// v2 (fragment level, VK_NV_cooperative_matrix2): the hidden activation is a 16x128
// accumulator fragment per subgroup (one flexible multiply per k32 step), SiLU is a
// per-element operation and the E4M3 publication a Use conversion in registers; W2 is
// applied as one multiply per 128-wide hidden chunk from a staged [NOUT][128] tile. The
// K order (W1 steps, then hidden chunks in order) is the same accumulation chain as the
// separate GEMMs. Shared memory: the double-buffered W1 operands only (12 KB).
//
// Weights: W1 k32-tile-major per batch [batch][K/32][HIDDEN][32]; W2 N-major per batch
// [batch][NOUT][HIDDEN] (K contiguous).
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_NV_cooperative_matrix2 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require
#define DLSS_E4M3_HW 1
#include "common.glsl"
#include "publish.glsl"

layout(local_size_x = 128) in;   // four subgroups, 16 rows each

layout(constant_id = 0) const uint K = 64;         // input channels per batch
layout(constant_id = 1) const uint HIDDEN = 128;   // W1 output columns per batch (multiple of 128)
layout(constant_id = 2) const uint NOUT = 32;      // W2 output columns per batch (32 or 64)
layout(constant_id = 3) const uint FLAGS = 0;
layout(constant_id = 5) const uint DEPTH = 2;      // global -> register prefetch depth in k32 steps
const uint F_BROADCAST_INPUT = 1u;   // every batch reads the same input columns

layout(push_constant) uniform Push {
  uint rows;
  uint inputStride;        // input row length in elements
  uint inputColumnBase;
  uint outputStride;
  uint outputColumnOffset;
  uint batches;
} pc;

layout(std430, binding = 0) readonly buffer InputA { uvec4 a4[]; };
layout(std430, binding = 1) readonly buffer WeightsOne { uvec4 w1v[]; };
layout(std430, binding = 2) readonly buffer WeightsTwo { uvec4 w2v[]; };
layout(std430, binding = 5) writeonly buffer OutputE4 { uvec4 out8x16[]; };

const uint A_WORDS = 64u * 3u;          // A tile [64][32] as 2 words per row + 1 pad
const uint B1_WORDS = 128u * 3u;        // W1 tile [128 n][32 k] + pad
const uint BUF_WORDS = A_WORDS + B1_WORDS;
const uint BUFFERS = 2u;   // double-buffered operands
shared uvec4 stage[BUFFERS * BUF_WORDS];     // double-buffered W1 operands; then the W2 chunk tile [NOUT][128 k] (9-word rows)
shared uint stage32[4u * 16u * 16u];          // output row tiles as 32-bit words: [subgroup][16 rows][NOUT/4 words]

#define ACC16x128 coopmat<float16_t, gl_ScopeSubgroup, 16, 128, gl_MatrixUseAccumulator>
#define ACCOUT coopmat<float16_t, gl_ScopeSubgroup, 16, NOUT, gl_MatrixUseAccumulator>
#define A16x32 coopmat<floate4m3_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseA>
#define A16x128 coopmat<floate4m3_t, gl_ScopeSubgroup, 16, 128, gl_MatrixUseA>
#define B32x128 coopmat<floate4m3_t, gl_ScopeSubgroup, 32, 128, gl_MatrixUseB>
#define B128xOUT coopmat<floate4m3_t, gl_ScopeSubgroup, 128, NOUT, gl_MatrixUseB>

float16_t siluElement(const in uint row, const in uint col, const in float16_t value) { return siluHalf(value); }

void main() {
  const uint thread = gl_LocalInvocationID.x;
  const uint subgroup = gl_SubgroupID;
  const uint batch = gl_WorkGroupID.x;
  const uint blockRow = (gl_WorkGroupID.y + gl_WorkGroupID.z * 65535u) * 64u;
  const uint rowBase = blockRow + subgroup * 16u;
  const bool rowsValid = rowBase < pc.rows;

  // Staging assignment: A row half (thread >> 1, thread & 1); W1 tile words thread and thread + 128.
  const uint aRow = thread >> 1u, aHalf = thread & 1u;
  const uint aColumnBase = pc.inputColumnBase + (((FLAGS & F_BROADCAST_INPUT) != 0u) ? 0u : batch * K);
  const uint aIndex = (min(blockRow + aRow, pc.rows - 1u) * pc.inputStride + aColumnBase) / 16u + aHalf;
  const uint kSteps = K / 32u;
  const uint w1Batch = batch * kSteps * HIDDEN * 2u;          // words
  const uint w2Batch = batch * NOUT * HIDDEN / 16u;           // words: [NOUT][HIDDEN] bytes

  ACCOUT acc2 = ACCOUT(0.0);
  for (uint chunk = 0u; chunk < HIDDEN / 128u; ++chunk) {
    // ---- W1 for this 128-wide hidden chunk: one flexible multiply per k32 step.
    ACC16x128 hidden = ACC16x128(0.0);
    const uint chunkWord = chunk * 128u * 2u;
    // Register prefetch DEPTH steps ahead: slot d holds step s with s % DEPTH == d.
    uvec4 ra[DEPTH], rb0[DEPTH], rb1[DEPTH];
    [[unroll]] for (uint d = 0u; d < DEPTH; ++d) {
      if (d < kSteps) {
        uint tile = w1Batch + d * HIDDEN * 2u + chunkWord;
        ra[d] = a4[aIndex + d * 2u];
        rb0[d] = w1v[tile + thread];
        rb1[d] = w1v[tile + 128u + thread];
      }
    }
    // W2 chunk tile words for this thread, issued before the K loop so the loads complete during it.
    uvec4 rw2[NOUT * 8u / 128u];
    [[unroll]] for (uint i = 0u; i < NOUT * 8u / 128u; ++i) {
      uint idx = thread + 128u * i;
      rw2[i] = w2v[w2Batch + ((idx >> 3u) * HIDDEN + chunk * 128u) / 16u + (idx & 7u)];
    }
    for (uint base = 0u; base < kSteps; base += DEPTH) {
      [[unroll]] for (uint d = 0u; d < DEPTH; ++d) {
        const uint s = base + d;
        if (s < kSteps) {
          const uint buf = (BUFFERS == 1u) ? 0u : (s & 1u) * BUF_WORDS;
          if (BUFFERS == 1u && s != 0u) barrier();   // previous step's fragment loads done
          stage[buf + aRow * 3u + aHalf] = ra[d];
          stage[buf + A_WORDS + (thread >> 1u) * 3u + (thread & 1u)] = rb0[d];              // n rows 0..63
          stage[buf + A_WORDS + (64u + (thread >> 1u)) * 3u + (thread & 1u)] = rb1[d];      // n rows 64..127
          if (s + DEPTH < kSteps) {
            uint tile = w1Batch + (s + DEPTH) * HIDDEN * 2u + chunkWord;
            ra[d] = a4[aIndex + (s + DEPTH) * 2u];
            rb0[d] = w1v[tile + thread];
            rb1[d] = w1v[tile + 128u + thread];
          }
          barrier();
          if (rowsValid) {
            A16x32 ma; coopMatLoad(ma, stage, buf + subgroup * 16u * 3u, 3u, gl_CooperativeMatrixLayoutRowMajor);
            B32x128 mb; coopMatLoad(mb, stage, buf + A_WORDS, 3u, gl_CooperativeMatrixLayoutColumnMajor);
            hidden = coopMatMulAdd(ma, mb, hidden);
          }
        }
      }
    }
    barrier();   // last step's operand reads done before the staging area is reused
    // ---- SiLU + E4 in registers; W2 chunk tile [NOUT n][128 k] staged (9-word rows), one multiply.
    coopMatPerElementNV(hidden, hidden, siluElement);
    A16x128 hiddenE4 = A16x128(hidden);
    [[unroll]] for (uint i = 0u; i < NOUT * 8u / 128u; ++i) {
      uint idx = thread + 128u * i;
      stage[(idx >> 3u) * 9u + (idx & 7u)] = rw2[i];
    }
    barrier();
    if (rowsValid) {
      B128xOUT w2; coopMatLoad(w2, stage, 0u, 9u, gl_CooperativeMatrixLayoutColumnMajor);
      acc2 = coopMatMulAdd(hiddenE4, w2, acc2);
    }
    barrier();   // W2 tile reads done before the next chunk stages W1 operands
  }

  // ---- Output: E4 of the W2 accumulators, NOUT columns per row at outputColumnOffset + batch * NOUT.
  if (!rowsValid) return;
  // Publication: lane (g, t) holds rows g, g+8 and columns 8j + 2t, +1 (j < NOUT/8) of the accumulator. Lanes t
  // and t^1 exchange one pair so that the even lane assembles the 32-bit word (columns 8j + 4(t>>1) .. +3) of row g
  // and the odd lane that of row g+8; the words form this subgroup's [16][NOUT] E4 row tile in shared memory,
  // from which each lane stores one 16-byte word per 32 columns (rows are allocated in whole 64-row groups).
  const uint lane = gl_SubgroupInvocationID;
  const uint g = lane >> 2u, t = lane & 3u;
  const uint rowWords = NOUT / 4u;                                    // 32-bit words per row
  const uint tileBase = subgroup * 16u * rowWords;
  PUBLISH_E4_TILE(acc2, NOUT, stage32, tileBase, g, t)
  subgroupBarrier();
  [[unroll]] for (uint i = 0u; i < NOUT / 32u; ++i) {
    uint w = lane + 32u * i;                          // 16-byte word: row w / (NOUT/16), column word w % (NOUT/16)
    uint r = w / (NOUT / 16u), cw = w % (NOUT / 16u);
    uint base = tileBase + r * rowWords + cw * 4u;
    out8x16[((rowBase + r) * pc.outputStride + pc.outputColumnOffset + batch * NOUT) / 16u + cw] =
        uvec4(stage32[base], stage32[base + 1u], stage32[base + 2u], stage32[base + 3u]);
  }
}
