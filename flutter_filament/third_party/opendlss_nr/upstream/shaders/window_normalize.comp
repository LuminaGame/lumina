#version 460
// Cosine-attention Q/K normalization for the fused Swin blocks
// (the network's normalization order).
// One thread per (token, head); the square sums use the specified half
// reduction order: fma(low, low, f16(high*high)) for the 16 pairs, then a
// stride 8/4/2/1 tree, every add published as FP16.
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform Push {
  uint tokens;
  uint heads;
  uint channels;        // heads * 32
  uint scaleWordOffset; // per-head f32 learned scale, in 32-bit words within binding 4
} pc;

layout(std430, binding = 1) readonly buffer Qkv { float16_t qkv[]; };   // [tokens][channels*3] raw half
layout(std430, binding = 4) readonly buffer Aux { uint aux32[]; };
layout(std430, binding = 5) writeonly buffer Normalized { uint8_t normalized[]; }; // E4M3 [tokens][channels*3]

float16_t treeSum16(float16_t r[16]) {
  // reduction[c] += reduction[c + stride] for stride 8, 4, 2, 1.
  precise float16_t s8[8];
  for (uint c = 0u; c < 8u; ++c) s8[c] = r[c] + r[c + 8u];
  precise float16_t s4[4];
  for (uint c = 0u; c < 4u; ++c) s4[c] = s8[c] + s8[c + 4u];
  precise float16_t s2[2];
  s2[0] = s4[0] + s4[2];
  s2[1] = s4[1] + s4[3];
  return s2[0] + s2[1];
}

void main() {
  uint id = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * 65535u * 256u;
  if (id >= pc.tokens * pc.heads) return;
  uint token = id / pc.heads;
  uint head = id % pc.heads;
  // Native fused-Swin QKV weights are head-major: q, k, v of one head are
  // three consecutive 32-channel groups.
  uint base = token * pc.channels * 3u + head * 96u;

  float16_t q[32];
  float16_t k[32];
  for (uint c = 0u; c < 32u; ++c) {
    q[c] = qkv[base + c];
    k[c] = qkv[base + 32u + c];
  }
  float16_t r[16];
  for (uint c = 0u; c < 16u; ++c) {
    precise float16_t highSquare = q[c + 16u] * q[c + 16u];
    r[c] = fma(q[c], q[c], highSquare);
  }
  float16_t qSum = treeSum16(r);
  for (uint c = 0u; c < 16u; ++c) {
    precise float16_t highSquare = k[c + 16u] * k[c + 16u];
    r[c] = fma(k[c], k[c], highSquare);
  }
  float16_t kSum = treeSum16(r);
  float16_t qNorm = float16_t(inversesqrt(float(qSum)));
  float16_t kNorm = float16_t(inversesqrt(float(kSum)));
  float16_t scale = float16_t(uintBitsToFloat(aux32[pc.scaleWordOffset + head]));
  for (uint c = 0u; c < 32u; ++c) {
    precise float16_t nq = q[c] * qNorm;
    precise float16_t nqs = nq * scale;
    precise float16_t nk = k[c] * kNorm;
    normalized[base + c] = uint8_t(e4m3CodeFromF16Bits(f16Bits(nqs)));
    normalized[base + 32u + c] = uint8_t(e4m3CodeFromF16Bits(f16Bits(nk)));
    normalized[base + 64u + c] = uint8_t(e4m3CodeFromF16Bits(f16Bits(qkv[base + 64u + c])));
  }
}
